<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Accounting module tests (platform design i.2). From Stage 3 session 1: the golden posting snapshot (design j, Stage 3 "Proven by"), which
    posts every document type through the REST API of the composed host and reads the entries back with SQL, so it depends on neither the
    C# location of the accounting types nor their names — only on the API and the tables, which Stage 3 does not change. From session 2:
    the posting contract suite. The accounting unit test classes join in session 16.
  -->
  <PropertyGroup>
    <RootNamespace>DirectService.Accounting.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="DirectService.SharedKernel" />
    <Using Include="DirectService.Shared.Contracts" />
    <Using Include="DirectService.Testing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DirectService.Transportation.Web\DirectService.Transportation.Web.csproj" />
    <ProjectReference Include="..\DirectService.Testing\DirectService.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The posting snapshot, taken once on the Stage 2 code (tag stage2-done-2026-10-30) and never regenerated (DT-379). -->
    <None Include="Golden\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
