@page "/reset-password"
@* SCR-04 password reset, new password from the email link (u, t); the tenant's password policy applies (FR-175); other sessions end. *@
@inherits AccountPage
@using DirectService.Transportation.Application.Abstractions
@using DirectService.Transportation.Application.Identity
@inject AccountService Accounts

<AuthCard Title="@L["acct.resetTitle"]">
    <ChildContent>
        @if (_done)
        {
            <Banner Tone="Tone.Ok" Text="@L["acct.resetDone"]" />
            <a class="btn pri w100" href="@Href("/sign-in")">@L["acct.signIn"]</a>
        }
        else if (_invalid)
        {
            <Banner Tone="Tone.Err" Text="@L["acct.linkInvalid"]" />
            <a class="btn pri w100" href="@Href("/forgot-password")">@L["acct.sendLink"]</a>
        }
        else
        {
            <EditForm Model="Input" FormName="reset" OnSubmit="Submit" class="stack" method="post">
                <ProblemValidator @ref="_problems" />
                <TextField @bind-Value="Input.NewPassword" Label="@L["acct.newPassword"]" Type="password" Required="true" Autocomplete="new-password" MaxLength="128" Help="@L["acct.passwordHelp"]" />
                <TextField @bind-Value="Input.ConfirmPassword" Label="@L["acct.confirmPassword"]" Type="password" Required="true" Autocomplete="new-password" MaxLength="128" />
                <Btn Type="submit" Primary="true" Text="@L["acct.resetSubmit"]" Class="w100" />
            </EditForm>
        }
    </ChildContent>
    <Foot>@if (!_done && !_invalid) {@L["acct.resetNote"]}</Foot>
</AuthCard>

@code {
    // Form models: bound from the posted form, or new on a GET.
    protected override void OnParametersSet() { Input ??= new(); }

    private ProblemValidator? _problems;
    private bool _done;
    private bool _invalid;

    [SupplyParameterFromQuery(Name = "u")] private string? UserToken { get; set; }
    [SupplyParameterFromQuery(Name = "t")] private string? LinkToken { get; set; }
    [SupplyParameterFromForm] private ResetInput Input { get; set; } = default!;

    protected override void OnInitialized() => _invalid = string.IsNullOrEmpty(UserToken) || string.IsNullOrEmpty(LinkToken);

    private async Task Submit()
    {
        var missing = AccountValidation.Required(L, ("newPassword", Input.NewPassword, "acct.newPassword"), ("confirmPassword", Input.ConfirmPassword, "acct.confirmPassword"));
        if (missing is null && Input.NewPassword != Input.ConfirmPassword)
            missing = new ApiProblem { Status = 400, Errors = [new ApiFieldError("confirmPassword", "validation.mismatch", L["acct.mismatch"])] };
        if (missing is not null)
        {
            _problems?.Show(missing);
            return;
        }
        try
        {
            await Accounts.ResetPasswordAsync(UserToken!, LinkToken!, Input.NewPassword!, Http.RequestAborted);
            _done = true;
        }
        catch (AppException e)
        {
            if (e.Code == DirectService.Transportation.Contracts.Errors.ErrorCodes.TokenInvalid) { _invalid = true; return; }
            _problems?.Show(Problem(e) with { Field = "newPassword" });
        }
    }

    private sealed class ResetInput
    {
        public string? NewPassword { get; set; }
        public string? ConfirmPassword { get; set; }
    }
}
