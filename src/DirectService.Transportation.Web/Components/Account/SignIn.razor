@page "/sign-in"
@* SCR-01 sign-in, password step (FR-175): email or username in one field (revision 6); wrong password and lockout messages come from the
   service; then the forced password change, the second step, or straight into the application. *@
@inherits AccountPage
@using DirectService.Transportation.Application.Abstractions
@using DirectService.Platform.Application.Identity
@using DirectService.Transportation.Web.Security
@inject AuthFlow Flow

<AuthCard Title="@L["acct.signIn"]" Lead="@L["acct.signInLead"]">
    <ChildContent>
        <EditForm Model="Input" FormName="sign-in" OnSubmit="Submit" class="stack" method="post">
            <ProblemValidator @ref="_problems" />
            @if (_banner is not null) {<Banner Tone="Tone.Err" Text="@_banner" />}
            <TextField @bind-Value="Input.Email" Label="@L["acct.login"]" Ltr="true" Autocomplete="username" Required="true" Icon="user" MaxLength="256" />
            <TextField @bind-Value="Input.Password" Label="@L["acct.password"]" Type="password" Autocomplete="current-password" Required="true" Icon="lock" MaxLength="128" />
            <div style="display:flex;justify-content:flex-end;font-size:13px"><a href="@Href("/forgot-password")">@L["acct.forgot"]</a></div>
            <Btn Type="submit" Primary="true" Text="@L["acct.signIn"]" Class="w100" />
        </EditForm>
    </ChildContent>
    <Foot>@L["acct.noAccount"] <a href="@Href("/sign-up")">@L["acct.createAccount"]</a></Foot>
</AuthCard>

@code {
    // Form models: bound from the posted form, or new on a GET.
    protected override void OnParametersSet() { Input ??= new() { Email = Kept("Input.Email") }; }

    private ProblemValidator? _problems;
    private string? _banner;

    [SupplyParameterFromForm] private SignInInput Input { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        if (HttpMethods.IsGet(Http.Request.Method) && Http.User.Identity?.IsAuthenticated == true) Go(LocalUrl(ReturnUrl));
    }

    private async Task Submit()
    {
        if (AccountValidation.Required(L, ("email", Input.Email, "acct.login"), ("password", Input.Password, "acct.password")) is { } missing)
        {
            _problems?.Show(missing);
            return;
        }
        SignInNextStep next;
        try
        {
            next = await Flow.PasswordAsync(Http, Input.Email!.Trim(), Input.Password!, Http.RequestAborted);
        }
        catch (AppException e)
        {
            _banner = _problems?.Show(Problem(e)) ?? Problem(e).Detail;
            Input.Password = null;
            return;
        }
        Go(next switch
        {
            SignInNextStep.None => LocalUrl(ReturnUrl),
            SignInNextStep.ChangePassword => Href("/change-password", LocalUrl(ReturnUrl)),
            SignInNextStep.TwoFactorSetup or SignInNextStep.TwoFactorOffer => Href("/two-factor/setup", LocalUrl(ReturnUrl)),
            _ => Href("/two-factor", LocalUrl(ReturnUrl)),
        });
    }

    private sealed class SignInInput
    {
        public string? Email { get; set; }
        public string? Password { get; set; }
    }
}
