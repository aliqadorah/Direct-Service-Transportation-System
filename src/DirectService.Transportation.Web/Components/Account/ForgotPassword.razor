@page "/forgot-password"
@* SCR-04 password reset, request: the reply is the same whether or not the address exists (no account enumeration). *@
@inherits AccountPage
@using DirectService.Transportation.Application.Abstractions
@using DirectService.Transportation.Application.Identity
@inject AccountService Accounts

<AuthCard Title="@L["acct.forgotTitle"]" Lead="@(_sent ? null : L["acct.forgotLead"])">
    @if (_sent)
    {
        <Banner Tone="Tone.Info" Text="@L["acct.linkSent"]" Live="true" />
        <a href="@Href("/sign-in")" style="font-size:13px">@L["acct.backToSignIn"]</a>
    }
    else
    {
        <EditForm Model="Input" FormName="forgot" OnSubmit="Submit" class="stack" method="post">
            <ProblemValidator @ref="_problems" />
            <TextField @bind-Value="Input.Email" Label="@L["acct.email"]" Type="email" Ltr="true" Required="true" Autocomplete="email" Icon="mail" MaxLength="256" />
            <Btn Type="submit" Primary="true" Text="@L["acct.sendLink"]" Class="w100" />
            <a href="@Href("/sign-in")" style="font-size:13px">@L["acct.backToSignIn"]</a>
        </EditForm>
    }
</AuthCard>

@code {
    // Form models: bound from the posted form, or new on a GET.
    protected override void OnParametersSet() { Input ??= new(); }

    private ProblemValidator? _problems;
    private bool _sent;

    [SupplyParameterFromForm] private EmailInput Input { get; set; } = default!;

    private async Task Submit()
    {
        if (AccountValidation.Required(L, ("email", Input.Email, "acct.email")) is { } missing)
        {
            _problems?.Show(missing);
            return;
        }
        try
        {
            await Accounts.RequestPasswordResetAsync(Input.Email!.Trim(), Http.RequestAborted);
            _sent = true;
        }
        catch (AppException e)
        {
            _problems?.Show(Problem(e) with { Field = "email" });
        }
    }

    private sealed class EmailInput
    {
        public string? Email { get; set; }
    }
}
