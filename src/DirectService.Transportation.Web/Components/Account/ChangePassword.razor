@page "/change-password"
@* Revision 6: the forced password change after the password step — a user created (or reset) by an administrator with "must change password
   at first login". The tenant's password policy applies and the new password must differ from the current one; then the second step, or in. *@
@inherits AccountPage
@using DirectService.Transportation.Application.Abstractions
@using DirectService.Transportation.Application.Identity
@using DirectService.Transportation.Web.Security
@inject AuthFlow Flow

<AuthCard Title="@L["acct.changeTitle"]" Lead="@L["acct.changeLead"]">
    <ChildContent>
        <EditForm Model="Input" FormName="change-password" OnSubmit="Submit" class="stack" method="post">
            <ProblemValidator @ref="_problems" />
            <TextField @bind-Value="Input.NewPassword" Label="@L["acct.newPassword"]" Type="password" Required="true" Autocomplete="new-password" MaxLength="128" Help="@L["acct.passwordHelp"]" />
            <TextField @bind-Value="Input.ConfirmPassword" Label="@L["acct.confirmPassword"]" Type="password" Required="true" Autocomplete="new-password" MaxLength="128" />
            <Btn Type="submit" Primary="true" Text="@L["acct.changeSubmit"]" Class="w100" />
        </EditForm>
    </ChildContent>
    <Foot><a href="@Href("/sign-in")">@L["acct.backToSignIn"]</a></Foot>
</AuthCard>

@code {
    // Form models: bound from the posted form, or new on a GET.
    protected override void OnParametersSet() { Input ??= new(); }

    private ProblemValidator? _problems;

    [SupplyParameterFromForm] private ChangeInput Input { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (await AuthFlow.StageAsync(Http) != AuthFlow.StagePassword) Go(Href("/sign-in", LocalUrl(ReturnUrl)));
    }

    private async Task Submit()
    {
        var missing = AccountValidation.Required(L, ("newPassword", Input.NewPassword, "acct.newPassword"), ("confirmPassword", Input.ConfirmPassword, "acct.confirmPassword"));
        if (missing is null && Input.NewPassword != Input.ConfirmPassword)
            missing = new ApiProblem { Status = 400, Errors = [new ApiFieldError("confirmPassword", "validation.mismatch", L["acct.mismatch"])] };
        if (missing is not null)
        {
            _problems?.Show(missing);
            return;
        }
        SignInNextStep next;
        try
        {
            next = await Flow.ChangePasswordAsync(Http, Input.NewPassword, Http.RequestAborted);
        }
        catch (AppException e)
        {
            if (e.Status == 401) { Go(Href("/sign-in", LocalUrl(ReturnUrl))); return; }
            _problems?.Show(Problem(e) with { Field = "newPassword" });
            return;
        }
        Go(next switch
        {
            SignInNextStep.None => LocalUrl(ReturnUrl),
            SignInNextStep.TwoFactorSetup => Href("/two-factor/setup", LocalUrl(ReturnUrl)),
            _ => Href("/two-factor", LocalUrl(ReturnUrl)),
        });
    }

    private sealed class ChangeInput
    {
        public string? NewPassword { get; set; }
        public string? ConfirmPassword { get; set; }
    }
}
