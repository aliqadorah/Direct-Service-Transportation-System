<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Accounting pages and client services (design a.10), filled from Stage 3 session 14. It reaches data only through the REST API:
       Accounting.Contracts, Platform.Contracts and Shared.UI. -->
  <PropertyGroup>
    <RootNamespace>DirectService.Accounting.UI</RootNamespace>
    <!-- CS8669: the Razor generator writes nullable type arguments (TValue="string?") into "#nullable disable" regions; harmless. -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="DirectService.Shared.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DirectService.Accounting.Contracts\DirectService.Accounting.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Shared\DirectService.Shared.UI\DirectService.Shared.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>
</Project>
