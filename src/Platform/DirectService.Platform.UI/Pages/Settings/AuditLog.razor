@page "/c/{Company}/settings/audit-log"
@*
  SCR-77 audit log (FR-189, DT-121; settings.manage or users.manage): every change with time, user, action, record type and reference, reason,
  field changes old → new and IP address; filters by action, record type, user, period (applied with Apply) and text; Excel / CSV / PDF and background export. Driver
  personal fields are masked for readers without drv.view; erased records show *** (DT-134).
*@
@inject Api Api
@inject Loc L
@inject ShellState Shell
@inject ToastService Toasts
@inject Downloads Files

<PageHeader Title="@L["nav.audit"]" Crumbs="@([new Crumb(L["nav.settings"]), new Crumb(L["nav.audit"])])" />
<ListShell Label="@L["nav.audit"]" Search="@_q" OnSearch="Search" Exports="@(["xlsx", "csv", "pdf"])" OnExport="Export" State="_state" Reference="@_reference" OnRetry="Load"
           EmptyIcon="history" EmptyTitle="@L["aud.none"]" Filtered="Filtered" OnClear="ClearAll" Page="_page" PageSize="50" Total="_result?.TotalCount" OnPage="Go">
    <Tools>
        @if (Shell.Can(PlatformPermissionKeys.SettingsManage))
        {
            <Btn Small="true" Ghost="@(!_technical)" Icon="eye" Text="@L["aud.technical"]" Pressed="@(_technical ? "true" : "false")" OnClick="ToggleTechnical" />
        }
        <Btn Small="true" Icon="clock" Text="@L["rep.background"]" OnClick="Background" />
    </Tools>
    <Filters>
        <SelectField TValue="string?" @bind-Value="_action" Options="Actions" Empty="@L["tar.all"]" Label="@L["aud.action"]" FieldClass="w200" />
        <SelectField TValue="string?" @bind-Value="_type" Options="Types" Empty="@L["tar.all"]" Label="@L["aud.type"]" FieldClass="w200" />
        <SelectField TValue="string?" @bind-Value="_user" Options="Users" Empty="@L["tar.all"]" Label="@L["mnt.user"]" FieldClass="w200" />
        <DateField @bind-Value="_from" Label="@L["trip.from"]" FieldClass="w160" />
        <DateField @bind-Value="_to" Label="@L["trip.to"]" FieldClass="w160" />
        <Btn Icon="filter" Text="@L["trip.apply"]" OnClick="Apply" />
        @if (Filtered) {<Btn Ghost="true" Text="@L["ui.clear"]" OnClick="ClearAll" />}
    </Filters>
    <ChildContent>
        <DataGrid TItem="AuditLogEntry" Items="_result!.Items" Key="a => (object)a" Caption="@L["nav.audit"]">
            <Columns>
                <GridColumn TItem="AuditLogEntry" Title="@L["aud.time"]" Value="a => Fmt.DateTime(a.OccurredAt.ToLocalTime(), Shell.DateFormat)" Ltr="true" />
                <GridColumn TItem="AuditLogEntry" Title="@L["mnt.user"]" Value="@(a => a.User ?? L["hist.system"])" />
                <GridColumn TItem="AuditLogEntry" Title="@L["aud.action"]" Value="a => a.ActionLabel ?? ActionName(a.Action)" />
                <GridColumn TItem="AuditLogEntry" Title="@L["aud.type"]" Value="a => a.EntityLabel ?? a.EntityType" />
                <GridColumn TItem="AuditLogEntry" Title="@L["aud.record"]" Value="a => a.Record" />
                <GridColumn TItem="AuditLogEntry" Title="@L["aud.changes"]" Wrap="true">
                    <Template>
                        <div class="ev">
                            <AuditEvent Text="@(context.Text ?? ActionName(context.Action))" Links="context.Links" Lines="context.Lines" Max="6"
                                        Changes="@(context.Changes.Select(c => new AuditEvent.Change(c.Field, c.Old, c.New)).ToList())" />
                        </div>
                    </Template>
                </GridColumn>
                <GridColumn TItem="AuditLogEntry" Title="@L["ui.reason"]" Value="a => a.Reason" Clip="true" />
                <GridColumn TItem="AuditLogEntry" Title="IP" Value="a => a.IpAddress" Ltr="true" />
                @if (_technical)
                {
                    <GridColumn TItem="AuditLogEntry" Title="@L["aud.technical"]" Wrap="true">
                        <Template>
                            <div class="tech">@context.Action · @context.EntityType</div>
                            @foreach (var c in context.Technical ?? []) {<div class="tech">@c.Field: @(c.Old ?? "null") → @(c.New ?? "null")</div>}
                        </Template>
                    </GridColumn>
                }
            </Columns>
        </DataGrid>
    </ChildContent>
</ListShell>

@code {
    private PagedResult<AuditLogEntry>? _result;
    private Facets? _facets;
    private LoadState _state = LoadState.Loading;
    private string? _reference, _q, _action, _type, _user;
    private DateOnly? _from, _to;
    private Filter _applied = new(null, null, null, null, null);
    private int _page = 1, _version;

    [Parameter] public string Company { get; set; } = "";

    /// <summary>The filters of the list on screen: pages and exports use these, never values chosen but not applied (review M4).</summary>
    private sealed record Filter(string? Action, string? Type, string? User, DateOnly? From, DateOnly? To);

    private bool Filtered => _q is not null || _applied != new Filter(null, null, null, null, null);
    private IReadOnlyList<Option<string?>> Actions => (_facets?.Actions ?? []).Select(a => new Option<string?>(a.Id, a.Name)).ToList();
    private IReadOnlyList<Option<string?>> Types => (_facets?.EntityTypes ?? []).Select(t => new Option<string?>(t.Id, t.Name)).ToList();
    private bool _technical;

    /// <summary>The stored values beside the readable ones (DT-188): administrators with settings.manage; the API checks it too.</summary>
    private Task ToggleTechnical()
    {
        _technical = !_technical;
        return Load();
    }
    private IReadOnlyList<Option<string?>> Users => (_facets?.Users ?? []).Select(u => new Option<string?>(u.Id, u.Name)).ToList();

    private string ActionName(string a) => L["hist." + a] is var t && !t.StartsWith("hist.", StringComparison.Ordinal) ? t : a;

    protected override Task OnInitializedAsync() => Load();

    private string Query(bool paged)
    {
        var p = new List<string>();
        void Add(string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) p.Add(k + "=" + Uri.EscapeDataString(v)); }
        Add("q", _q); Add("action", _applied.Action); Add("entityType", _applied.Type); Add("user", _applied.User);
        Add("from", _applied.From?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
        Add("to", _applied.To?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
        if (paged) Add("page", _page.ToString(System.Globalization.CultureInfo.InvariantCulture));
        if (_technical) Add("technical", "true");
        return p.Count == 0 ? "" : "?" + string.Join('&', p);
    }

    private async Task Load()
    {
        var version = ++_version;
        if (_facets is null)
        {
            // Filter options; a failed load is tried again with the next list request (review L13).
            try { _facets = await Api.GetAsync<Facets>(Api.C("audit-log/facets")); } catch (ApiException) { }
        }
        try
        {
            var result = await Api.GetAsync<PagedResult<AuditLogEntry>>(Api.C("audit-log" + Query(true)));
            if (version != _version) return;   // a later page, search or filter is on its way (review M6)
            _result = result;
            _state = _result.Items.Count == 0 && _page == 1 ? LoadState.Empty : LoadState.Ready;
        }
        catch (ApiException e) when (version == _version) { _reference = e.Problem.Reference; _state = LoadState.Error; }
    }

    private Task Search(string? q) { _q = q; _page = 1; return Load(); }
    private Task Apply() { _applied = new Filter(_action, _type, _user, _from, _to); _page = 1; return Load(); }
    private Task Go(int p) { _page = p; return Load(); }
    private Task ClearAll() { _q = _action = _type = _user = null; _from = _to = null; return Apply(); }
    private Task Export(string format) => Files.SaveAsync(Api.C("audit-log/export" + Query(false)), format);

    private async Task Background()
    {
        try
        {
            await Api.PostAsync<ExportJobResponse>(Api.C("exports"), new
            {
                Kind = "audit-log", Audit = new AuditLogQuery(_applied.User, _applied.Action, _applied.Type, _applied.From, _applied.To, _q, Technical: _technical), From = _applied.From, To = _applied.To, Format = "xlsx",
            });
            Toasts.Success(L["rep.backgroundQueued"]);
        }
        catch (ApiException e) { Toasts.Error(e.Problem.Detail ?? L["ui.loadFailed"]); }
    }

    private sealed record Facets(IReadOnlyList<FacetUser> EntityTypes, IReadOnlyList<FacetUser> Actions, IReadOnlyList<FacetUser>? Users);

    private sealed record FacetUser(string Id, string Name);
}
