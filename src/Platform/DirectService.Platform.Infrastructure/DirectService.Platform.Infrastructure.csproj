<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform persistence (core.* configurations, the anchors' foreign keys from Shared tables, the platform seed), identity stores and
       token providers, the e-mail outbox and transports with the logo, the development payment gateway (Stage 2 session 11). -->
  <PropertyGroup>
    <RootNamespace>DirectService.Platform.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DirectService.Platform.Application\DirectService.Platform.Application.csproj" />
    <ProjectReference Include="..\..\Shared\DirectService.Shared.Infrastructure\DirectService.Shared.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- MimeMessageBuilder / EmailLogo are internal; the tests that read them. -->
    <InternalsVisibleTo Include="DirectService.Transportation.Infrastructure.Tests" />
    <InternalsVisibleTo Include="DirectService.Transportation.Api.Tests" />
    <InternalsVisibleTo Include="DirectService.Architecture.Tests" />
    <InternalsVisibleTo Include="DirectService.Testing" />
  </ItemGroup>
  <ItemGroup>
    <!-- ASP.NET Core Identity token providers and Data Protection -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- System email, Microsoft 365 (DT-250): the Entra client-secret token for Microsoft Graph (already in the graph through Microsoft.Data.SqlClient). -->
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>
  <ItemGroup>
    <!-- The logo of every email (inline image "cid:logo", DT-253); same LogicalName (E-32), moved here with EmailLogo. -->
    <EmbeddedResource Include="..\..\..\assets\logo.png" LogicalName="DST.Email.Logo.png" />
  </ItemGroup>
</Project>
