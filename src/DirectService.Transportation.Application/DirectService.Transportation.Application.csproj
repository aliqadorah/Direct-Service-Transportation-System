<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DirectService.Transportation.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="DirectService.SharedKernel" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DirectService.Transportation.Domain\DirectService.Transportation.Domain.csproj" />
    <ProjectReference Include="..\DirectService.Transportation.Contracts\DirectService.Transportation.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>
  <!-- Brand fonts embedded in printed documents (UX-07, UX-23): the same files the UI serves (assets/fonts), as data: URIs. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\fonts\ibm-plex-sans-arabic-*-400-normal.woff2;..\..\assets\fonts\ibm-plex-sans-arabic-*-600-normal.woff2;..\..\assets\fonts\ibm-plex-sans-arabic-*-700-normal.woff2;..\..\assets\fonts\inter-latin-400-normal.woff2;..\..\assets\fonts\inter-latin-600-normal.woff2;..\..\assets\fonts\inter-latin-700-normal.woff2" LogicalName="fonts/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
