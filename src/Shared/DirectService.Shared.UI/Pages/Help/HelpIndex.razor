@page "/c/{Company}/help"
@* Help (D-18, REL-10): the list of help pages, one per PRD Section 9 flow, in the user's language. *@
@using DirectService.Shared.UI.Help
@inject Loc L

<PageHeader Title="@L["help.title"]" />

<p class="muted hd-lead">@L["help.lead"]</p>
<ol class="hd-index">
    @foreach (var topic in HelpTopics.All)
    {
        var text = L.En ? topic.En : topic.Ar;
        <li>
            <a href="@($"/c/{Company}/help/{topic.Key}")">@text.Title</a>
            <span class="muted"><Tx Value="@text.Summary" /></span>
        </li>
    }
</ol>

@code {
    [Parameter] public string Company { get; set; } = "";
}
