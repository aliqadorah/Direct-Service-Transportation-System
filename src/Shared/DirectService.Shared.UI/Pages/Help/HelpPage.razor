@page "/c/{Company}/help/{Topic}"
@* One help page (D-18, REL-10): a PRD Section 9 flow — who may do it, the steps, what to do when something goes wrong, and links to
   its screens. Linked from those screens' headers (PageHeader Help). *@
@using DirectService.Shared.UI.Help
@inject Loc L

@if (_topic is null)
{
    <NotFoundView />
}
else
{
    var text = L.En ? _topic.En : _topic.Ar;
    <PageHeader Title="@text.Title" Crumbs="@([new Crumb(L["help.title"], $"/c/{Company}/help")])" />
    <article class="helpdoc">
        <p class="hd-lead"><Tx Value="@text.Summary" /></p>
        <p><b>@L["help.who"]</b> <Tx Value="@text.Who" /></p>

        <section aria-labelledby="help-steps">
            <h2 id="help-steps">@L["help.steps"]</h2>
            <ol>@foreach (var s in text.Steps) {<li><Tx Value="@s" /></li>}</ol>
        </section>

        @if (text.Problems.Count > 0)
        {
            <section aria-labelledby="help-problems">
                <h2 id="help-problems">@L["help.problems"]</h2>
                <ul>@foreach (var p in text.Problems) {<li><Tx Value="@p" /></li>}</ul>
            </section>
        }

        <section aria-labelledby="help-screens">
            <h2 id="help-screens">@L["help.screens"]</h2>
            <ul class="hd-links">@foreach (var s in _topic.Screens) {<li><a href="@NavModel.Href(Company, s.Route)">@L[s.LabelKey]</a></li>}</ul>
        </section>

        <p class="muted hd-ref">@L.F("help.prd", _topic.Prd)</p>
    </article>
}

@code {
    [Parameter] public string Company { get; set; } = "";
    [Parameter] public string Topic { get; set; } = "";

    private HelpTopic? _topic;

    protected override void OnParametersSet() => _topic = HelpTopics.Find(Topic);
}
