@page "/c/{Company}/reports/builder"
@page "/c/{Company}/reports/builder/{Id}"
@*
  SCR-52 report builder (FR-143…147, DT-115…117): a data source the user may read, with custom fields; summary mode with up to two row
  groupings (dates by day / month / quarter / year), an optional column grouping, 1–6 measures (sum, count, average, min, max), filters,
  sort and top-N — or detail mode with chosen columns; a period. Run (first rows on screen), export Excel / PDF or in the background, save
  as a private report or — with settings.manage — a shared one (DT-116). Opening a saved report edits it.
*@
@inject Api Api
@inject Loc L
@inject ShellState Shell
@inject ToastService Toasts
@inject UiJs Js
@inject NavigationManager Nav

<PageHeader Title="@(_saved is null ? L["nav.reportBuilder"] : _saved.Name)" Crumbs="@([new Crumb(L["nav.reports"]), new Crumb(L["nav.reportBuilder"], NavModel.Href(Company, "reports/builder"))])">
    <Actions>
        <Btn Icon="export" Text="Excel" Disabled="_source is null" OnClick="@(() => Export("xlsx"))" />
        <Btn Icon="print" Text="PDF" Disabled="_source is null" OnClick="@(() => Export("pdf"))" />
        <Btn Icon="clock" Text="@L["rep.background"]" Disabled="_source is null" OnClick="Background" />
        @if (_saved is null || _saved.CanEdit) {<Btn Icon="pin" Text="@L[_saved is null ? "rb.save" : "rb.update"]" Disabled="_source is null" OnClick="() => _saving = true" />}
        <Btn Primary="true" Icon="filter" Text="@L["rep.run"]" Busy="_busy" Disabled="_source is null" OnClick="Run" />
    </Actions>
</PageHeader>
@if (_problem is not null) {<Banner Tone="Tone.Err" Text="@_problem" />}
<div class="cols fill" style="grid-template-columns:340px 1fr;min-height:0">
    <div class="box pad stack scrolls" style="gap:10px">
        <SelectField TValue="string?" Value="_source" ValueChanged="SourceChanged" ValueExpression="() => _source" Options="SourceOptions" Empty="@L["ui.choose"]" Label="@L["rb.source"]" Required="true" Error="@Mark("source")" />
        @if (Fields.Count > 0)
        {
            <div class="row" style="gap:8px">
                <DateField @bind-Value="_from" Label="@L["trip.from"]" Error="@Mark("from")" />
                <DateField @bind-Value="_to" Label="@L["trip.to"]" Error="@Mark("to")" />
            </div>
            <ToggleField @bind-Value="_detail" Label="@L["rb.detail"]" Help="@L[_detail ? "rb.detailOnHint" : "rb.detailHelp"]" />
            @if (_detail)
            {
                @* Detail mode lists records: groupings and measures are hidden (kept for when it is turned off), DT-180. *@
                <fieldset class="stack" style="border:0;padding:0;margin:0;gap:4px" aria-describedby="@(Mark("columns") is null ? null : "rb-columns-e")">
                    <legend class="lbl">@L["rb.columns"]</legend>
                    @if (Mark("columns") is { } columnsError) {<div id="rb-columns-e" class="help err"><Icon Name="alert" /><span><Tx Value="@columnsError" /></span></div>}
                    @foreach (var f in Fields)
                    {
                        var field = f;
                        <label style="display:flex;gap:6px;align-items:center"><input type="checkbox" checked="@_columns.Contains(field.Key)" @onchange="e => ToggleColumn(field.Key, e.Value is true)" />@field.Label</label>
                    }
                </fieldset>
            }
            else
            {
                <h3 class="lbl" style="margin:0">@L["rb.rows"]</h3>
                @for (var i = 0; i < _rows.Count; i++)
                {
                    var g = _rows[i];
                    var n = i + 1;
                    var at = i;
                    <div class="row" style="gap:6px;align-items:flex-end">
                        <SelectField TValue="string?" @bind-Value="g.Field" Options="Groupable" Empty="—" Label="@L.F("rb.groupN", n)" Error="@Mark("row", at)" />
                        @if (IsDate(g.Field)) {<SelectField TValue="string?" @bind-Value="g.Unit" Options="Units" Label="@L["rb.unit"]" />}
                        <Btn Ghost="true" Icon="trash" AriaLabel="@L.F("rb.removeGroup", n)" Disabled="_rows.Count <= 1" OnClick="() => _rows.Remove(g)" />
                    </div>
                }
                @if (_rows.Count < 2) {<Btn Small="true" Icon="plus" Text="@L["rb.addGroup"]" OnClick="() => _rows.Add(new GroupModel())" />}
                <h3 class="lbl" style="margin:0">@L["rb.columnGroup"]</h3>
                <div class="row" style="gap:6px;align-items:flex-end">
                    <SelectField TValue="string?" @bind-Value="_column.Field" Options="Groupable" Empty="—" Label="@L["rb.field"]" Help="@L["rb.columnGroupHelp"]" Error="@Mark("column")" />
                    @if (IsDate(_column.Field)) {<SelectField TValue="string?" @bind-Value="_column.Unit" Options="Units" Label="@L["rb.unit"]" />}
                </div>
                <h3 class="lbl" style="margin:0">@L["rb.measures"]</h3>
                @for (var i = 0; i < _measures.Count; i++)
                {
                    var m = _measures[i];
                    var n = i + 1;
                    var at = i;
                    <div class="row" style="gap:6px;align-items:flex-end">
                        <SelectField TValue="string?" @bind-Value="m.Function" Options="Functions" Label="@L.F("rb.measureN", n)" Error="@(m.Function == "count" ? Mark("measure", at) : null)" />
                        @if (m.Function != "count") {<SelectField TValue="string?" @bind-Value="m.Field" Options="Measurable" Empty="—" Label="@L["rb.field"]" Error="@Mark("measure", at)" />}
                        <Btn Ghost="true" Icon="trash" AriaLabel="@L.F("rb.removeMeasure", n)" Disabled="_measures.Count <= 1" OnClick="() => _measures.Remove(m)" />
                    </div>
                }
                @if (_measures.Count < 6) {<Btn Small="true" Icon="plus" Text="@L["rb.addMeasure"]" OnClick="() => _measures.Add(new MeasureModel())" />}
                <div class="row" style="gap:6px;align-items:flex-end">
                    <SelectField TValue="string?" @bind-Value="_sortBy" Options="SortOptions" Empty="—" Label="@L["rb.sort"]" />
                    <CheckField @bind-Value="_sortDesc" Label="@L["rb.desc"]" />
                    <IntField @bind-Value="_top" Label="@L["rb.top"]" Min="1" Max="1000" Error="@Mark("top")" />
                </div>
            }
            <h3 class="lbl" style="margin:0">@L["rb.filters"]</h3>
            @for (var i = 0; i < _filters.Count; i++)
            {
                var flt = _filters[i];
                var n = i + 1;
                var at = i;
                <div class="stack" style="gap:4px;border-bottom:1px solid var(--border);padding-bottom:6px">
                    <div class="row" style="gap:6px;align-items:flex-end">
                        <SelectField TValue="string?" @bind-Value="flt.Field" Options="Filterable" Empty="—" Label="@L.F("rb.filterN", n)" Error="@(flt.Operator is "empty" or "notEmpty" ? Mark("filter", at) : null)" />
                        <SelectField TValue="string?" @bind-Value="flt.Operator" Options="Operators" Label="@L["rb.operator"]" />
                        <Btn Ghost="true" Icon="trash" AriaLabel="@L.F("rb.removeFilter", n)" OnClick="() => _filters.Remove(flt)" />
                    </div>
                    @if (flt.Operator is not ("empty" or "notEmpty"))
                    {
                        <TextField @bind-Value="flt.Value" Label="@L[flt.Operator is "in" ? "rb.values" : "rb.value"]" Help="@(flt.Operator is "in" ? L["rb.valuesHelp"] : null)" Error="@Mark("filter", at)" />
                        @if (flt.Operator == "between") {<TextField @bind-Value="flt.Value2" Label="@L["rb.value2"]" />}
                    }
                </div>
            }
            <Btn Small="true" Icon="plus" Text="@L["rb.addFilter"]" OnClick="() => _filters.Add(new FilterModel())" />
        }
    </div>
    <div class="stack" style="min-width:0;min-height:0">
        @if (_result is null)
        {
            <Box Fill="true"><EmptyState Icon="chart" Title="@L["rb.empty"]" Text="@L["rb.emptyText"]" /></Box>
        }
        else
        {
            @* A failed run leaves no stale rows that look like its answer: the earlier result is dimmed and marked (owner feedback 13 Oct 2026). *@
            @if (_stale) {<Banner Tone="Tone.Warn" Icon="clock" Text="@L["rb.stale"]" />}
            <div class="stack@(_stale ? " stale" : null)" style="min-width:0;min-height:0;flex:1" inert="@_stale" aria-hidden="@(_stale ? "true" : null)">
                @if (_result.Rows.Count == 0)
                {
                    <Box Fill="true"><EmptyState Icon="chart" Title="@L["rep.noRows"]" Text="@L["rep.noRowsText"]" /></Box>
                }
                else
                {
                    <ListFrame Label="@_result.Title"><ChildContent><ReportGrid Result="_result" /></ChildContent></ListFrame>
                }
            </div>
        }
    </div>
</div>

<Modal @bind-Open="_saving" Title="@L[_saved is null ? "rb.save" : "rb.update"]" Busy="_busy">
    <ChildContent>
        <div class="field">
            <label for="rb-name">@L["md.name"] <span class="req" aria-hidden="true">*</span></label>
            <input id="rb-name" class="input" maxlength="100" @bind="_name" @bind:event="oninput" />
        </div>
        @if (Shell.Can(PlatformPermissionKeys.SettingsManage)) {<CheckField @bind-Value="_shared" Label="@L["rb.shared"]" Help="@L["rb.sharedHelp"]" />}
        @if (_saveError is not null) {<Banner Tone="Tone.Err" Text="@_saveError" />}
    </ChildContent>
    <Footer>
        <Btn Text="@L["ui.cancel"]" OnClick="() => _saving = false" />
        <Btn Primary="true" Text="@L["ui.save"]" Busy="_busy" Disabled="@string.IsNullOrWhiteSpace(_name)" OnClick="Save" />
    </Footer>
</Modal>

@code {
    private IReadOnlyList<DataSourceInfo> _sources = [];
    private SavedReportResponse? _saved;
    private ReportResult? _result;
    private string? _source, _sortBy, _problem, _name, _saveError;
    private DateOnly? _from, _to;
    private bool _detail, _sortDesc = true, _busy, _saving, _shared, _stale;
    private int? _top;
    // Summary mode opens with one (empty) row grouping, so the first list under "Row grouping" is a row grouping (owner feedback 13 Oct 2026).
    private List<GroupModel> _rows = [new()];
    // Messages on the side panel's settings ("row:0", "measure:1", "filter:0", "columns", "top", "source", "from", "to").
    private readonly Dictionary<string, string> _marks = new(StringComparer.Ordinal);
    // The groupings and filters of the last definition sent, in order: the server's indexes point into these.
    private List<GroupModel> _sentRows = [];
    private List<FilterModel> _sentFilters = [];
    private GroupModel _column = new();
    private List<MeasureModel> _measures = [new()];
    private List<FilterModel> _filters = [];
    private HashSet<string> _columns = new(StringComparer.Ordinal);

    [Parameter] public string Company { get; set; } = "";
    [Parameter] public string? Id { get; set; }

    private IReadOnlyList<SourceField> Fields => _sources.FirstOrDefault(s => s.Key == _source)?.Fields ?? [];
    private IReadOnlyList<Option<string?>> SourceOptions => _sources.Select(s => new Option<string?>(s.Key, s.Label)).ToList();
    private IReadOnlyList<Option<string?>> Groupable => Fields.Where(f => f.Groupable).Select(f => new Option<string?>(f.Key, f.Label)).ToList();
    private IReadOnlyList<Option<string?>> Measurable => Fields.Where(f => f.Measurable).Select(f => new Option<string?>(f.Key, f.Label)).ToList();
    private IReadOnlyList<Option<string?>> Filterable => Fields.Select(f => new Option<string?>(f.Key, f.Label)).ToList();
    private IReadOnlyList<Option<string?>> Units => [new("day", L["rb.day"]), new("month", L["per.month"]), new("quarter", L["rb.quarter"]), new("year", L["rb.year"])];
    private IReadOnlyList<Option<string?>> Functions => [new("sum", L["rb.sum"]), new("count", L["dash.count"]), new("avg", L["rb.avg"]), new("min", L["rb.min"]), new("max", L["rb.max"])];
    private IReadOnlyList<Option<string?>> Operators =>
        new[] { "eq", "ne", "gt", "ge", "lt", "le", "contains", "in", "between", "empty", "notEmpty" }.Select(o => new Option<string?>(o, L["rb.op." + o])).ToList();
    private IReadOnlyList<Option<string?>> SortOptions =>
        new[] { new Option<string?>("group", L["rb.byGroup"]) }.Concat(_measures.Select((m, i) => new Option<string?>($"measure:{i}", L.F("rb.measureN", i + 1)))).ToList();

    private bool IsDate(string? field) => Fields.FirstOrDefault(f => f.Key == field)?.Type == "date";

    protected override async Task OnParametersSetAsync()
    {
        try { _sources = await Api.GetAsync<IReadOnlyList<DataSourceInfo>>(Api.C("reports/builder/sources")); }
        catch (ApiException e) { _problem = e.Problem.Detail; }
        if (Id is not null)
        {
            try
            {
                _saved = await Api.GetAsync<SavedReportResponse>(Api.C($"reports/saved/{Uri.EscapeDataString(Id)}"));
                Apply(_saved.Source, _saved.Definition);
                _name = _saved.Name;
                _shared = _saved.IsShared;
                await Run();
            }
            catch (ApiException e) { _problem = e.Problem.Detail; }
        }
    }

    private void SourceChanged(string? s)
    {
        _source = s;
        _rows = [new GroupModel()];
        _column = new GroupModel();
        _measures = [new MeasureModel()];
        _filters = [];
        _columns.Clear();
        _result = null;
        _stale = false;
        _problem = null;
        _marks.Clear();
    }

    private void ToggleColumn(string key, bool on) { if (on) _columns.Add(key); else _columns.Remove(key); }

    /// <summary>Fills the editor from a saved definition.</summary>
    private void Apply(string source, ReportDefinition d)
    {
        _source = source;
        _detail = d.Detail;
        _rows = (d.Rows ?? []).Select(r => new GroupModel { Field = r.Field, Unit = r.DateUnit }).ToList();
        if (_rows.Count == 0) _rows.Add(new GroupModel());
        _column = d.Column is { } c ? new GroupModel { Field = c.Field, Unit = c.DateUnit } : new GroupModel();
        _measures = (d.Measures ?? []).Select(m => new MeasureModel { Function = m.Function, Field = m.Field }).ToList();
        if (_measures.Count == 0) _measures.Add(new MeasureModel());
        _filters = (d.Filters ?? []).Select(f => new FilterModel { Field = f.Field, Operator = f.Operator, Value = f.Operator == "in" ? string.Join(", ", f.Values ?? []) : f.Values?.FirstOrDefault(),
            Value2 = f.Operator == "between" ? f.Values?.Skip(1).FirstOrDefault() : null }).ToList();
        _sortBy = d.Sort?.By;
        _sortDesc = d.Sort?.Descending ?? true;
        _top = d.Top;
        _columns = new HashSet<string>(d.Columns ?? [], StringComparer.Ordinal);
    }

    private ReportDefinition Definition()
    {
        IReadOnlyList<string>? Values(FilterModel f) => f.Operator switch
        {
            "empty" or "notEmpty" => null,
            "in" => (f.Value ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            "between" => [f.Value ?? "", f.Value2 ?? ""],
            _ => [f.Value ?? ""],
        };
        _sentFilters = _filters.Where(f => f.Field is not null).ToList();
        _sentRows = _detail ? [] : _rows.Where(r => r.Field is not null).ToList();
        var filters = _sentFilters.Select(f => new ReportFilter(f.Field!, f.Operator ?? "eq", Values(f))).ToList();
        if (_detail) return new ReportDefinition(null, null, null, filters, null, null, true, _columns.ToList());
        return new ReportDefinition(
            _sentRows.Select(r => new ReportGrouping(r.Field!, IsDate(r.Field) ? r.Unit ?? "month" : null)).ToList(),
            _column.Field is null ? null : new ReportGrouping(_column.Field, IsDate(_column.Field) ? _column.Unit ?? "month" : null),
            _measures.Select(m => new ReportMeasure(m.Function ?? "sum", m.Function == "count" ? null : m.Field)).ToList(),
            filters, _sortBy is null ? null : new ReportSort(_sortBy, _sortDesc), _top, false, null);
    }

    private string? Mark(string kind, int index = 0) => _marks.GetValueOrDefault(kind + ":" + index.ToString(System.Globalization.CultureInfo.InvariantCulture));

    private void SetMark(string kind, int index, string message) => _marks.TryAdd(kind + ":" + index.ToString(System.Globalization.CultureInfo.InvariantCulture), message);

    /// <summary>
    /// Checks the settings before anything is sent (owner feedback 13 Oct 2026): a summary needs a row grouping and a field for every
    /// measure but Count, detail mode its columns, a filter its value, a period its order. Problems are marked on their setting.
    /// </summary>
    private IReadOnlyList<string> Check()
    {
        _marks.Clear();
        var problems = new List<string>();
        void Add(string kind, int index, string message) { SetMark(kind, index, message); problems.Add(message); }
        if (_from is { } from && _to is { } to && from > to) Add("to", 0, L["rb.periodOrder"]);
        if (_detail)
        {
            if (_columns.Count is < 1 or > MaxColumns) Add("columns", 0, L.F("rb.needColumns", MaxColumns));
        }
        else
        {
            if (_rows.Count == 0) _rows.Add(new GroupModel());
            if (_rows.All(r => r.Field is null)) Add("row", 0, L["rb.needRow"]);
            for (var i = 0; i < _measures.Count; i++)
                if (_measures[i].Function != "count" && _measures[i].Field is null) Add("measure", i, L.F("rb.needMeasureField", i + 1));
        }
        for (var i = 0; i < _filters.Count; i++)
        {
            var f = _filters[i];
            if (f.Field is null || f.Operator is "empty" or "notEmpty") continue;
            if (string.IsNullOrWhiteSpace(f.Value) || f.Operator == "between" && string.IsNullOrWhiteSpace(f.Value2)) Add("filter", i, L.F("rb.needValue", i + 1));
        }
        return problems;
    }

    /// <summary>The server's refusal as messages on the settings; never an internal name (field paths are only used to find the setting).</summary>
    private IReadOnlyList<string> Refused(ApiProblem p)
    {
        _marks.Clear();
        if (p.Errors is not { Count: > 0 } errors) return [p.Detail ?? L["rb.checkSettings"]];
        var messages = new List<string>();
        foreach (var e in errors)
        {
            var message = ReportProblems.Message(e, L);
            if (!messages.Contains(message)) messages.Add(message);
            if (ReportProblems.PlaceOf(e.Field) is not { } place) continue;
            var index = place.Kind switch
            {
                "row" => place.Index < _sentRows.Count ? _rows.IndexOf(_sentRows[place.Index]) : 0,
                "filter" => place.Index < _sentFilters.Count ? _filters.IndexOf(_sentFilters[place.Index]) : place.Index,
                _ => place.Index,
            };
            SetMark(place.Kind, Math.Max(index, 0), message);
        }
        return messages;
    }

    private void Failed(IReadOnlyList<string> messages, bool run)
    {
        var text = string.Join(" · ", messages);
        _problem = run ? L.F("rb.notShown", text) : text;
        _stale = _result is not null;
    }

    private async Task Run()
    {
        if (_source is null) return;
        _problem = null;
        if (Check() is { Count: > 0 } problems) { Failed(problems, true); return; }
        _busy = true;
        try
        {
            _result = await Api.PostAsync<ReportResult>(Api.C("reports/builder/run"), new ReportRunRequest(_source, Definition(), _from, _to));
            _stale = false;
        }
        catch (ApiException e) { Failed(Refused(e.Problem), true); }
        finally { _busy = false; }
    }

    private async Task Export(string format)
    {
        _problem = null;
        if (Check() is { Count: > 0 } problems) { Failed(problems, false); return; }
        try
        {
            var file = await Api.FileAsync(Api.C("reports/builder/export?format=" + format), new ReportRunRequest(_source, Definition(), _from, _to));
            await Js.SaveFile(file.Name, file.ContentType, file.Bytes);
        }
        catch (ApiException e) { Failed(Refused(e.Problem), false); }
    }

    private async Task Background()
    {
        _problem = null;
        if (Check() is { Count: > 0 } problems) { Failed(problems, false); return; }
        try
        {
            await Api.PostAsync<ExportJobResponse>(Api.C("exports"), new { Kind = "builder", Source = _source, Definition = Definition(), From = _from, To = _to, Format = "xlsx" });
            Toasts.Success(L["rep.backgroundQueued"]);
        }
        catch (ApiException e) { Failed(Refused(e.Problem), false); }
    }

    private async Task Save()
    {
        _saveError = null;
        if (Check() is { Count: > 0 } problems) { _saveError = string.Join(" · ", problems); return; }
        _busy = true;
        try
        {
            var req = new SavedReportRequest(_name?.Trim(), _source, Definition(), _shared, _saved?.RowVersion);
            var r = _saved is null
                ? await Api.PostAsync<SavedReportResponse>(Api.C("reports/saved"), req)
                : await Api.PutAsync<SavedReportResponse>(Api.C($"reports/saved/{Uri.EscapeDataString(_saved.Id)}"), req);
            _saving = false;
            Toasts.Success(L.F("rb.saved", r.Name), L["nav.savedReports"], NavModel.Href(Company, "reports/saved"));
            if (_saved is null) Nav.NavigateTo(NavModel.Href(Company, $"reports/builder/{r.Id}"));
            else _saved = r;
        }
        catch (ApiException e) { _saveError = string.Join(" · ", Refused(e.Problem)); }
        finally { _busy = false; }
    }

    private const int MaxColumns = 30;   // ReportBuilderService.MaxColumns

    private sealed class GroupModel
    {
        public string? Field { get; set; }
        public string? Unit { get; set; } = "month";
    }

    private sealed class MeasureModel
    {
        public string? Function { get; set; } = "count";
        public string? Field { get; set; }
    }

    private sealed class FilterModel
    {
        public string? Field { get; set; }
        public string? Operator { get; set; } = "eq";
        public string? Value { get; set; }
        public string? Value2 { get; set; }
    }
}
