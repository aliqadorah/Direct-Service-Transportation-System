@*
  The rejected rows of an import preview (owner feedback 13 Oct 2026): a summary (rows with problems, problems, problems per column) and
  one line per problem with the row number of the file, its key, the column, the problem and how to fix it. Rows without problems are
  not listed. Previews of importers that give no details show their problem text with an empty column and fix.
*@

@if (Lines.Count == 0)
{
    <Banner Tone="Tone.Ok" Text="@L.F("imp.noProblems", Rows.Count)" />
}
else
{
    <Box Title="@L.F("imp.summary", Rejected, Lines.Count, Rows.Count)" Style="flex:none">
        <div class="row" style="flex-wrap:wrap;gap:4px;align-items:center">
            <span class="help" style="margin:0">@L["imp.byColumn"]</span>
            @foreach (var (column, count) in ByColumn)
            {
                <span class="chip"><bdi>@column</bdi> <bdi class="num">(@Fmt.Count(count))</bdi></span>
            }
        </div>
    </Box>
    <ListFrame Label="@L["imp.problemList"]">
        <DataGrid TItem="Line" Items="Lines" Key="l => l.Id" Caption="@L["imp.problemList"]">
            <Columns>
                <GridColumn TItem="Line" Title="@L["imp.row"]" Value="l => Fmt.Count(l.Row)" Numeric="true" Width="70px" />
                <GridColumn TItem="Line" Title="@(KeyTitle ?? L["imp.key"])" Value="l => l.Key" Ltr="true" />
                <GridColumn TItem="Line" Title="@L["imp.column"]" Value="@(l => l.Column ?? L["imp.wholeRow"])" />
                <GridColumn TItem="Line" Title="@L["imp.problem"]" Wrap="true"><Template><Tx Value="@context.Problem" /></Template></GridColumn>
                <GridColumn TItem="Line" Title="@L["imp.fix"]" Wrap="true"><Template><Tx Value="@context.Fix" /></Template></GridColumn>
            </Columns>
        </DataGrid>
    </ListFrame>
}

@code {
    [Inject] private Loc L { get; set; } = default!;

    /// <summary>Every row of the preview (rows without problems count in the summary only).</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ImportRowResult> Rows { get; set; } = [];

    /// <summary>Title of the key column (e.g. "Receipt no.").</summary>
    [Parameter] public string? KeyTitle { get; set; }

    public sealed record Line(string Id, int Row, string? Key, string? Column, string Problem, string? Fix);

    private IReadOnlyList<Line> Lines => Rows.Where(r => r.Problems.Count > 0).OrderBy(r => r.Row)
        .SelectMany(r => r.Details is { Count: > 0 } d
            ? d.Select((p, i) => new Line($"{r.Row}-{i}", r.Row, r.Key, string.IsNullOrEmpty(p.Column) ? null : p.Column, p.Message, p.Fix))
            : r.Problems.Select((p, i) => new Line($"{r.Row}-{i}", r.Row, r.Key, null, p, null)))
        .ToList();

    private int Rejected => Rows.Count(r => r.Problems.Count > 0);

    private IEnumerable<(string Column, int Count)> ByColumn => Lines.GroupBy(l => l.Column ?? L["imp.wholeRow"])
        .Select(g => (g.Key, g.Count())).OrderByDescending(x => x.Item2).ThenBy(x => x.Key, StringComparer.Ordinal);
}
