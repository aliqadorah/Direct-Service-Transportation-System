@*
  The organisation's password rules under a password field (owner feedback 18 Oct 2026, DT-208): shown before typing, each rule ticked
  while typing, the same check as the server (TenantPasswordValidator: length, a letter, a digit — Arabic letters and digits count).
*@
@using DirectService.Platform.Contracts.Identity
@inject Loc L

@if (Policy is not null)
{
    <div class="pwrules" aria-live="polite">
        <span class="help">@L["usr.rulesTitle"]</span>
        <ul>
            @foreach (var (rule, text) in Rules(Policy))
            {
                var met = !string.IsNullOrEmpty(Password) && !Missing(Policy, Password).Contains(rule);
                <li class="@(met ? "met" : null)"><Icon Name="check" /><Tx Value="@text" /><span class="sr-only"> — @(met ? L["usr.ruleMet"] : L["usr.ruleNotMet"])</span></li>
            }
        </ul>
    </div>
}

@code {
    public enum Rule { Length, Letter, Digit }

    [Parameter] public PasswordPolicyResponse? Policy { get; set; }
    [Parameter] public string? Password { get; set; }

    private IEnumerable<(Rule, string)> Rules(PasswordPolicyResponse p)
    {
        yield return (Rule.Length, L.F("usr.ruleLength", p.MinLength));
        if (p.RequireLetter) yield return (Rule.Letter, L["usr.ruleLetter"]);
        if (p.RequireDigit) yield return (Rule.Digit, L["usr.ruleDigit"]);
    }

    /// <summary>The rules the password does not meet yet.</summary>
    public static IReadOnlyList<Rule> Missing(PasswordPolicyResponse p, string? password)
    {
        ArgumentNullException.ThrowIfNull(p);
        var pw = password ?? string.Empty;
        var missing = new List<Rule>();
        if (pw.Length < p.MinLength) missing.Add(Rule.Length);
        if (p.RequireLetter && !pw.Any(char.IsLetter)) missing.Add(Rule.Letter);
        if (p.RequireDigit && !pw.Any(char.IsDigit)) missing.Add(Rule.Digit);
        return missing;
    }
}
