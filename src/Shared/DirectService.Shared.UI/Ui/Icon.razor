@* Icon from the bundled sprite (img/icons.svg); decorative unless Label is given. Directional icons (left/right) mirror in LTR with Flip. *@
<svg class="ic @(Flip ? "flip" : null) @Class" aria-hidden="@(Label is null ? "true" : null)" role="@(Label is null ? null : "img")" aria-label="@Label" focusable="false"><use href="img/icons.svg#i-@Name"></use></svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Flip { get; set; }
    [Parameter] public string? Class { get; set; }
}
