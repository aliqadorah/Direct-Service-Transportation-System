@*
  Application shell (SCR-00): skip link, side menu, top bar, page content (main landmark) with optional page-wide banners (trial,
  past due, read-only archived company, setup incomplete), the command bar and the toast region. Ctrl+K and "/" open the command bar.
*@
@implements IAsyncDisposable
@inject Loc L
@inject UiJs Js
@inject ShellState Shell
@inject NavigationManager Nav
<a class="skip-link" href="#content">@L["shell.skip"]</a>
<div class="shell @(Provider ? "provider" : null) @(_menuOpen ? "menu-open" : null)" @key="L.Language">
    <SideNav Groups="Groups" Company="@(Shell.Company?.Id ?? "")" Foot="@Shell.PlanText" Provider="Provider" />
    <div class="main">
        <TopBar Provider="Provider" Environment="@Shell.Me?.Environment" Companies="@(Shell.SupportEnded is null ? Shell.Me?.Companies ?? [] : [])" CurrentCompany="@Shell.Company?.Id" UserName="@Shell.Me?.FullName"
                Unread="Shell.UnreadNotifications" Theme="@Shell.Theme" OnCompany="OnCompany" OnCommandBar="OpenCommandBar" OnNotifications="OnNotifications"
                OnProfile="OnProfile" OnMenu="() => _menuOpen = !_menuOpen" MenuOpen="_menuOpen" OnTheme="SetTheme" OnLanguage="OnLanguage" OnSignOut="OnSignOut" />
        <main class="content @(Fixed ? "fixed" : null)" id="content" tabindex="-1">
            @if (Shell.PageExpired)
            {
                <Banner Tone="Tone.Warn" Icon="refresh" Text="@L["shell.pageExpired"]" Live="true">
                    <Actions><Btn Small="true" Text="@L["shell.reload"]" OnClick="@(() => Nav.NavigateTo(Nav.Uri, forceLoad: true))" /></Actions>
                </Banner>
            }
            @Banners
            @ChildContent
        </main>
    </div>
</div>
<CommandBar @bind-Open="_commandBar" Commands="Commands" SearchAsync="SearchAsync" Placeholder="@L[Provider ? "shell.searchConsole" : "shell.search"]" />
<ToastHost />

@code {
    private bool _commandBar;
    private bool _menuOpen;   // phones: the menu opens as a drawer (UX-14)
    private DotNetObjectReference<AppShell>? _ref;

    [Parameter] public bool Provider { get; set; }
    /// <summary>Pages with their own scrolling areas (lists with sticky headers) fix the content height.</summary>
    [Parameter] public bool Fixed { get; set; }
    [Parameter] public RenderFragment? Banners { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IReadOnlyList<CommandResult>>>? SearchAsync { get; set; }
    [Parameter] public EventCallback<string> OnCompany { get; set; }
    [Parameter] public EventCallback OnNotifications { get; set; }
    [Parameter] public EventCallback OnProfile { get; set; }
    [Parameter] public EventCallback<string> OnLanguage { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }

    // A closed support session (DT-220) keeps no menu of the company it left.
    private IReadOnlyList<NavGroup> Groups => Provider || Shell.SupportEnded is not null ? [] : NavModel.For(Shell.Permissions, Shell.SetupIncomplete);

    // Menu pages by name in either language (DT-239), only those of the user's menu (already filtered by permission).
    private IReadOnlyList<CommandResult> Commands => Provider
        ? NavModel.Console.Select(c => new CommandResult(L[c.Key], L["shell.console"], c.Route, Loc.Both(c.Key))).ToList()
        : Groups.SelectMany(g => g.Route is not null ? [new CommandResult(L[g.Key], L["shell.mainMenu"], NavModel.Href(Shell.Company?.Id ?? "", g.Route), Loc.Both(g.Key))]
            : g.Items.Select(i => new CommandResult(L[i.Key], L[g.Key], NavModel.Href(Shell.Company?.Id ?? "", i.Route), Loc.Both(i.Key)))).ToList();

    protected override void OnInitialized()
    {
        Shell.Changed += Refresh;
        L.Changed += LanguageChanged;
        Nav.LocationChanged += Navigated;
    }

    private void Navigated(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!_menuOpen) return;
        _menuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>The direction and language of the whole document follow the interface language at once.</summary>
    private void LanguageChanged() => _ = InvokeAsync(async () =>
    {
        await Js.ApplyRoot(L.Language);
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        await Js.RegisterShortcuts(_ref);
        // Start in the language the server rendered (the profile's), so an English page is not switched back to RTL.
        L.SetLanguage(Shell.Me?.LanguageCode ?? await Js.RootLang());
        await Js.ApplyRoot(L.Language);
        // The user's theme on this device (DT-244); none saved yet = follow the device. It also becomes the device's last choice, which
        // the next page applies before its first paint.
        Shell.SetTheme(await Js.GetPref(Shell.ThemeKey));
        await Js.ApplyTheme(Shell.Theme);
    }

    [JSInvokable]
    public Task OpenCommandBar()
    {
        _commandBar = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SetTheme(string theme)
    {
        Shell.SetTheme(theme);
        await Js.SetPref(Shell.ThemeKey, Shell.Theme);
        await Js.ApplyTheme(Shell.Theme);
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Shell.Changed -= Refresh;
        L.Changed -= LanguageChanged;
        Nav.LocationChanged -= Navigated;
        await Js.UnregisterShortcuts();
        _ref?.Dispose();
    }
}
