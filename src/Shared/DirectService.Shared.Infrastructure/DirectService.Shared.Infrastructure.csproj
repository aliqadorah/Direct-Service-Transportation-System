<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared technical infrastructure (design a.1): the composed MasterDbContext with its model contributors, query filters and the audit
       interceptor (Stage 2 session 3); numbering, record locks, URL tokens, audit, files, printing, exports, report-builder engine … from
       session 4. References SharedKernel only among Shared/Platform/modules. -->
  <PropertyGroup>
    <RootNamespace>DirectService.Shared.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="DirectService.SharedKernel" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DirectService.SharedKernel\DirectService.SharedKernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Options, configuration, logging and DI of the host framework (as in the module infrastructures, design a.2). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="PuppeteerSharp" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <!-- The PDF engine's test hook (a browser that dies during a print, DT-222). -->
    <InternalsVisibleTo Include="DirectService.Transportation.Infrastructure.Tests" />
    <InternalsVisibleTo Include="DirectService.Transportation.Api.Tests" />
    <InternalsVisibleTo Include="DirectService.Architecture.Tests" />
    <InternalsVisibleTo Include="DirectService.Testing" />
  </ItemGroup>
</Project>
