<Project Sdk="Microsoft.NET.Sdk">
  <!-- Building blocks every project may use (platform design a.1/a.2): request context, data scopes, AppException, Fail / Validator, the
       shared error codes, TextNormalizer, Money, AuditableEntity and the scope interfaces, the stored-name pins. References only the
       browser-safe Shared.Contracts (FieldRef; DT-309, Architecture.Tests). -->
  <PropertyGroup>
    <RootNamespace>DirectService.SharedKernel</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DirectService.Shared.Contracts\DirectService.Shared.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- IAppDbContext exposes EF Core types (DbSet, DatabaseFacade, IModel). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <!-- Brand fonts embedded in printed documents (UX-07, UX-23): the same files the UI serves (Shared.UI wwwroot/fonts since Stage 2
       session 16, DT-374), as data: URIs. They moved here with BrandFonts in Stage 2 session 8 with the same LogicalNames fonts/<file> (E-32, DT-325). -->
  <PropertyGroup>
    <BrandFontsDir>..\DirectService.Shared.UI\wwwroot\fonts\</BrandFontsDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(BrandFontsDir)ibm-plex-sans-arabic-*-400-normal.woff2;$(BrandFontsDir)ibm-plex-sans-arabic-*-600-normal.woff2;$(BrandFontsDir)ibm-plex-sans-arabic-*-700-normal.woff2;$(BrandFontsDir)inter-latin-400-normal.woff2;$(BrandFontsDir)inter-latin-600-normal.woff2;$(BrandFontsDir)inter-latin-700-normal.woff2" LogicalName="fonts/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
