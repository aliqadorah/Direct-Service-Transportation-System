<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DirectService.Transportation.Contracts</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="DirectService.Shared.Contracts" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\DirectService.Shared.Contracts\DirectService.Shared.Contracts.csproj" />
    <!-- Browser-safe like Shared.Contracts: the platform's problem codes and permission keys, named by ErrorCodes / PermissionKeys (Stage 2 session 13). -->
    <ProjectReference Include="..\Platform\DirectService.Platform.Contracts\DirectService.Platform.Contracts.csproj" />
    <!-- Another module's Contracts (browser-safe): the constants of AccountingErrorCodes / AccountingPermissionKeys (Stage 3 session 4a, the
         DT-310 pattern) and the accounting DTOs that transport DTOs use (accounts, entry links, parties; Stage 3 session 6, DT-407). -->
    <ProjectReference Include="..\Modules\Accounting\DirectService.Accounting.Contracts\DirectService.Accounting.Contracts.csproj" />
    <!-- Only the constants of SharedErrorCodes (compiled into this assembly as values). Private, so the browser app never receives
         SharedKernel or EF Core through the contracts (DT-288, DT-310). -->
    <ProjectReference Include="..\Shared\DirectService.SharedKernel\DirectService.SharedKernel.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
