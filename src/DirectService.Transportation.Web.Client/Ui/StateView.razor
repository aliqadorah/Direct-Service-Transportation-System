@*
  The screen-state switch every page uses: Loading → skeleton of the screen's kind; Error → error state with retry and reference;
  Empty → the screen's empty message (or the content with a first-visit note for screens that always hold data); Ready → content.
*@
@switch (State)
{
    case LoadState.Loading:
        <Skeleton Kind="Kind" />
        break;
    case LoadState.Error:
        <section class="box fill" style="display:flex"><ErrorState Title="@ErrorTitle" Text="@ErrorText" Reference="@ErrorReference" OnRetry="OnRetry" /></section>
        break;
    case LoadState.Empty when Empty is not null:
        <section class="box fill" style="display:flex">@Empty</section>
        break;
    default:
        @ChildContent
        break;
}

@code {
    [Parameter] public LoadState State { get; set; }
    [Parameter] public SkeletonKind Kind { get; set; } = SkeletonKind.List;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Empty { get; set; }
    [Parameter] public string? ErrorTitle { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string? ErrorReference { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
