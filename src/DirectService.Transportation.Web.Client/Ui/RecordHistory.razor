@*
  History of a record from the API (FR-166), readable (owner feedback 14 Oct 2026, DT-188): newest first, each event as the API's sentence in
  the reader's language with links to the documents it names, the reason, the labelled changes and a journal entry's lines; the time below.
*@
@using Md = DirectService.Transportation.Contracts.MasterData
@inject Loc L
@inject ShellState Shell
@if (Items.Count == 0)
{
    <p class="muted">@L["hist.none"]</p>
}
else
{
    <ol class="hist">
        @foreach (var h in Items)
        {
            <li class="@(h.Action is "Delete" or "Void" or "Archive" ? "v" : null)">
                <div class="ev">
                    <AuditEvent Text="@(h.Text ?? Fallback(h))" Links="h.Links" Lines="h.Lines" Reason="@h.Reason"
                                Changes="@(h.Changes.Select(c => new AuditEvent.Change(c.Field, c.OldValue, c.NewValue)).ToList())" />
                    <div class="w"><Tx Value="@Fmt.DateTime(h.At.ToLocalTime(), Shell.DateFormat)" /></div>
                </div>
            </li>
        }
    </ol>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DirectService.Shared.Contracts.History.HistoryEntry> Items { get; set; } = [];

    /// <summary>An entry without the API's sentence (an older server): "action — user".</summary>
    private string Fallback(DirectService.Shared.Contracts.History.HistoryEntry h)
    {
        var action = h.ActionLabel ?? (L["hist." + h.Action] is var t && !t.StartsWith("hist.", StringComparison.Ordinal) ? t : h.Action);
        return $"{action} — {h.User ?? L["hist.system"]}";
    }
}
