@*
  Button. Variants: default, Primary, Ghost, Danger, DangerPrimary; Small; Busy shows a spinner and blocks repeat clicks.
  Icon-only buttons must have AriaLabel. Href renders a link styled as a button.
*@
@if (Href is not null)
{
    <a class="@Css" href="@(Disabled ? null : Href)" aria-disabled="@(Disabled ? "true" : null)" aria-label="@AriaLabel" title="@Title" @attributes="Attributes">@Inner</a>
}
else
{
    <button type="@Type" class="@Css" disabled="@(Disabled || Busy)" aria-busy="@(Busy ? "true" : null)" aria-label="@AriaLabel" aria-pressed="@Pressed" aria-expanded="@Expanded"
            aria-haspopup="@HasPopup" title="@Title" @onclick="Click" @attributes="Attributes">@Inner</button>
}

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool FlipIcon { get; set; }
    [Parameter] public string? Shortcut { get; set; }
    [Parameter] public bool Primary { get; set; }
    [Parameter] public bool Ghost { get; set; }
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool DangerPrimary { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Pressed { get; set; }
    [Parameter] public string? Expanded { get; set; }
    [Parameter] public string? HasPopup { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private string Css => string.Join(' ', new[] { "btn", Primary ? "pri" : null, Ghost ? "ghost" : null, Danger ? "danger" : null, DangerPrimary ? "dangerpri" : null,
        Small ? "sm" : null, Text is null && ChildContent is null ? "icon-only" : null, Class }.Where(c => c is not null));

    private async Task Click(MouseEventArgs e)
    {
        if (Disabled || Busy) return;
        await OnClick.InvokeAsync(e);
    }

    private RenderFragment Inner => @<text>@if (Busy) {<span class="spin" aria-hidden="true"></span>} else if (Icon is not null) {<Icon Name="@Icon" Flip="FlipIcon" />}<Tx Value="@Text" />@ChildContent@if (Shortcut is not null) {<Kbd Keys="@Shortcut" />}</text>;
}
