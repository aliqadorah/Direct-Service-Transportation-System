<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>DirectService.Transportation.Web.Client</RootNamespace>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- CS8669: the Razor generator writes nullable type arguments (TValue="string?") into "#nullable disable" regions; harmless. -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
  </PropertyGroup>

  <!-- The UI references only the contracts, so it can reach the data through the REST API alone (ADR-02, step 2 §4). -->
  <ItemGroup>
    <ProjectReference Include="..\DirectService.Transportation.Contracts\DirectService.Transportation.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <!-- Brand fonts bundled locally (PRD UX-07, open issue B6): one copy in assets/fonts, served from wwwroot/fonts. -->
  <ItemGroup>
    <Content Include="..\..\assets\fonts\*.woff2" Link="wwwroot\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- The component gallery (/design, DT-140) and its sample data are not part of release builds. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Remove="Pages\DesignGallery.razor" />
    <RazorComponent Remove="Pages\DesignGallery.razor" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DirectService.Transportation.UI.Tests" />
  </ItemGroup>

</Project>
