@page "/c/{Company}/settings/invoice-layout"
@*
  SCR-74 invoice layout designer (FR-054…056): claim statement and tax invoice layouts — title, header band, grouping of the claim's first
  page (loading site / route / material), annex columns in order (the amount column is required), column labels, footer text, signature
  boxes, logo and QR; saved, then shown in the live preview with sample trips (sandboxed frame without scripts).
*@
@inject Api Api
@inject Loc L
@inject ToastService Toasts

<PageHeader Title="@L["nav.layoutDesigner"]" Crumbs="@([new Crumb(L["nav.settings"]), new Crumb(L["nav.layoutDesigner"])])">
    <Actions><Btn Primary="true" Text="@L["lay.savePreview"]" Shortcut="Ctrl S" Busy="_busy" Disabled="_layout is null" OnClick="Save" /></Actions>
</PageHeader>
<TabStrip Items="Tabs" Selected="@_type" SelectedChanged="SetType" Label="@L["nav.layoutDesigner"]" />
<StateView State="_state" Kind="SkeletonKind.Form" ErrorReference="@_reference" OnRetry="Load">
    <ChildContent>
        <div class="cols fill" style="grid-template-columns:420px 1fr;min-height:0">
            <EditForm EditContext="_ctx" OnValidSubmit="Save" class="box pad stack" style="overflow:auto">
                <ProblemValidator @ref="_problems" />
                <ErrorSummary Extra="_extra" />
                <TextField @bind-Value="_m.Title" Label="@L["lay.title"]" Required="true" MaxLength="100" />
                <TextField @bind-Value="_m.BandText" Label="@L["lay.band"]" MaxLength="200" />
                @if (_type == InvoiceCodes.Claim) {<SelectField TValue="string?" @bind-Value="_m.Grouping" Options="Groupings" Label="@L["lay.grouping"]" />}
                <fieldset class="stack" style="border:0;padding:0;margin:0;gap:4px">
                    <legend class="lbl">@L["lay.columns"]</legend>
                    @for (var i = 0; i < _m.Columns.Count; i++)
                    {
                        var col = _m.Columns[i];
                        var index = i;
                        <div class="row" style="gap:6px;align-items:center">
                            <input type="checkbox" id="@($"lay-col-{col.Key}")" checked="@col.On" disabled="@(col.Key == "amount")" @onchange="e => col.On = e.Value is true" />
                            <label for="@($"lay-col-{col.Key}")" style="min-width:110px">@ColumnName(col.Key)</label>
                            <input class="input" style="height:26px;flex:1" aria-label="@L.F("lay.labelOf", ColumnName(col.Key))" placeholder="@ColumnName(col.Key)" maxlength="60"
                                   value="@col.Label" @onchange="e => col.Label = e.Value?.ToString()" />
                            <Btn Small="true" Ghost="true" Icon="up" AriaLabel="@L.F("lay.up", ColumnName(col.Key))" Disabled="index == 0" OnClick="() => Move(index, -1)" />
                            <Btn Small="true" Ghost="true" Icon="down" AriaLabel="@L.F("lay.down", ColumnName(col.Key))" Disabled="index == _m.Columns.Count - 1" OnClick="() => Move(index, 1)" />
                        </div>
                    }
                </fieldset>
                <TextAreaField @bind-Value="_m.Footer" Label="@L["lay.footer"]" MaxLength="500" Rows="2" />
                <TextAreaField @bind-Value="_m.Signatures" Label="@L["lay.signatures"]" MaxLength="300" Rows="3" Help="@L["lay.signaturesHelp"]" />
                <CheckField @bind-Value="_m.ShowLogo" Label="@L["lay.logo"]" />
                <CheckField @bind-Value="_m.ShowQr" Label="@L["lay.qr"]" />
            </EditForm>
            <div class="box" style="display:flex;justify-content:center;background:var(--surface-sunk);padding:12px;min-height:0">
                @if (_preview is null) {<p class="muted">@L["ui.loading"]</p>}
                else
                {
                    <iframe srcdoc="@_preview" title="@L["lay.preview"]" sandbox="" style="width:min(100%,820px);height:100%;min-height:600px;border:1px solid var(--border);background:#fff"></iframe>
                }
            </div>
        </div>
    </ChildContent>
</StateView>

@code {
    private string _type = InvoiceCodes.Claim;
    private InvoiceLayoutResponse? _layout;
    private string? _preview, _reference;
    private Model _m = new();
    private EditContext _ctx = new(new Model());
    private LoadState _state = LoadState.Loading;
    private bool _busy;
    private ProblemValidator? _problems;
    private IReadOnlyList<string>? _extra;

    [Parameter] public string Company { get; set; } = "";

    private IReadOnlyList<TabItem> Tabs => [new(InvoiceCodes.Claim, L["inv.layoutClaim"]), new(InvoiceCodes.TaxInvoice, L["inv.layoutTax"])];
    private IReadOnlyList<Option<string?>> Groupings => [new("LoadingSite", L["trip.loading"]), new("Route", L["drv.route"]), new("Material", L["trip.material"])];

    private string ColumnName(string key) => L["lay.col." + key] is var t && t.StartsWith("lay.", StringComparison.Ordinal) ? key : t;

    protected override Task OnInitializedAsync() => Load();

    private Task SetType(string t) { _type = t; return Load(); }

    private async Task Load()
    {
        _state = LoadState.Loading;
        try
        {
            _layout = await Api.GetAsync<InvoiceLayoutResponse>(Api.C($"invoice-layouts/{_type}"));
            var chosen = _layout.AnnexColumns.ToList();
            _m = new Model
            {
                Title = _layout.Title, BandText = _layout.BandText, Grouping = _layout.Grouping, Footer = _layout.FooterText, Signatures = string.Join('\n', _layout.Signatures),
                ShowLogo = _layout.ShowLogo, ShowQr = _layout.ShowQr,
                // Chosen columns first in their order, then the others.
                Columns = chosen.Concat(_layout.AvailableColumns.Except(chosen)).Select(k => new ColumnModel(k)
                    { On = chosen.Contains(k) || k == "amount", Label = _layout.Labels.GetValueOrDefault(k) }).ToList(),
            };
            _ctx = new EditContext(_m);
            _state = LoadState.Ready;
            await Preview();
        }
        catch (ApiException e) { _reference = e.Problem.Reference; _state = LoadState.Error; }
    }

    private async Task Preview()
    {
        try { _preview = System.Text.Encoding.UTF8.GetString((await Api.FileAsync(Api.C($"invoice-layouts/{_type}/preview"))).Bytes); }
        catch (ApiException) { _preview = null; }
    }

    private void Move(int index, int delta)
    {
        var c = _m.Columns[index];
        _m.Columns.RemoveAt(index);
        _m.Columns.Insert(index + delta, c);
    }

    private async Task Save()
    {
        if (_layout is null) return;
        _busy = true;
        _extra = null;
        try
        {
            var labels = _m.Columns.Where(c => !string.IsNullOrWhiteSpace(c.Label)).ToDictionary(c => c.Key, c => c.Label!.Trim());
            var signatures = (_m.Signatures ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            _layout = await Api.PutAsync<InvoiceLayoutResponse>(Api.C($"invoice-layouts/{_type}"), new InvoiceLayoutRequest(_m.Title?.Trim(),
                string.IsNullOrWhiteSpace(_m.BandText) ? null : _m.BandText.Trim(), _m.Grouping, _m.Columns.Where(c => c.On).Select(c => c.Key).ToList(), labels,
                string.IsNullOrWhiteSpace(_m.Footer) ? null : _m.Footer.Trim(), signatures, _m.ShowLogo, _m.ShowQr, _layout.RowVersion));
            Toasts.Success(L["lay.saved"]);
            await Preview();
        }
        catch (ApiException e) { if (_problems?.Show(e.Problem) is { } other) _extra = [other]; }
        finally { _busy = false; }
    }

    private sealed class Model
    {
        public string? Title { get; set; }
        public string? BandText { get; set; }
        public string? Grouping { get; set; }
        public string? Footer { get; set; }
        public string? Signatures { get; set; }
        public bool ShowLogo { get; set; }
        public bool ShowQr { get; set; }
        public List<ColumnModel> Columns { get; set; } = [];
    }

    private sealed class ColumnModel(string key)
    {
        public string Key { get; } = key;
        public bool On { get; set; }
        public string? Label { get; set; }
    }
}
