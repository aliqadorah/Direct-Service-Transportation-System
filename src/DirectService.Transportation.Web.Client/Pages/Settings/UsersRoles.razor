    private async Task SetPassword()
    {
        if (_user is null || _busy) return;
        var errors = Required(("password", _set.Password, "acct.newPassword"));
        if (MissingRules(_set.Password) is { } needs) errors.Add(new ApiFieldError("password", "auth.passwordPolicy", needs));
        if (errors.Count > 0)
        {
            _setExtra = await ShowAsync(new ApiProblem { Status = 400, Errors = errors }, _setProblems, _setSummary);
            return;
        }
        _busy = true;
        _setExtra = null;
        try
        {
            await Api.PostAsync(Api.C($"users/{Uri.EscapeDataString(_user.Id)}/set-password"), new SetPasswordRequest(_set.Password!, _set.MustChangePassword));
            _settingPassword = false;
            Toasts.Success(L.F("usr.passwordSet", _user.FullName));
            await Refresh();
        }
        catch (ApiException e) { _setExtra = await ShowAsync(e.Problem, _setProblems, _setSummary); }
        finally { _busy = false; }
    }

    /// <summary>The server's username rule (3–50 characters: English letters, digits, . _ -).</summary>
    private static bool ValidUserName(string v) =>
        v.Length is >= 3 and <= 50 && v.All(ch => ch is (>= 'a' and <= 'z') or (>= 'A' and <= 'Z') or (>= '0' and <= '9') or '.' or '_' or '-');

    /// <summary>A plain shape check (the server checks the address fully): no spaces, something@domain.tld.</summary>
    private static bool ValidEmail(string v)
    {
        var at = v.IndexOf('@', StringComparison.Ordinal);
        return !v.Contains(' ', StringComparison.Ordinal) && at > 0 && v.IndexOf('.', at) > at + 1 && !v.EndsWith('.');
    }

