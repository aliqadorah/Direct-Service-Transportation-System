    /// <summary>Shows a client or server problem on the fields of a form; what has no field goes to the summary.</summary>
    private static async Task<IReadOnlyList<string>?> ShowAsync(ApiProblem problem, ProblemValidator? problems, ErrorSummary? summary)
    {
        var other = problems?.Show(problem);
        if (summary is not null) await summary.FocusAsync();
        return other is null ? null : [other];
    }

    /// <summary>"… is required" on each empty field.</summary>
    private List<ApiFieldError> Required(params (string Field, string? Value, string LabelKey)[] fields) =>
        fields.Where(f => string.IsNullOrWhiteSpace(f.Value)).Select(f => new ApiFieldError(f.Field, "validation.required", L.F("ui.requiredField", L[f.LabelKey]))).ToList();

    /// <summary>The password rules still missing, in the reader's language (null when the policy is met or not loaded).</summary>
    private string? MissingRules(string? password)
    {
        if (_policy is null || string.IsNullOrEmpty(password)) return null;
        var missing = PasswordRules.Missing(_policy, password).Select(r => r switch
        {
            PasswordRules.Rule.Length => L.F("usr.ruleLength", _policy.MinLength),
            PasswordRules.Rule.Letter => L["usr.ruleLetter"],
            _ => L["usr.ruleDigit"],
        }).ToList();
        return missing.Count == 0 ? null : L.F("usr.passwordNeeds", string.Join(L.Language == "ar" ? "، " : "; ", missing));
    }

    private async Task CreateUser()
    {
        if (_busy) return;
        // Client checks first (the same rules as the server), each on its field.
        var errors = Required(("fullName", _new.FullName, "md.fullName"), ("userName", _new.UserName, "usr.userName"),
            ("password", _new.Password, "acct.password"), ("role", _new.Role, "usr.role"));
        if (!string.IsNullOrWhiteSpace(_new.UserName) && !ValidUserName(_new.UserName.Trim()))
            errors.Add(new ApiFieldError("userName", "user.userNameFormat", L["usr.userNameFormat"]));
        if (!string.IsNullOrWhiteSpace(_new.Email) && !ValidEmail(_new.Email.Trim()))
            errors.Add(new ApiFieldError("email", "validation.format", L["usr.emailFormat"]));
        if (MissingRules(_new.Password) is { } needs) errors.Add(new ApiFieldError("password", "auth.passwordPolicy", needs));
        if (errors.Count > 0)
        {
            _newExtra = await ShowAsync(new ApiProblem { Status = 400, Errors = errors }, _newProblems, _newSummary);
            return;
        }
        _busy = true;
        _newExtra = null;
        try
        {
            await Api.PostAsync<UserListItem>(Api.C("users"), new CreateUserRequest(_new.FullName!.Trim(), _new.UserName!.Trim(),
                string.IsNullOrWhiteSpace(_new.Email) ? null : _new.Email.Trim(), _new.Password!, _new.Role!, _new.MustChangePassword));
            _inviting = false;
            Toasts.Success(L.F("usr.created", _new.UserName ?? ""));
            _tab = "users";
            await Load();
        }
        catch (ApiException e) { _newExtra = await ShowAsync(e.Problem, _newProblems, _newSummary); }
        finally { _busy = false; }
    }

