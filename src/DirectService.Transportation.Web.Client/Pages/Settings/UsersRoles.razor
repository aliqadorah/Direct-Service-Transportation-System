        if (_busy) return;
        var errors = Required(("email", _inv.Email, "acct.email"), ("role", _inv.Role, "usr.role"));
        if (!string.IsNullOrWhiteSpace(_inv.Email) && !ValidEmail(_inv.Email.Trim()))
            errors.Add(new ApiFieldError("email", "validation.format", L["usr.emailFormat"]));
        if (errors.Count > 0)
        {
            _invExtra = await ShowAsync(new ApiProblem { Status = 400, Errors = errors }, _invProblems, _invSummary);
            return;
        }
        _busy = true;
        _invExtra = null;
        try
        {
            await Api.PostAsync<InvitationResponse>(Api.C("invitations"), new InviteRequest(_inv.Email!.Trim(), _inv.Role!));
            _inviting = false;
            Toasts.Success(L.F("usr.invited", _inv.Email));
            _tab = "invitations";
            await Load();
        }
        catch (ApiException e) { _invExtra = await ShowAsync(e.Problem, _invProblems, _invSummary); }
        finally { _busy = false; }
    }

