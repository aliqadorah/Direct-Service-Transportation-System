@page "/console/support-access"
@*
  SCR-92 provider console: support access (D-13, BR-014, P-13): the staff member's requests and windows; a new request names the tenant and
  the reason and notifies its Owners, who approve a time-limited window. Inside an approved, current window the tenant's active companies
  open read-only (view permissions only, writes and exports refused, every request in the tenant's audit log — DT-152).
*@
@inject Api Api
@inject Loc L
@inject ShellState Shell
@inject ToastService Toasts

<PageHeader Title="@L["nav.supportAccess"]" Crumbs="@([new Crumb(L["shell.console"]), new Crumb(L["nav.supportAccess"])])">
    <Actions><Btn Primary="true" Icon="shield" Text="@L["con.requestSupport"]" OnClick="New" /></Actions>
</PageHeader>
<StateView State="_state" ErrorReference="@_reference" OnRetry="Load">
    <Empty>
        <EmptyState Icon="shield" Title="@L["ten.noSupport"]" Text="@L["con.noSupportText"]">
            <Actions><Btn Primary="true" Text="@L["con.requestSupport"]" OnClick="New" /></Actions>
        </EmptyState>
    </Empty>
    <ChildContent>
        @if (_open.Count > 0)
        {
            <Box Title="@L["con.openNow"]">
                <p class="muted" style="margin:0 0 8px">@L["con.openNowHelp"]</p>
                <div class="row" style="gap:8px;flex-wrap:wrap">
                    @foreach (var c in _open)
                    {
                        <Btn Small="true" Primary="true" Icon="eye" Text="@L.Pick(c.Name, c.NameEn ?? c.Name)" Href="@NavModel.Href(c.Id, "")" />
                    }
                </div>
            </Box>
        }
        <ListFrame Label="@L["nav.supportAccess"]">
            <DataGrid TItem="SupportAccessResponse" Items="_rows" Key="r => r.Id" Caption="@L["nav.supportAccess"]">
                <Columns>
                    <GridColumn TItem="SupportAccessResponse" Title="@L["con.tenant"]" Value="r => Subscriber(r)" />
                    <GridColumn TItem="SupportAccessResponse" Title="@L["ten.reason"]" Value="r => r.Reason" />
                    <GridColumn TItem="SupportAccessResponse" Title="@L["ten.from"]" Value="r => Fmt.DateTime(r.StartsAt?.ToLocalTime(), Shell.DateFormat)" Ltr="true" />
                    <GridColumn TItem="SupportAccessResponse" Title="@L["ten.to"]" Value="r => Fmt.DateTime(r.EndsAt?.ToLocalTime(), Shell.DateFormat)" Ltr="true" />
                    <GridColumn TItem="SupportAccessResponse" Title="@L["ten.decidedBy"]" Value="@(r => r.DecidedBy ?? "—")" />
                    <GridColumn TItem="SupportAccessResponse" Title="@L["ml.status"]"><Template><StatusTag Status="@SupportApprovals.Status(context)" />@if (context.EndedBy is not null) {<div class="muted small">@L.F("con.endedByAt", context.EndedBy, Fmt.DateTime(context.EndsAt?.ToLocalTime(), Shell.DateFormat))</div>}</Template></GridColumn>
                    <GridColumn TItem="SupportAccessResponse" Title="@L["ten.refusal"]" Value="@(r => r.DecisionReason ?? "")" />
                </Columns>
            </DataGrid>
        </ListFrame>
    </ChildContent>
</StateView>

<Modal @bind-Open="_requesting" Title="@L["con.requestSupport"]" Busy="_busy" Icon="shield">
    <ChildContent>
        @*
          One searchable field (owner testing 19 Oct 2026, DT-214): subscriber name, owner email or any user's email. Each entry reads
          "name · owner email · plan · signed up", so two subscribers with the same name are told apart; the chosen one is shown again below.
        *@
        <ComboField TValue="string?" @bind-Value="_tenant" OnSelected="Choose" SearchAsync="SearchTenants" Selected="_option"
                    Label="@L["con.subscriber"]" Placeholder="@L["con.findSubscriber"]" Help="@L["con.findSubscriberHelp"]" Required="true" MaxShown="20"
                    Id="support-tenant" />
        @if (_chosen is { } t)
        {
            <div class="chosen-tenant" data-testid="chosen-tenant">
                <p class="muted" style="margin:0 0 4px">@L["con.chosenSubscriber"]</p>
                <KeyValues Columns="2" Items="@Details(t)" />
            </div>
        }
        <TextAreaField @bind-Value="_reason" Label="@L["ui.reason"]" Required="true" MaxLength="500" Rows="2" BindOnInput="true" />
        <p class="help" style="margin:0">@L["con.supportText"]</p>
        @if (_error is not null) {<Banner Tone="Tone.Err" Text="@_error" Live="true" />}
    </ChildContent>
    <Footer>
        <Btn Text="@L["ui.cancel"]" OnClick="() => _requesting = false" />
        <Btn Primary="true" Icon="send" Text="@L["con.sendRequest"]" Busy="_busy" Disabled="@(!CanSend)" OnClick="Request" />
    </Footer>
</Modal>

@code {
    private IReadOnlyList<SupportAccessResponse> _rows = [];
    private IReadOnlyList<CompanyAccess> _open = [];
    private readonly Dictionary<string, SupportTenantOption> _found = new(StringComparer.Ordinal);
    private LoadState _state = LoadState.Loading;
    private string? _reference, _tenant, _reason, _error;
    private SupportTenantOption? _chosen;
    private Option<string?>? _option;
    private bool _requesting, _busy;

    /// <summary>A request is sent only for one subscriber picked from the results and shown again — never for typed text or an unclear choice.</summary>
    private bool CanSend => _chosen is not null && _tenant == _chosen.Id && !string.IsNullOrWhiteSpace(_reason);

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        try
        {
            _rows = await Api.GetAsync<IReadOnlyList<SupportAccessResponse>>("api/v1/platform/support-access");
            _open = await Api.GetAsync<IReadOnlyList<CompanyAccess>>("api/v1/platform/support-access/companies");
            _state = _rows.Count == 0 ? LoadState.Empty : LoadState.Ready;
        }
        catch (ApiException e) { _reference = e.Problem.Reference; _state = LoadState.Error; }
    }

    private Task New()
    {
        _tenant = _reason = _error = null;
        _chosen = null;
        _option = null;
        _found.Clear();
        _requesting = true;
        return Task.CompletedTask;
    }

    /// <summary>A request's subscriber as "name · owner email", so two subscribers with the same name are told apart in the list (DT-219).</summary>
    internal static string Subscriber(SupportAccessResponse r) => r.OwnerEmail is null ? r.Tenant : $"{r.Tenant} · {r.OwnerEmail}";

    /// <summary>The text of one result: name · owner email · plan · signed-up date; a match through another user's email is named below it.</summary>
    internal string Text(SupportTenantOption t) =>
        string.Join(" · ", t.Name, t.OwnerEmail ?? L["con.noOwner"], t.PlanName, Fmt.Date(t.SignedUpAt.ToLocalTime(), Shell.DateFormat));

    private async Task<IReadOnlyList<Option<string?>>> SearchTenants(string text, CancellationToken ct)
    {
        try
        {
            var q = string.IsNullOrWhiteSpace(text) ? "" : "?q=" + Uri.EscapeDataString(text.Trim());
            var found = await Api.GetAsync<IReadOnlyList<SupportTenantOption>>("api/v1/platform/support-access/tenants" + q, ct);
            foreach (var t in found) _found[t.Id] = t;
            return found.Select(t => new Option<string?>(t.Id, Text(t), t.MatchedEmail is null ? null : L.F("con.matchedBy", t.MatchedEmail))).ToList();
        }
        catch (ApiException e)
        {
            _error = e.Problem.Detail ?? L["ui.loadFailed"];
            return [];
        }
    }

    private void Choose(Option<string?>? picked)
    {
        var token = picked?.Value;
        _chosen = token is not null && _found.TryGetValue(token, out var t) ? t : null;
        _option = _chosen is null ? null : new Option<string?>(_chosen.Id, Text(_chosen));
        _error = null;
    }

    private IReadOnlyList<KeyValue> Details(SupportTenantOption t)
    {
        var items = new List<KeyValue>
        {
            new(L["con.subscriber"], t.Name),
            new(L["con.owner"], t.OwnerEmail ?? L["con.noOwner"]),
            new(L["con.plan"], $"{t.PlanName} ({t.PlanCode})"),
            new(L["con.signedUp"], Fmt.Date(t.SignedUpAt.ToLocalTime(), Shell.DateFormat)),
            new(L["ml.status"], L["st." + SubscriberStatus(t.Status)]),
        };
        if (t.MatchedEmail is not null) items.Add(new(L["con.matchedEmail"], t.MatchedEmail));
        return items;
    }

    internal static string SubscriberStatus(string status) => status switch
    {
        "Trial" => "trial", "Active" => "active", "PastDue" => "pastDue", "Suspended" => "suspended", "Cancelled" => "cancelled", _ => "deleted",
    };

    private async Task Request()
    {
        if (!CanSend) return;
        _busy = true;
        _error = null;
        try
        {
            await Api.PostAsync<SupportAccessResponse>("api/v1/platform/support-access", new SupportAccessRequest(_tenant, _reason));
            _requesting = false;
            Toasts.Success(L["con.done.support"]);
            await Load();
        }
        catch (ApiException e) { _error = e.Problem.Detail ?? L["ui.loadFailed"]; }
        finally { _busy = false; }
    }
}
