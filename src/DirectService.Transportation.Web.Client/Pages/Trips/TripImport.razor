@page "/c/{Company}/trips/import"
@*
  SCR-12 trip import (US-02, FR-013, FR-033, DT-72): Excel / CSV / TSV file; mode strict (any rejected row blocks) or tolerant (optional
  values take defaults and the row is flagged "Needs review"); automatic column matching with Arabic header alternatives and an editable
  mapping; preview with rejected, duplicate and review rows; import with the batch result (import log).
*@
@using System.Text.Json
@using DirectService.Transportation.Contracts.Trips
@using DirectService.Transportation.Contracts.Accounting
@inject Api Api
@inject Loc L
@inject ToastService Toasts

<PageHeader Title="@L["nav.tripImport"]" Crumbs="@([new Crumb(L["nav.operations"]), new Crumb(L["nav.trips"], NavModel.Href(Company, "trips"))])" />

<ol class="row" style="list-style:none;margin:0;padding:0;gap:6px;flex:none" aria-label="@L["imp.steps"]">
    @foreach (var (n, key) in new[] { (1, "imp.file"), (2, "imp.columns"), (3, "imp.preview"), (4, "imp.import") })
    {
        var cur = n == Step;
        <li><span class="chip" aria-current="@(cur ? "step" : null)" style="@(cur ? "background:var(--tint);border-color:var(--primary);font-weight:600" : null)"><bdi class="num">@n</bdi> @L[key]</span></li>
    }
</ol>

<div class="cols" style="grid-template-columns:1fr 340px;align-items:start">
    <Box Title="@L["imp.file"]">
        <div class="field">
            <label for="trip-file">@L["imp.choose"]</label>
            <InputFile id="trip-file" class="input" style="padding-top:4px" accept=".xlsx,.csv,.tsv,.txt" OnChange="Picked" />
            <span class="help">@L["imp.help"]</span>
        </div>
        @if (_fileName is not null) {<p style="margin-top:8px"><Icon Name="file" /> <bdi class="num">@_fileName</bdi></p>}
    </Box>
    <Box Title="@L["trip.importMode"]">
        <fieldset style="border:0;padding:0;margin:0" class="stack">
            <legend class="sr-only">@L["trip.importMode"]</legend>
            <label class="chk"><input type="radio" name="mode" checked="@(_mode == "strict")" @onchange="@(() => Mode("strict"))" /> @L["trip.strict"]</label>
            <label class="chk"><input type="radio" name="mode" checked="@(_mode == "tolerant")" @onchange="@(() => Mode("tolerant"))" /> @L["trip.tolerant"]</label>
            <p class="help">@L["trip.importHelp"]</p>
        </fieldset>
    </Box>
</div>

@if (_error is not null) {<Banner Tone="Tone.Err" Text="@_error" />}

@if (_preview is not null)
{
    <Box Title="@L.F("trip.matched", _preview.Columns.Matched.Count)">
        <Actions><Btn Small="true" Icon="refresh" Text="@L["imp.preview"]" Busy="_busy" OnClick="Preview" /></Actions>
        <ChildContent>
            <div class="fg" style="grid-template-columns:repeat(4,minmax(0,1fr))">
                @foreach (var (field, header) in _mapping.OrderBy(x => x.Key))
                {
                    var key = field;
                    <div class="field">
                        <label for="map-@key"><bdi class="num">@key</bdi></label>
                        <select id="map-@key" class="input" value="@header" @onchange="e => Map(key, e.Value?.ToString())">
                            <option value="">@L["trip.notImported"]</option>
                            @foreach (var h in Headers) {<option value="@h">@h</option>}
                        </select>
                    </div>
                }
            </div>
        </ChildContent>
    </Box>
    <Figures Items="@([new Figure(L["imp.total"], Fmt.Count(_preview.TotalRows)), new Figure(L["imp.valid"], Fmt.Count(_preview.ValidRows)), new Figure(L["st.review"], Fmt.Count(_preview.ReviewRows), L["trip.defaults"]), new Figure(L["imp.rejected"], Fmt.Count(_preview.RejectedRows)), new Figure(L["trip.duplicates"], Fmt.Count(_preview.DuplicateRows))])" />
    <div class="formbar">
        @if (_preview.Mode == "Strict" && _preview.RejectedRows > 0) {<Banner Tone="Tone.Warn" Text="@L["imp.fixFirst"]" />}
        <Btn Primary="true" Icon="import" Busy="_busy" Disabled="@(_preview.ValidRows == 0 || (_preview.Mode == "Strict" && _preview.RejectedRows > 0))"
             Text="@L.F("trip.importValid", _preview.ValidRows)" OnClick="Import" />
    </div>
    <ListFrame Label="@L["imp.rows"]">
        <DataGrid TItem="ImportRowResult" Items="Rows" Key="r => r.Row" Caption="@L["imp.rows"]" RowClass="@(r => r.Problems.Count > 0 ? "sel" : null)">
            <Columns>
                <GridColumn TItem="ImportRowResult" Title="@L["imp.row"]" Value="r => Fmt.Count(r.Row)" Numeric="true" Width="70px" />
                <GridColumn TItem="ImportRowResult" Title="@L["trip.receiptNo"]" Value="r => r.Key" Ltr="true" />
                <GridColumn TItem="ImportRowResult" Title="@L["imp.problems"]" Wrap="true">
                    <Template>@if (context.Problems.Count == 0) {<StatusTag Status="approved" />} else {<ul style="margin:0;padding-inline-start:16px">@foreach (var p in context.Problems) {<li><Tx Value="@p" /></li>}</ul>}</Template>
                </GridColumn>
            </Columns>
        </DataGrid>
    </ListFrame>
}

<Modal Open="_result is not null" OpenChanged="_ => _result = null" Title="@L["trip.importDone"]" Icon="check">
    <ChildContent>
        @if (_result is not null)
        {
            <KeyValues Columns="2" Items="@([new KeyValue(L["trip.imported"], Fmt.Count(_result.ImportedRows)), new KeyValue(L["st.review"], Fmt.Count(_result.ReviewRows)), new KeyValue(L["imp.rejected"], Fmt.Count(_result.RejectedRows)), new KeyValue(L["trip.batch"], _result.BatchId)])" />
            <p class="help">@L["trip.importLogged"]</p>
        }
    </ChildContent>
    <Footer><Btn Primary="true" Text="@L["trip.created"]" Href="@NavModel.Href(Company, "trips/list")" /></Footer>
</Modal>

@code {
    private string _mode = "tolerant";
    private string? _fileName, _error;
    private byte[]? _bytes;
    private TripImportPreview? _preview;
    private TripImportResult? _result;
    private Dictionary<string, string> _mapping = new(StringComparer.Ordinal);
    private bool _busy;

    [Parameter] public string Company { get; set; } = "";

    private int Step => _result is not null ? 4 : _preview is not null ? 3 : _fileName is not null ? 2 : 1;

    private IReadOnlyList<string> Headers => _preview is null ? [] : _preview.Columns.Matched.Values.Concat(_preview.Columns.Unused).Distinct().OrderBy(h => h).ToList();

    private IReadOnlyList<ImportRowResult> Rows => _preview!.Rows.OrderBy(r => r.Problems.Count == 0).ThenBy(r => r.Row).ToList();

    private async Task Picked(InputFileChangeEventArgs e)
    {
        _error = null;
        _preview = null;
        _mapping.Clear();
        try
        {
            await using var s = e.File.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            _bytes = ms.ToArray();
            _fileName = e.File.Name;
            await Preview();
        }
        catch (IOException) { _error = L["imp.tooLarge"]; _fileName = null; }
    }

    private async Task Mode(string mode)
    {
        _mode = mode;
        if (_bytes is not null) await Preview();
    }

    private void Map(string field, string? header)
    {
        if (string.IsNullOrEmpty(header)) _mapping.Remove(field); else _mapping[field] = header;
    }

    private Dictionary<string, string> Fields => new() { ["mode"] = _mode, ["mapping"] = _mapping.Count == 0 ? "" : JsonSerializer.Serialize(_mapping) };

    private async Task Preview()
    {
        if (_bytes is null || _fileName is null) return;
        _busy = true;
        _error = null;
        try
        {
            _preview = await Api.UploadAsync<TripImportPreview>(Api.C("trips/import/preview"), new MemoryStream(_bytes), _fileName, Fields);
            foreach (var (k, v) in _preview.Columns.Matched) _mapping.TryAdd(k, v);
        }
        catch (ApiException e) { _error = e.Problem.Detail; _preview = null; }
        finally { _busy = false; }
    }

    private async Task Import()
    {
        if (_bytes is null || _fileName is null) return;
        _busy = true;
        try
        {
            _result = await Api.UploadAsync<TripImportResult>(Api.C("trips/import"), new MemoryStream(_bytes), _fileName, Fields);
            Toasts.Success(L.F("imp.done", _result.ImportedRows));
            _preview = null;
        }
        catch (ApiException e) { _error = e.Problem.Detail; }
        finally { _busy = false; }
    }
}
