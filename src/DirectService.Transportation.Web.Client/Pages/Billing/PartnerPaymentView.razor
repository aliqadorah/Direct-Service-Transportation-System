@page "/c/{Company}/partner-accounts/payments/{Id}"
@* SCR-28 partner payment view (FR-085…087): partner, date, method, account, reference, amount in words; print the voucher, void (drv.settle). *@
@inject Api Api
@inject Loc L
@inject ShellState Shell
@inject ToastService Toasts

<StateView State="_state" Kind="SkeletonKind.Detail" ErrorReference="@_reference" OnRetry="Load">
    <Empty><NotFoundView /></Empty>
    <ChildContent>
        @{ var p = _d!.Payment; }
        <CashDocView Title="@p.Number" Crumbs="@([new Crumb(L["nav.billing"]), new Crumb(L["nav.partnerAccounts"], NavModel.Href(Company, "partner-accounts")), new Crumb(p.Partner.Name, NavModel.Href(Company, $"partner-accounts/{p.Partner.Id}"))])"
                     IsVoid="@(p.Status == "Void")" VoidReason="@p.VoidReason" PostingPending="p.PostingPending" Details="Details(p)" Amount="p.Amount" AmountLabel="@L["inv.amount"]"
                     AmountInWords="@_d.AmountInWords" Entry="p.JournalEntry" History="_d.History" PrintHref="@NavModel.Href(Company, $"print/partner-payment/{Id}")"
                     CanVoid="@Shell.Can(PermissionKeys.DrvSettle)" VoidText="@(ForTrip is null ? L["prt.voidText"] : L["prt.voidNotPaidText"])" OnVoid="Void"
                     StartVoid="@(StartVoid == "1" && ForTrip is not null)">
            @* DT-230 (c): from a paid partner trip — the payment was not actually made; voided for that trip (recorded with it). *@
            <Above>@if (ForTrip is not null && p.Status != "Void") {<Banner Tone="Tone.Warn" Icon="alert" Text="@L["prt.voidNotPaidBanner"]" />}
                else if (ForTrip is not null) {<Banner Tone="Tone.Ok"><span>@L["prt.voidNotPaidDone"] <a href="@NavModel.Href(Company, $"trips/{Uri.EscapeDataString(ForTrip)}")">@L["prt.backToTrip"]</a></span></Banner>}</Above>
            <ChildContent>
                @* DT-277: the previous balance from manual / opening entries settled with this payment. *@
                @if (p.PreviousBalance != 0)
                {
                    <PreviousBalancePanel Company="@Company" Name="@p.Partner.Name" Amount="p.PreviousBalance" Entries="@(_d.PreviousBalanceEntries ?? [])" Partner="true" Settled="true" />
                }
            </ChildContent>
        </CashDocView>
    </ChildContent>
</StateView>

@code {
    private PartnerPaymentDetails? _d;
    private LoadState _state = LoadState.Loading;
    private string? _reference;

    [Parameter] public string Company { get; set; } = "";
    [Parameter] public string Id { get; set; } = "";
    [SupplyParameterFromQuery(Name = "void")] public string? StartVoid { get; set; }
    [SupplyParameterFromQuery(Name = "trip")] public string? ForTrip { get; set; }

    protected override Task OnParametersSetAsync() => Load();

    private async Task Load()
    {
        try
        {
            _d = await Api.GetAsync<PartnerPaymentDetails>(Api.C($"partner-payments/{Uri.EscapeDataString(Id)}"));
            _state = LoadState.Ready;
        }
        catch (ApiException e) when (e.Problem.Status == 404) { _state = LoadState.Empty; }
        catch (ApiException e) { _reference = e.Problem.Reference; _state = LoadState.Error; }
    }

    private IReadOnlyList<KeyValue> Details(PartnerPaymentResponse p) =>
    [
        new(L["md.partner"], null, @<a href="@NavModel.Href(Company, $"partner-accounts/{p.Partner.Id}")">@p.Partner.Name</a>),
        new(L["trip.date"], Fmt.Date(p.PaymentDate, Shell.DateFormat)),
        new(L["prt.kind"], L["prt.kind." + p.Kind]),   // DT-228: payment to the partner or repayment from it
        .. (p.DeductedAmount > 0 ? new KeyValue[] { new(L["prt.deducted"], Fmt.Money(p.DeductedAmount)), new(L["prt.dueBeforeDeduction"], Fmt.Money(p.Amount + p.DeductedAmount)) } : []),
        // DT-277: the previous balance settled with it and what it paid (or brought back) for the partner's trips.
        .. (p.PreviousBalance != 0 ? new KeyValue[]
        {
            new(L["pb.tab"], Fmt.Money(Math.Abs(p.PreviousBalance)) + " · " + L[p.PreviousBalance > 0 ? "pb.owedToPartner" : "pb.owesCompany"]),
            new(L["prt.forTrips"], Fmt.Money(p.Kind == CashCodes.Repayment ? p.Amount + p.PreviousBalance : p.Amount - p.PreviousBalance)),
        } : []),
        new(L["cash.method"], L["pay." + p.PaymentMethod]),
        new(L["cash.account"], p.Account.Name),
        new(L["cash.reference"], p.Reference),
        new(L["md.notes"], p.Notes),
    ];

    private async Task<string?> Void(string reason)
    {
        try
        {
            await Api.PostAsync<PartnerPaymentDetails>(Api.C($"partner-payments/{Uri.EscapeDataString(Id)}/void"), new CashVoidRequest(reason, _d!.Payment.RowVersion, ForTrip));
            Toasts.Success(L.F("cash.voided", _d.Payment.Number));
            await Load();
            return null;
        }
        catch (ApiException e) { return e.Problem.Detail ?? L["ui.loadFailed"]; }
    }
}
