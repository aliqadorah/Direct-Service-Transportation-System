@page "/c/{Company}/driver-accounts/advances"
@* Advances register (FR-074, RPT-21): views All / Open / Settled / Void, driver, period and method filters, number search, total of active advances, Excel/CSV. *@
@inject Api Api
@inject Loc L
@inject ShellState Shell
@inject TripLookups Lookups
@inject Downloads Files
@inject NavigationManager Nav

<LiveRefresh EntityTypes="@(["TRN.Advance"])" OnChange="Load" />
<PageHeader Help="driver-accounts" Title="@L["drv.advancesList"]" Crumbs="@([new Crumb(L["nav.billing"]), new Crumb(L["nav.driverAccounts"], NavModel.Href(Company, "driver-accounts")), new Crumb(L["drv.advancesList"])])">
    <Actions>@if (Shell.Can(PermissionKeys.DrvAdvance)) {<Btn Primary="true" Icon="plus" Text="@L["drv.newAdvance"]" Href="@NavModel.Href(Company, "driver-accounts/advances/new")" />}</Actions>
</PageHeader>
<ListShell Label="@L["drv.advancesList"]" Views="Views" View="@_view" ViewChanged="SetView" Search="@_q.Q" OnSearch="Search" Exports="@(["xlsx", "csv", "pdf"])" OnExport="Export"
           State="_state" Reference="@_reference" OnRetry="Load" EmptyIcon="cash" EmptyTitle="@L["drv.noAdvances"]" Filtered="Filtered" OnClear="ClearAll"
           Page="_q.Page" PageSize="_q.PageSize" Total="_page?.Page.TotalCount" OnPage="Go" OnPageSize="Size">
    <Filters>
        <ComboField TValue="string?" @bind-Value="_driver" SearchAsync="Lookups.SearchDriversAsync" Label="@L["trip.driver"]" Placeholder="@L["tar.all"]" FieldClass="w220" />
        <DateField @bind-Value="_from" Label="@L["trip.from"]" FieldClass="w160" />
        <DateField @bind-Value="_to" Label="@L["trip.to"]" FieldClass="w160" />
        <SelectField TValue="string?" @bind-Value="_method" Options="MoneyAccounts.Methods(L)" Empty="@L["tar.all"]" Label="@L["cash.method"]" FieldClass="w160" />
        <Btn Icon="filter" Text="@L["trip.apply"]" OnClick="Apply" />
        @if (Filtered) {<Btn Ghost="true" Text="@L["ui.clear"]" OnClick="ClearAll" />}
    </Filters>
    <ChildContent>
        <DataGrid TItem="AdvanceResponse" Items="_page!.Page.Items" Key="a => a.Id" Caption="@L["drv.advancesList"]" SortKey="@_q.Sort" SortDesc="_q.Desc" OnSort="Sort"
                  OnRowClick="@(a => Nav.NavigateTo(NavModel.Href(Company, $"driver-accounts/advances/{a.Id}")))" RowClass="@(a => a.Status == "Void" ? "void" : null)"
                  FooterLabel="@L.F("rcpt.totalOf", Fmt.Count(_page.Totals.Included))">
            <Columns>
                <GridColumn TItem="AdvanceResponse" Title="@L["doc.number"]" Value="a => a.Number" Ltr="true" SortKey="number" />
                <GridColumn TItem="AdvanceResponse" Title="@L["trip.date"]" Value="a => Fmt.Date(a.AdvanceDate, Shell.DateFormat)" Ltr="true" SortKey="advanceDate" />
                <GridColumn TItem="AdvanceResponse" Title="@L["trip.driver"]" Value="a => a.Driver.Name" Clip="true" SortKey="driver" />
                <GridColumn TItem="AdvanceResponse" Title="@L["cash.method"]" Value="@(a => L["pay." + a.PaymentMethod])" />
                <GridColumn TItem="AdvanceResponse" Title="@L["cash.account"]" Value="a => a.Account.Name" Clip="true" />
                <GridColumn TItem="AdvanceResponse" Title="@L["drv.settlement"]" Value="a => a.Settlement?.Number" Ltr="true" />
                <GridColumn TItem="AdvanceResponse" Title="@L["inv.amount"]" Value="a => Fmt.Money(a.Amount)" Numeric="true" SortKey="amount" Footer="@Fmt.Money(_page.Totals.Amount)" />
                <GridColumn TItem="AdvanceResponse" Title="@L["ml.status"]"><Template><StatusTag Status="@(context.Status == "Void" ? "void" : context.Settlement is null ? "open" : "settled")" /></Template></GridColumn>
            </Columns>
        </DataGrid>
    </ChildContent>
</ListShell>

@code {
    private readonly ListQuery _q = new() { Sort = "advanceDate", Desc = true };
    private AdvancePage? _page;
    private LoadState _state = LoadState.Loading;
    private string? _reference, _driver, _method;
    private string _view = "all";
    private DateOnly? _from, _to;

    [Parameter] public string Company { get; set; } = "";

    private IReadOnlyList<TabItem> Views => [new("all", L["ml.all"]), new("open", L["st.open"]), new("settled", L["st.settled"]), new("void", L["st.void"])];
    private bool Filtered => _q.Q is not null || _driver is not null || _method is not null || _from is not null || _to is not null;

    protected override Task OnInitializedAsync()
    {
        var query = ListUrl.Read(Nav);
        _q.ReadInto(query);
        if (query["view"] is { Length: > 0 } view) _view = view;
        if (query["driver"] is { Length: > 0 } driver) _driver = driver;
        if (query["method"] is { Length: > 0 } method) _method = method;
        _from = ListUrl.Date(query["from"]);
        _to = ListUrl.Date(query["to"]);
        return Load();
    }

    private string Query(bool paged)
    {
        var q = new ListQuery { Q = _q.Q, Sort = _q.Sort, Desc = _q.Desc, Page = _q.Page, PageSize = _q.PageSize };
        void Set(string k, string? v) { if (v is not null) q.Fixed[k] = v; }
        Set("settled", _view switch { "open" => "no", "settled" => "yes", _ => null });
        Set("status", _view switch { "void" => "void", "all" => "all", _ => "active" });
        Set("driver", _driver);
        Set("method", _method);
        Set("from", _from?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
        Set("to", _to?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
        return q.ToQuery(statusParam: null, paged);
    }

    private async Task Load()
    {
        ListUrl.Write(Nav, _q, ("view", _view == "all" ? null : _view), ("driver", _driver), ("method", _method), ("from", ListUrl.Date(_from)), ("to", ListUrl.Date(_to)));
        try
        {
            _page = await Api.GetAsync<AdvancePage>(Api.C("advances" + Query(true)));
            _state = _page.Page.Items.Count == 0 && _q.Page == 1 ? LoadState.Empty : LoadState.Ready;
        }
        catch (ApiException e) { _reference = e.Problem.Reference; _state = LoadState.Error; }
    }

    private Task SetView(string v) { _view = v; _q.Page = 1; return Load(); }
    private Task Search(string? text) { _q.Q = text; _q.Page = 1; return Load(); }
    private Task Apply() { _q.Page = 1; return Load(); }
    private Task Sort((string Key, bool Desc) s) { _q.SetSort(s); return Load(); }
    private Task Go(int p) { _q.Page = p; return Load(); }
    private Task Size(int s) { _q.PageSize = s; _q.Page = 1; return Load(); }
    private Task ClearAll() { _q.Q = _driver = _method = null; _from = _to = null; _q.Page = 1; return Load(); }
    private Task Export(string format) => Files.SaveAsync(Api.C("advances/export" + Query(false)), format);
}
