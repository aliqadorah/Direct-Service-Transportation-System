@page "/c/{Company}/partner-accounts"
@* SCR-28 partner accounts — entry list (FR-084): cost of partner trips, payments and balance due per partner as of a date (RPT-20); a row opens the account. *@
@using DirectService.Transportation.Contracts.Reports
@inject Api Api
@inject Loc L
@inject TripLookups Lookups
@inject Downloads Files
@inject NavigationManager Nav

<PageHeader Help="partner-payments" Title="@L["nav.partnerAccounts"]" Crumbs="@([new Crumb(L["nav.billing"]), new Crumb(L["nav.partnerAccounts"])])">
    <Actions><Btn Icon="file" Text="@L["prt.paymentsList"]" Href="@NavModel.Href(Company, "partner-accounts/payments")" /></Actions>
</PageHeader>
<div class="row" style="flex-wrap:wrap;gap:8px;align-items:flex-end;flex:none">
    <ComboField TValue="string?" @bind-Value="_partner" Options="Lookups.Partners" Label="@L["prt.openAccount"]" FieldClass="w260"
                OnSelected="@(o => { if (o?.Value is { } id) Nav.NavigateTo(NavModel.Href(Company, $"partner-accounts/{id}")); })" />
    <DateField @bind-Value="_asOf" Label="@L["rep.asOf"]" FieldClass="w160" @bind-Value:after="Load" />
    @* DT-278: owed to the partner, owes the company, or all (the accounting dashboard links here with ?side=). *@
    <SelectField TValue="string?" @bind-Value="_side" @bind-Value:after="Load" Options="Sides" Empty="@L["tar.all"]" Label="@L["bal.show"]" FieldClass="w200" />
    <span style="margin-inline-start:auto;display:flex;gap:6px">
        <Btn Small="true" Icon="export" Text="Excel" OnClick="@(() => Export("xlsx"))" />
        <Btn Small="true" Icon="export" Text="PDF" OnClick="@(() => Export("pdf"))" />
    </span>
</div>
<StateView State="_state" Kind="SkeletonKind.Report" ErrorReference="@_reference" OnRetry="Load">
    <Empty><EmptyState Icon="truck" Title="@L["prt.none"]" Text="@L["prt.noneText"]" /></Empty>
    <ChildContent>
        <ListFrame Label="@L["nav.partnerAccounts"]"><ChildContent><ReportGrid Result="_result!" ShowFilters="false" /></ChildContent></ListFrame>
    </ChildContent>
</StateView>

@code {
    private ReportResult? _result;
    private LoadState _state = LoadState.Loading;
    private string? _reference, _partner;
    private DateOnly? _asOf;
    private string? _side;

    private IReadOnlyList<Option<string?>> Sides => [new("owed", L["prt.sideOwed"]), new("owes", L["bal.sideOwes"])];

    [Parameter] public string Company { get; set; } = "";

    private string Query
    {
        get
        {
            var p = new List<string>();
            if (_asOf is { } d) p.Add("asOf=" + d.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
            if (_side is not null) p.Add("side=" + _side);
            return p.Count == 0 ? "" : "?" + string.Join('&', p);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (ListUrl.Read(Nav)["side"] is ("owed" or "owes") and var side) _side = side;
        try { await Lookups.EnsureAsync(); } catch (ApiException) { }
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _result = await Api.GetAsync<ReportResult>(Api.C("reports/standard/partner-balances" + Query));
            _state = _result.Rows.Count == 0 ? LoadState.Empty : LoadState.Ready;
        }
        catch (ApiException e) { _reference = e.Problem.Reference; _state = LoadState.Error; }
    }

    private Task Export(string format) => Files.SaveAsync(Api.C("reports/standard/partner-balances/export" + Query), format);
}
