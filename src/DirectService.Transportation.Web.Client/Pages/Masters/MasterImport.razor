@page "/c/{Company}/masters/import/{Kind}"
@* Master-data import (FR-164, DT-44 strict): choose an Excel/CSV file, preview every row with its problems and the column matching, then
   import — nothing is saved while any row has a problem. Kinds: drivers, customers, partners, materials, loading-sites, unloading-sites,
   ownership-types. *@
@using DirectService.Transportation.Contracts.Accounting
@inject Api Api
@inject Loc L
@inject ToastService Toasts
@inject NavigationManager Nav

<PageHeader Title="@L.F("imp.title", ListTitle)" Crumbs="@([new Crumb(L["nav.masterData"]), new Crumb(ListTitle, NavModel.Href(Company, "masters/" + Kind))])" />

@if (!Known)
{
    <NotFoundView />
}
else
{
    <Box Title="@L["imp.file"]">
        <div class="row" style="align-items:flex-end;flex-wrap:wrap">
            <div class="field" style="min-width:320px">
                <label for="imp-file">@L["imp.choose"]</label>
                <InputFile id="imp-file" class="input" style="padding-top:4px" accept=".xlsx,.csv,.tsv,.txt" OnChange="Picked" />
                <span class="help">@L["imp.help"]</span>
            </div>
            <Btn Icon="refresh" Text="@L["imp.preview"]" Disabled="_file is null" Busy="_busy" OnClick="Preview" />
            <Btn Primary="true" Icon="import" Text="@L["imp.import"]" Disabled="@(_preview is null || _preview.RejectedRows > 0)" Busy="_busy" OnClick="Import" />
        </div>
    </Box>
    @if (_error is not null) {<Banner Tone="Tone.Err" Text="@_error" />}
    @if (_preview is not null)
    {
        <Figures Items="@([new Figure(L["imp.total"], Fmt.Count(_preview.TotalRows)), new Figure(L["imp.valid"], Fmt.Count(_preview.ValidRows)), new Figure(L["imp.rejected"], Fmt.Count(_preview.RejectedRows))])" />
        @if (_preview.RejectedRows > 0) {<Banner Tone="Tone.Warn" Text="@L["imp.fixFirst"]" />}
        else {<Banner Tone="Tone.Ok" Text="@L.F("imp.ready", _preview.ValidRows)" />}
        <div class="cols fill" style="grid-template-columns:1fr 300px;align-items:start">
            <ListFrame Label="@L["imp.rows"]">
                <DataGrid TItem="ImportRowResult" Items="Rows" Key="r => r.Row" Caption="@L["imp.rows"]" RowClass="@(r => r.Problems.Count > 0 ? "sel" : null)">
                    <Columns>
                        <GridColumn TItem="ImportRowResult" Title="@L["imp.row"]" Value="r => Fmt.Count(r.Row)" Numeric="true" Width="70px" />
                        <GridColumn TItem="ImportRowResult" Title="@L["imp.key"]" Value="r => r.Key" />
                        <GridColumn TItem="ImportRowResult" Title="@L["imp.problems"]" Wrap="true">
                            <Template>@if (context.Problems.Count == 0) {<StatusTag Status="approved" />} else {<ul style="margin:0;padding-inline-start:16px;color:var(--err)">@foreach (var p in context.Problems) {<li><Tx Value="@p" /></li>}</ul>}</Template>
                        </GridColumn>
                    </Columns>
                </DataGrid>
            </ListFrame>
            <Box Title="@L["imp.columns"]">
                <KeyValues Columns="1" Items="@(_preview.Columns.Matched.Select(kv => new KeyValue(kv.Key, kv.Value)).ToList())" />
                @if (_preview.Columns.Unused.Count > 0) {<p class="help" style="margin-top:8px"><Tx Value="@(L["imp.unused"] + " " + string.Join("، ", _preview.Columns.Unused))" /></p>}
            </Box>
        </div>
    }
}

@code {
    private static readonly string[] Kinds = ["drivers", "customers", "partners", "materials", "loading-sites", "unloading-sites", "ownership-types", "tariffs"];
    private IBrowserFile? _file;
    private byte[]? _bytes;
    private MasterImportPreview? _preview;
    private string? _error;
    private bool _busy;

    [Parameter] public string Company { get; set; } = "";
    [Parameter] public string Kind { get; set; } = "";

    private bool Known => Kinds.Contains(Kind);

    private string ListTitle => L[Kind switch
    {
        "drivers" => "nav.drivers", "customers" => "nav.customers", "partners" => "nav.partners", "materials" => "nav.materials",
        "loading-sites" => "nav.loadingSites", "unloading-sites" => "nav.unloadingSites", "tariffs" => "nav.tariffs", _ => "nav.ownershipTypes",
    }];

    /// <summary>Rows with problems first.</summary>
    private IReadOnlyList<ImportRowResult> Rows => _preview!.Rows.OrderBy(r => r.Problems.Count == 0).ThenBy(r => r.Row).ToList();

    private async Task Picked(InputFileChangeEventArgs e)
    {
        _preview = null;
        _error = null;
        _file = e.File;
        try
        {
            await using var s = e.File.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            _bytes = ms.ToArray();
            await Preview();
        }
        catch (IOException) { _error = L["imp.tooLarge"]; _file = null; }
    }

    private async Task Preview()
    {
        if (_file is null || _bytes is null) return;
        _busy = true;
        _error = null;
        try { _preview = await Api.UploadAsync<MasterImportPreview>(Api.C($"{Kind}/import/preview"), new MemoryStream(_bytes), _file.Name); }
        catch (ApiException e) { _error = e.Problem.Detail; _preview = null; }
        finally { _busy = false; }
    }

    private async Task Import()
    {
        if (_file is null || _bytes is null) return;
        _busy = true;
        try
        {
            var r = await Api.UploadAsync<ImportResult>(Api.C($"{Kind}/import"), new MemoryStream(_bytes), _file.Name);
            Toasts.Success(L.F("imp.done", r.ImportedRows));
            Nav.NavigateTo(NavModel.Href(Company, "masters/" + Kind));
        }
        catch (ApiException e) { _error = e.Problem.Detail; }
        finally { _busy = false; }
    }
}
