@page "/c/{Company}/accounting/cost-centres"
@*
  SCR-43 cost centres (FR-131, FR-130): code, name, status; add / edit / archive / restore / delete (acct.setup); selectable on any journal
  and AP/AR line. The cost-centre report for a period shows revenue, expenses and net per centre (and lines without one). Excel / PDF.
*@
@inject Api Api
@inject Loc L
@inject ShellState Shell
@inject ToastService Toasts
@inject AccountingLookups Lookups
@inject Downloads Files

<PageHeader Title="@L["nav.costCentres"]" Crumbs="@([new Crumb(L["nav.accounting"]), new Crumb(L["nav.costCentres"])])">
    <Actions>@if (CanSetup) {<Btn Primary="true" Icon="plus" Text="@L["cc.new"]" OnClick="() => Edit(null)" />}</Actions>
</PageHeader>
<StateView State="_state" ErrorReference="@_reference" OnRetry="Load">
    <Empty>
        <EmptyState Icon="layers" Title="@L["cc.none"]" Text="@L["cc.noneText"]"><Actions>@if (CanSetup) {<Btn Primary="true" Text="@L["cc.new"]" OnClick="() => Edit(null)" />}</Actions></EmptyState>
    </Empty>
    <ChildContent>
        <div class="cols fill lp" style="grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);align-items:start;min-height:0">
            <ListFrame Label="@L["nav.costCentres"]">
                <DataGrid TItem="CostCentreResponse" Items="_items" Key="c => c.Id" Caption="@L["nav.costCentres"]" OnRowClick="Edit" RowClass="@(c => c.Status == "Active" ? null : "void")">
                    <Columns>
                        <GridColumn TItem="CostCentreResponse" Title="@L["acc.code"]" Value="c => c.Code" Ltr="true" />
                        <GridColumn TItem="CostCentreResponse" Title="@L["md.name"]" Value="c => c.Name" />
                        <GridColumn TItem="CostCentreResponse" Title="@L["ml.status"]"><Template><StatusTag Status="@(context.Status == "Active" ? "active" : "archived")" /></Template></GridColumn>
                    </Columns>
                </DataGrid>
            </ListFrame>
            <Box Title="@L["cc.report"]" NoPad="true">
                <div class="row pad" style="flex-wrap:wrap;gap:8px;align-items:flex-end">
                    <DateField @bind-Value="_from" Label="@L["trip.from"]" FieldClass="w160" />
                    <DateField @bind-Value="_to" Label="@L["trip.to"]" FieldClass="w160" />
                    <Btn Icon="filter" Text="@L["rep.run"]" OnClick="Report" />
                    <span style="margin-inline-start:auto;display:flex;gap:6px">
                        <Btn Small="true" Icon="export" Text="Excel" OnClick="@(() => Export("xlsx"))" />
                        <Btn Small="true" Icon="print" Text="PDF" OnClick="@(() => Export("pdf"))" />
                    </span>
                </div>
                @if (_report is { } r)
                {
                    <DataGrid TItem="CostCentreRow" Items="r.Rows" Key="x => (object?)x.CostCentre?.Id ?? string.Empty" Caption="@L["cc.report"]" FooterLabel="@L["ui.total"]">
                        <Columns>
                            <GridColumn TItem="CostCentreRow" Title="@L["je.costCentre"]" Value="@(x => x.CostCentre?.Name ?? L["cc.without"])" />
                            <GridColumn TItem="CostCentreRow" Title="@L["rep.revenue"]" Value="x => Fmt.Money(x.Revenue)" Numeric="true" Footer="@Fmt.Money(r.Totals.Revenue)" />
                            <GridColumn TItem="CostCentreRow" Title="@L["rep.expenses"]" Value="x => Fmt.Money(x.Expenses)" Numeric="true" Footer="@Fmt.Money(r.Totals.Expenses)" />
                            <GridColumn TItem="CostCentreRow" Title="@L["cc.net"]" Value="x => Fmt.Money(x.Net)" Numeric="true" Footer="@Fmt.Money(r.Totals.Net)" />
                        </Columns>
                    </DataGrid>
                }
            </Box>
        </div>
    </ChildContent>
</StateView>

<Modal @bind-Open="_editing" Title="@(_m.Id is null ? L["cc.new"] : L.F("ml.editTitle", _m.Name ?? ""))" Busy="_busy">
    <ChildContent>
        @if (_m.Id is not null) {<RecordLockGuard EntityType="ACC.CostCentre" Id="@_m.Id" OnState="h => _lockedBy = h" />}
        <EditForm EditContext="_ctx" OnValidSubmit="Save" id="cc-form" class="stack">
            <ProblemValidator @ref="_problems" />
            <ErrorSummary Extra="_extra" />
            <TextField @bind-Value="_m.Code" Label="@L["acc.code"]" Required="true" MaxLength="20" Ltr="true" ReadOnly="!CanSetup" />
            <TextField @bind-Value="_m.Name" Label="@L["md.name"]" Required="true" MaxLength="100" ReadOnly="!CanSetup" />
        </EditForm>
        @if (_m.Id is not null && CanSetup)
        {
            <div class="row" style="gap:6px;margin-top:10px">
                <Btn Icon="@(_m.Status == "Active" ? "archive" : "refresh")" Text="@L[_m.Status == "Active" ? "ml.archive" : "ml.restore"]" Busy="_busy" OnClick="ToggleStatus" />
                <Btn Danger="true" Icon="trash" Text="@L["ml.delete"]" OnClick="() => { _editing = false; _deleting = true; }" />
            </div>
        }
    </ChildContent>
    <Footer>
        <Btn Text="@L["ui.cancel"]" OnClick="() => _editing = false" />
        @if (CanSetup) {<Btn Type="submit" Disabled="@(_lockedBy is not null)" Primary="true" Text="@L["ui.save"]" Busy="_busy" form="cc-form" />}
    </Footer>
</Modal>
<ConfirmDialog @bind-Open="_deleting" Title="@L.F("ml.deleteTitle", _m.Name ?? "")" Danger="true" AskReason="true" ConfirmText="@L["ml.delete"]"
               Message="@L["cc.deleteText"]" Busy="_busy" Error="@_deleteError" OnConfirm="Delete" />

@code {
    private IReadOnlyList<CostCentreResponse> _items = [];
    private CostCentreReport? _report;
    private LoadState _state = LoadState.Loading;
    private string? _reference, _deleteError;
    private DateOnly? _from, _to;
    private string? _lockedBy;
    private bool _editing, _busy, _deleting;
    private Model _m = new();
    private EditContext _ctx = new(new Model());
    private ProblemValidator? _problems;
    private IReadOnlyList<string>? _extra;

    [Parameter] public string Company { get; set; } = "";

    private bool CanSetup => Shell.Can(PermissionKeys.AcctSetup);

    protected override async Task OnInitializedAsync()
    {
        await Load();
        await Report();
    }

    private async Task Load()
    {
        try
        {
            _items = await Api.GetAsync<IReadOnlyList<CostCentreResponse>>(Api.C("accounting/cost-centres"));
            _state = _items.Count == 0 ? LoadState.Empty : LoadState.Ready;
        }
        catch (ApiException e) { _reference = e.Problem.Reference; _state = LoadState.Error; }
    }

    private string Query()
    {
        var p = new List<string>();
        if (_from is { } f) p.Add("from=" + f.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
        if (_to is { } t) p.Add("to=" + t.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
        return p.Count == 0 ? "" : "?" + string.Join('&', p);
    }

    private async Task Report()
    {
        try
        {
            _report = await Api.GetAsync<CostCentreReport>(Api.C("accounting/reports/cost-centres" + Query()));
            _from ??= _report.From;
            _to ??= _report.To;
        }
        catch (ApiException) { _report = null; }
    }

    private Task Export(string format) => Files.SaveAsync(Api.C("accounting/reports/cost-centres/export" + Query()), format);

    private void Edit(CostCentreResponse? c)
    {
        _m = c is null ? new Model() : new Model { Id = c.Id, Code = c.Code, Name = c.Name, Status = c.Status, RowVersion = c.RowVersion };
        _ctx = new EditContext(_m);
        _extra = null;
        _lockedBy = null;
        _editing = true;
    }

    private async Task Save()
    {
        _busy = true;
        _extra = null;
        try
        {
            var req = new CostCentreRequest(_m.Code?.Trim(), _m.Name?.Trim(), _m.RowVersion);
            if (_m.Id is null) await Api.PostAsync(Api.C("accounting/cost-centres"), req);
            else await Api.PutAsync(Api.C($"accounting/cost-centres/{Uri.EscapeDataString(_m.Id)}"), req);
            _editing = false;
            Toasts.Success(L.F("ml.saved", _m.Name ?? ""));
            Lookups.Invalidate();
            await Load();
        }
        catch (ApiException e) { if (_problems?.Show(e.Problem) is { } other) _extra = [other]; }
        finally { _busy = false; }
    }

    private async Task ToggleStatus()
    {
        _busy = true;
        try
        {
            var active = _m.Status == "Active";
            await Api.PostAsync(Api.C($"accounting/cost-centres/{Uri.EscapeDataString(_m.Id!)}/{(active ? "archive" : "restore")}"), new StatusChangeRequest(_m.RowVersion));
            _editing = false;
            Toasts.Success(L.F(active ? "ml.archivedToast" : "ml.restored", _m.Name ?? ""));
            Lookups.Invalidate();
            await Load();
        }
        catch (ApiException e) { Toasts.Error(e.Problem.Detail ?? L["ui.loadFailed"]); }
        finally { _busy = false; }
    }

    private async Task Delete(string reason)
    {
        _busy = true;
        _deleteError = null;
        try
        {
            await Api.PostAsync(Api.C($"accounting/cost-centres/{Uri.EscapeDataString(_m.Id!)}/delete"), new DeleteRequest(reason));
            _deleting = false;
            Toasts.Success(L.F("ml.deleted", _m.Name ?? ""));
            Lookups.Invalidate();
            await Load();
        }
        catch (ApiException e) { _deleteError = e.Problem.Detail; }
        finally { _busy = false; }
    }

    private sealed class Model
    {
        public string? Id { get; set; }
        public string? Code { get; set; }
        public string? Name { get; set; }
        public string Status { get; set; } = "Active";
        public string? RowVersion { get; set; }
    }
}
