@page "/c/{Company}/accounting/balance-sheet"
@*
  SCR-38 balance sheet (FR-119, FR-110, DT-103): assets, liabilities and equity as of a date by the account tree, the current year's result
  and earlier results not yet transferred inside equity, totals and the balance check; the opening-balance difference line stays visible
  until it is zero. Excel / PDF.
*@
@inject Api Api
@inject Loc L
@inject ToastService Toasts
@inject Downloads Files

<PageHeader Title="@L["nav.balanceSheet"]" Crumbs="@([new Crumb(L["nav.accounting"]), new Crumb(L["nav.balanceSheet"])])" />
<div class="row" role="group" aria-label="@L["ui.filter"]" style="flex-wrap:wrap;gap:8px;align-items:flex-end;flex:none">
    <DateField @bind-Value="_asOf" Label="@L["rep.asOf"]" FieldClass="w160" />
    <Btn Primary="true" Icon="filter" Text="@L["rep.run"]" OnClick="Load" />
    <span style="margin-inline-start:auto;display:flex;gap:6px">
        <Btn Small="true" Icon="export" Text="Excel" OnClick="@(() => Export("xlsx"))" />
        <Btn Small="true" Icon="print" Text="PDF" OnClick="@(() => Export("pdf"))" />
    </span>
</div>
<StateView State="_state" Kind="SkeletonKind.Report" ErrorReference="@_reference" OnRetry="Load">
    <Empty><EmptyState Icon="chart" Title="@L["rep.noMovement"]" /></Empty>
    <ChildContent>
        @{ var r = _r!; }
        @if (!r.Balanced) {<Banner Tone="Tone.Err" Text="@L["rep.bsMismatch"]" />}
        @if (r.OpeningDifference is decimal d && d != 0) {<Banner Tone="Tone.Warn" Text="@L.F("dash.openingDiff", Fmt.Money(d))" />}
        <Figures Items="@([new Figure(L["rep.totalAssets"], Fmt.Money(r.TotalAssets)), new Figure(L["rep.totalLiabilities"], Fmt.Money(r.TotalLiabilities)),
            new Figure(L["rep.totalEquity"], Fmt.Money(r.TotalEquity)), new Figure(L["rep.liabEquity"], Fmt.Money(r.TotalLiabilitiesAndEquity))])" />
        <div class="cols fill" style="grid-template-columns:1fr 1fr;align-items:start;overflow:auto;min-height:0">
            <Box NoPad="true"><StatementTable Title="@L["rep.assets"]" Rows="r.Assets" TotalLabel="@L["rep.totalAssets"]" Total="r.TotalAssets" To="r.AsOf" /></Box>
            <div class="stack">
                <Box NoPad="true"><StatementTable Title="@L["rep.liabilities"]" Rows="r.Liabilities" TotalLabel="@L["rep.totalLiabilities"]" Total="r.TotalLiabilities" To="r.AsOf" /></Box>
                <Box NoPad="true">
                    <StatementTable Title="@L["rep.equity"]" Rows="r.Equity" TotalLabel="@L["rep.totalEquity"]" Total="r.TotalEquity" To="r.AsOf"
                                    Extra="@([(L["rep.currentResult"], r.CurrentYearResult, null), (L["rep.priorResults"], r.PriorYearsResult, null)])" />
                </Box>
                <div class="box pad"><div class="ln tot big"><span>@L["rep.liabEquity"]</span><Money Value="r.TotalLiabilitiesAndEquity" /></div></div>
            </div>
        </div>
    </ChildContent>
</StateView>

@code {
    private BalanceSheetReport? _r;
    private LoadState _state = LoadState.Loading;
    private string? _reference;
    private DateOnly? _asOf;

    [Parameter] public string Company { get; set; } = "";

    private string Query => _asOf is { } d ? "?asOf=" + d.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : "";

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        var before = _state;
        _state = LoadState.Loading;
        try
        {
            _r = await Api.GetAsync<BalanceSheetReport>(Api.C("accounting/reports/balance-sheet" + Query));
            _asOf ??= _r.AsOf;
            _state = _r.Assets.Count == 0 && _r.Liabilities.Count == 0 && _r.Equity.Count == 0 ? LoadState.Empty : LoadState.Ready;
        }
        // A refused filter (e.g. a period of more than the allowed years) is one message, not "could not load" (owner feedback 13 Oct 2026, RPT-12).
        catch (ApiException e) when (e.Problem.Status == 400)
        {
            Toasts.Error(e.Problem.Errors is { Count: > 0 } errors ? string.Join(" · ", errors.Select(x => x.Message)) : e.Problem.Detail ?? L["ui.loadFailed"]);
            _state = before == LoadState.Loading ? LoadState.Empty : before;
        }
        catch (ApiException e) { _reference = e.Problem.Reference; _state = LoadState.Error; }
    }

    private Task Export(string format) => Files.SaveAsync(Api.C("accounting/reports/balance-sheet/export" + Query), format);
}
