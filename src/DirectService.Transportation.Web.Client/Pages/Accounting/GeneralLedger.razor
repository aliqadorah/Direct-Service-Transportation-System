@page "/c/{Company}/accounting/ledger"
@page "/c/{Company}/accounting/statement"
@*
  SCR-35 general ledger (FR-116, FR-121) and SCR-39 account statement (FR-120): an account (a group covers its descendants), the period, an
  optional cost centre and — on the statement — an optional party; opening, every movement with its running balance, totals and closing;
  each line opens its entry and its source document. Excel / PDF. The statement is also open to reports.view (DT-113).
*@
@inject Api Api
@inject Loc L
@inject ToastService Toasts
@inject ShellState Shell
@inject AccountingLookups Lookups
@inject TripLookups Transport
@inject Downloads Files
@inject NavigationManager Nav

<PageHeader Title="@L[Statement ? "nav.statement" : "nav.ledger"]" Crumbs="@([new Crumb(L["nav.accounting"]), new Crumb(L[Statement ? "nav.statement" : "nav.ledger"])])" />
<div class="row" role="group" aria-label="@L["ui.filter"]" style="flex-wrap:wrap;gap:8px;align-items:flex-end;flex:none">
    <ComboField TValue="string?" @bind-Value="_account" Options="_accounts" Label="@L["je.account"]" Required="true" FieldClass="w260" OnSelected="_ => _party = null" />
    <DateField @bind-Value="_from" Label="@L["trip.from"]" FieldClass="w160" />
    <DateField @bind-Value="_to" Label="@L["trip.to"]" FieldClass="w160" />
    @if (Lookups.CostCentres.Count > 0) {<SelectField TValue="string?" @bind-Value="_costCentre" Options="Lookups.CostCentres" Empty="@L["tar.all"]" Label="@L["je.costCentre"]" FieldClass="w200" />}
    @if (Statement && PartyType is { } pt)
    {
        @if (pt == "Driver") {<ComboField TValue="string?" @bind-Value="_party" SearchAsync="SearchDrivers" Label="@L["je.party"]" Placeholder="@L["tar.all"]" FieldClass="w220" />}
        else {<ComboField TValue="string?" @bind-Value="_party" Options="_parties.GetValueOrDefault(pt) ?? []" Label="@L["je.party"]" Placeholder="@L["tar.all"]" FieldClass="w220" />}
    }
    <Btn Primary="true" Icon="filter" Text="@L["rep.run"]" Disabled="_account is null" OnClick="Run" />
    @if (_report is not null)
    {
        <span style="margin-inline-start:auto;display:flex;gap:6px">
            <Btn Small="true" Icon="export" Text="Excel" OnClick="@(() => Export("xlsx"))" />
            <Btn Small="true" Icon="print" Text="PDF" OnClick="@(() => Export("pdf"))" />
        </span>
    }
</div>
@if (_account is null)
{
    <Box Fill="true"><EmptyState Icon="book" Title="@L["rep.pickAccount"]" Text="@L["rep.pickAccountText"]" /></Box>
}
else
{
    <StateView State="_state" Kind="SkeletonKind.Report" ErrorReference="@_reference" OnRetry="Run">
        <Empty><EmptyState Icon="book" Title="@L["stmt.empty"]" /></Empty>
        <ChildContent>
            @{ var r = _report!; }
            <Figures Items="@([new Figure(L["rep.opening"], Fmt.Money(r.Opening)), new Figure(L["je.debit"], Fmt.Money(r.TotalDebit)), new Figure(L["je.credit"], Fmt.Money(r.TotalCredit)), new Figure(L["rep.closing"], Fmt.Money(r.Closing))])" />
            <ListFrame Label="@Lookups.Name(r.Account)">
                <ChildContent>
                    <DataGrid TItem="LedgerLine" Items="r.Lines.Items" Key="l => (object)l" Caption="@Lookups.Name(r.Account)" OnRowClick="Open">
                        <Columns>
                            <GridColumn TItem="LedgerLine" Title="@L["trip.date"]" Value="l => Fmt.Date(l.Date, Shell.DateFormat)" Ltr="true" />
                            <GridColumn TItem="LedgerLine" Title="@L["rep.entry"]" Value="l => l.Entry.Number" Ltr="true" />
                            <GridColumn TItem="LedgerLine" Title="@L["je.source"]">
                                <Template>
                                    @if (context.Source is { } s && Links.ForSource(Company, s.Type, s.Id) is { } href) {<a href="@href" @onclick:stopPropagation="true"><bdi>@(s.Number ?? L["je.src." + s.Type])</bdi></a>}
                                </Template>
                            </GridColumn>
                            <GridColumn TItem="LedgerLine" Title="@L["je.description"]" Value="l => l.Note ?? l.Description" Clip="true" />
                            <GridColumn TItem="LedgerLine" Title="@L["je.reference"]" Value="l => l.Reference" Clip="true" />
                            @if (r.Account.Id != null && _lines.Any(l => l.Account.Id != r.Account.Id)) {<GridColumn TItem="LedgerLine" Title="@L["je.account"]" Value="l => l.Account.Code" Ltr="true" />}
                            <GridColumn TItem="LedgerLine" Title="@L["je.party"]" Value="l => l.Party?.Name" Clip="true" />
                            <GridColumn TItem="LedgerLine" Title="@L["je.debit"]" Value="@(l => l.Debit == 0 ? null : Fmt.Money(l.Debit))" Numeric="true" />
                            <GridColumn TItem="LedgerLine" Title="@L["je.credit"]" Value="@(l => l.Credit == 0 ? null : Fmt.Money(l.Credit))" Numeric="true" />
                            <GridColumn TItem="LedgerLine" Title="@L["dash.balance"]" Value="l => Fmt.Money(l.Balance)" Numeric="true" />
                        </Columns>
                    </DataGrid>
                </ChildContent>
                <Footer><Pager Page="_page" PageSize="_size" Total="r.Lines.TotalCount" OnPage="Go" OnPageSize="Size" /></Footer>
            </ListFrame>
        </ChildContent>
    </StateView>
}

@code {
    private LedgerReport? _report;
    private IReadOnlyList<LedgerLine> _lines = [];
    private IReadOnlyList<Option<string?>> _accounts = [];
    private readonly Dictionary<string, IReadOnlyList<Option<string?>>> _parties = new(StringComparer.Ordinal);
    private LoadState _state = LoadState.Loading;
    private string? _reference, _account, _costCentre, _party;
    private DateOnly? _from, _to;
    private int _page = 1, _size = 200;

    [Parameter] public string Company { get; set; } = "";

    private bool Statement => Nav.Uri.Contains("/accounting/statement", StringComparison.Ordinal);

    /// <summary>The party type of the chosen account when it is a control account (statement by party, FR-120).</summary>
    private string? PartyType => Lookups.Account(_account) is { IsControlAccount: true } a ? a.ControlPartyType : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Lookups.EnsureAsync();
            // Group accounts cover their descendants (FR-116): the whole chart for acct.view, postable accounts otherwise.
            _accounts = Shell.Can(PermissionKeys.AcctView)
                ? (await Api.GetAsync<IReadOnlyList<AccountResponse>>(Api.C("accounting/accounts?status=Active")))
                    .Select(a => new Option<string?>(a.Id, $"{a.Code} · {L.Pick(a.NameAr, a.NameEn)}", a.IsPostable ? null : L["acc.group"])).ToList()
                : Lookups.Accounts.Select(a => new Option<string?>(a.Account.Id, Lookups.Name(a.Account))).ToList();
        }
        catch (ApiException) { }
        if (Statement)
        {
            static Option<string?> Opt(ApArPartyOption p) => new($"{p.Type}|{p.Id}", p.Name);
            try { _parties["Customer"] = (await Lookups.PartiesAsync("Customer")).Select(Opt).ToList(); } catch (ApiException) { }
            try { _parties["Supplier"] = (await Lookups.PartiesAsync("Supplier")).Select(Opt).ToList(); } catch (ApiException) { }
            try { await Transport.EnsureAsync(); _parties["Partner"] = Transport.Partners.Select(p => new Option<string?>($"Partner|{p.Value}", p.Text)).ToList(); } catch (ApiException) { }
        }
        var q = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        static DateOnly? Day(string? s) => DateOnly.TryParseExact(s, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : null;
        _from = Day(q["from"]);
        _to = Day(q["to"]);
        if (q["account"] is { Length: > 0 } acc) { _account = acc; await Run(); }
    }

    private async Task<IReadOnlyList<Option<string?>>> SearchDrivers(string text, CancellationToken ct) =>
        (await Transport.SearchDriversAsync(text, ct)).Select(o => new Option<string?>($"Driver|{o.Value}", o.Text, o.Sub)).ToList();

    private string Query(bool paged)
    {
        var p = new List<string>();
        void Add(string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) p.Add(k + "=" + Uri.EscapeDataString(v)); }
        Add("account", _account);
        Add("from", _from?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
        Add("to", _to?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture));
        Add("costCentre", _costCentre);
        if (Statement && _party?.Split('|') is [var type, var id]) { Add("partyType", type); Add("party", id); }
        if (paged) { Add("page", _page.ToString(System.Globalization.CultureInfo.InvariantCulture)); Add("pageSize", _size.ToString(System.Globalization.CultureInfo.InvariantCulture)); }
        return "?" + string.Join('&', p);
    }

    private string Path => Statement ? "accounting/reports/account-statement" : "accounting/reports/general-ledger";

    private Task Run() { _page = 1; return Load(); }

    private async Task Load()
    {
        if (_account is null) return;
        var before = _state;
        _state = LoadState.Loading;
        try
        {
            _report = await Api.GetAsync<LedgerReport>(Api.C(Path + Query(true)));
            _from ??= _report.From;
            _to ??= _report.To;
            _lines = _report.Lines.Items;
            _state = _report.Lines.TotalCount == 0 && _report.Opening == 0 ? LoadState.Empty : LoadState.Ready;
        }
        // A refused filter (e.g. a period of more than the allowed years) is one message, not "could not load" (owner feedback 13 Oct 2026, RPT-12).
        catch (ApiException e) when (e.Problem.Status == 400)
        {
            Toasts.Error(e.Problem.Errors is { Count: > 0 } errors ? string.Join(" · ", errors.Select(x => x.Message)) : e.Problem.Detail ?? L["ui.loadFailed"]);
            _state = before == LoadState.Loading ? LoadState.Empty : before;
        }
        catch (ApiException e) { _reference = e.Problem.Reference; _state = LoadState.Error; }
    }

    private Task Go(int p) { _page = p; return Load(); }
    private Task Size(int s) { _size = s; _page = 1; return Load(); }
    private Task Export(string format) => Files.SaveAsync(Api.C(Path + "/export" + Query(false)), format);

    /// <summary>A line opens its entry for readers of the journal (report readers see the statement only).</summary>
    private void Open(LedgerLine l)
    {
        if (Shell.Can(PermissionKeys.AcctView) || Shell.Can(PermissionKeys.JeView)) Nav.NavigateTo(NavModel.Href(Company, $"accounting/journal/{l.Entry.Id}"));
    }
}
