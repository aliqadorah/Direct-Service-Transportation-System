@page "/c/{Company}/profile"
@* SCR-08 my profile (FR-176, FR-178): language, default company and date format; theme for this user on this device (DT-244); active sessions with
   sign-out of one or all others; password change by an emailed link (the reset flow of SCR-04, DT-143), or here with the current password for a
   user without email (revision 6); two-step verification: state, and turning it on (QR code, first code, recovery codes).
   DT-229: name and username are read-only here (an Owner / Administrator sees "Edit" to their row in Users & roles); "Change email" asks for
   the new address and the current password (+ code with 2FA); the address waiting for confirmation is shown with "Cancel". *@
@using DirectService.Transportation.Contracts.Identity
@inject Api Api
@inject Loc L
@inject ShellState Shell
@inject ToastService Toasts
@inject UiJs Js
@inject NavigationManager Nav

<PageHeader Title="@L["profile.title"]" Help="profile" Crumbs="@([new Crumb(L["shell.userMenu"])])" />

<div class="cols flow lp" style="grid-template-columns:380px 1fr;align-items:start">
    <div class="stack" style="min-width:0">
    <Box Title="@L["profile.preferences"]">
        <EditForm Model="_form" OnValidSubmit="Save" class="stack">
            <ProblemValidator @ref="_problems" />
            <ErrorSummary />
            <TextField Value="@Shell.Me?.FullName" ValueExpression="() => _nameShown" Label="@L["profile.name"]" ReadOnly="true" Help="@L["profile.nameHelp"]" />
            @if (Shell.Me?.UserName is { } userName) {<TextField Value="@userName" ValueExpression="() => _emailShown" Label="@L["usr.userName"]" ReadOnly="true" Ltr="true" Help="@L["profile.nameHelp"]" />}
            @if (CanEditUsers)
            {
                <a style="font-size:13px" href="@NavModel.Href(Company, "settings/users?user=" + Uri.EscapeDataString(Shell.Me!.Id))">@L["profile.editInUsers"]</a>
            }
            <TextField Value="@(Shell.Me?.Email ?? "—")" ValueExpression="() => _emailShown" Label="@L["acct.email"]" ReadOnly="true" Ltr="true" />
            @if (Shell.Me?.PendingEmail is { } pending)
            {
                <Banner Tone="Tone.Info" Icon="mail">
                    <span>@L.F("profile.emailPending", pending)</span>
                    <button type="button" class="linkbtn" @onclick="CancelEmail" disabled="@_emBusy">@L["profile.emailCancel"]</button>
                </Banner>
            }
            <SelectField TValue="string" @bind-Value="_form.LanguageCode" Options="Languages" Label="@L["shell.language"]" />
            <SelectField TValue="string?" @bind-Value="_form.DefaultCompany" Options="Companies" Label="@L["profile.defaultCompany"]" />
            <SelectField TValue="string" @bind-Value="_form.DateFormat" Options="DateFormats" Label="@L["profile.dateFormat"]" />
            <SelectField TValue="string" Value="@Shell.Theme" ValueChanged="Theme" ValueExpression="() => _themeShown" Options="Themes" Label="@L["shell.theme"]" Help="@L["shell.themeNote"]" />
            <div class="formbar"><Btn Type="submit" Primary="true" Text="@L["profile.save"]" Busy="_saving" /></div>
            @* DT-232: the account actions in their own row (they overflowed the card next to Save). *@
            <div class="formbar start acct-actions">
                <Btn Icon="lock" Text="@L["profile.changePassword"]" Busy="_sendingLink" OnClick="ChangePassword" />
                <Btn Icon="mail" Text="@L["profile.changeEmail"]" OnClick="OpenEmail" />
            </div>
        </EditForm>
    </Box>
    <Box Title="@L["profile.tfaTitle"]">
        @* DT-210: two-step verification — turn on; or turn off, change the app, new recovery codes (each with password + code). *@
        <div class="stack" style="gap:8px">
            @{ var on = _tfa?.Enabled ?? Shell.Me?.TwoFactorEnabled == true; }
            <KeyValues Columns="1" Items="@(TfaFacts(on))" />
            @if (!on)
            {
                <Banner Tone="Tone.Warn" Icon="shield" Text="@L["profile.twoFactorRecommend"]" />
                <div class="formbar"><Btn Primary="true" Icon="shield" Text="@L["profile.enable2fa"]" Busy="_tfaBusy" OnClick="StartTwoFactor" /></div>
            }
            else
            {
                @if (_tfa is { Required: true }) {<Banner Tone="Tone.Info" Icon="lock" Text="@L[_tfa.RequiredForStaff ? "profile.tfaStaffOnly" : "profile.tfaRequiredByOrg"]" />}
                @if (_tfa is { RecoveryCodesLeft: < 3 }) {<Banner Tone="Tone.Warn" Icon="key" Text="@L.F("profile.tfaFewCodes", _tfa.RecoveryCodesLeft)" />}
                <div class="formbar start">
                    <Btn Icon="refresh" Text="@L["profile.tfaChangeApp"]" OnClick="@(() => OpenStep(StepAction.Change))" />
                    <Btn Icon="key" Text="@L["profile.tfaNewCodes"]" OnClick="@(() => OpenStep(StepAction.Codes))" />
                    <Btn Danger="true" Ghost="true" Icon="x" Text="@L["profile.tfaTurnOff"]" Disabled="@(_tfa?.Required != false)"
                         Title="@(_tfa is { Required: true } ? L[_tfa.RequiredForStaff ? "profile.tfaStaffOnly" : "profile.tfaRequiredByOrg"] : null)" OnClick="@(() => OpenStep(StepAction.Off))" />
                </div>
            }
        </div>
    </Box>
    </div>
    <Box Title="@L["profile.sessions"]" NoPad="true">
        <Actions>@if (_sessions is { Count: > 1 }) {<Btn Small="true" Danger="true" Icon="logout" FlipIcon="true" Text="@L["profile.signOutOthers"]" OnClick="SignOutOthers" />}</Actions>
        <ChildContent>
            <StateView State="_state" Kind="SkeletonKind.Report" ErrorReference="@_reference" OnRetry="LoadSessions">
                <DataGrid TItem="SessionResponse" Items="_sessions!" Key="s => s.Id" Caption="@L["profile.sessions"]">
                    <Columns>
                        <GridColumn TItem="SessionResponse" Title="@L["profile.device"]" Value="s => Device(s)" Wrap="true" />
                        <GridColumn TItem="SessionResponse" Title="@L["profile.ip"]" Value="s => Address(s)" />
                        <GridColumn TItem="SessionResponse" Title="@L["profile.signedIn"]" Value="s => Fmt.DateTime(s.CreatedAt.ToLocalTime(), Shell.DateFormat)" Ltr="true" />
                        <GridColumn TItem="SessionResponse" Title="@L["profile.lastSeen"]" Value="s => Fmt.DateTime(s.LastSeenAt.ToLocalTime(), Shell.DateFormat)" Ltr="true" />
                        <GridColumn TItem="SessionResponse" Title="@L["profile.action"]" HideTitle="true">
                            <Template>
                                @if (context.IsCurrent) {<StatusTag Status="active" />}
                                else {<Btn Small="true" Text="@L["shell.signOut"]" OnClick="() => Revoke(context)" />}
                            </Template>
                        </GridColumn>
                    </Columns>
                </DataGrid>
            </StateView>
            <p class="help" style="padding:8px 12px;margin:0">@L["profile.sessionsNote"]</p>
        </ChildContent>
    </Box>
</div>

<Modal @bind-Open="_pwOpen" Title="@L["profile.changePassword"]" Busy="_pwBusy" Icon="lock">
    <ChildContent>
        <div class="field">
            <label for="pw-current">@L["profile.currentPassword"] <span class="req" aria-hidden="true">*</span></label>
            <input id="pw-current" class="input" type="password" dir="ltr" maxlength="128" autocomplete="current-password" @bind="_pwCurrent" @bind:event="oninput" />
        </div>
        <div class="field">
            <label for="pw-new">@L["acct.newPassword"] <span class="req" aria-hidden="true">*</span></label>
            <input id="pw-new" class="input" type="password" dir="ltr" maxlength="128" autocomplete="new-password" @bind="_pwNew" @bind:event="oninput" />
            <div class="help">@L["usr.passwordPolicyHelp"]</div>
        </div>
        <div class="field">
            <label for="pw-confirm">@L["acct.confirmPassword"] <span class="req" aria-hidden="true">*</span></label>
            <input id="pw-confirm" class="input" type="password" dir="ltr" maxlength="128" autocomplete="new-password" @bind="_pwConfirm" @bind:event="oninput" />
        </div>
        @if (_pwError is not null) {<Banner Tone="Tone.Err" Text="@_pwError" />}
    </ChildContent>
    <Footer>
        <Btn Text="@L["ui.cancel"]" OnClick="() => _pwOpen = false" />
        <Btn Primary="true" Text="@L["profile.changePassword"]" Busy="_pwBusy" Disabled="@(string.IsNullOrEmpty(_pwCurrent) || string.IsNullOrEmpty(_pwNew) || string.IsNullOrEmpty(_pwConfirm))" OnClick="SavePassword" />
    </Footer>
</Modal>

<Modal @bind-Open="_emOpen" Title="@L["profile.changeEmail"]" Busy="_emBusy" Icon="mail">
    <ChildContent>
        <EditForm EditContext="_emCtx" OnSubmit="SaveEmail" class="stack" novalidate>
            <ProblemValidator @ref="_emProblems" />
            <ErrorSummary Extra="_emExtra" />
            <p>@L["profile.changeEmailLead"]</p>
            <TextField Id="em-new" @bind-Value="_em.NewEmail" Label="@L["profile.newEmail"]" Type="email" Required="true" Ltr="true" MaxLength="150" Autocomplete="email" />
            <TextField Id="em-password" @bind-Value="_em.CurrentPassword" Label="@L["profile.currentPassword"]" Type="password" Required="true" Ltr="true" MaxLength="128" Autocomplete="current-password" />
            @if (Shell.Me?.TwoFactorEnabled == true)
            {
                @if (_em.UseRecovery)
                {
                    <TextField Id="em-recovery" @bind-Value="_em.RecoveryCode" Label="@L["acct.recoveryTitle"]" Required="true" Ltr="true" MaxLength="20" Autocomplete="off" />
                }
                else
                {
                    <TextField Id="em-code" @bind-Value="_em.Code" Label="@L["acct.codeField"]" Required="true" Ltr="true" MaxLength="7" Autocomplete="one-time-code" />
                }
                <button type="button" class="linkbtn" @onclick="() => _em.UseRecovery = !_em.UseRecovery">@L[_em.UseRecovery ? "profile.tfaUseCode" : "acct.useRecovery"]</button>
            }
        </EditForm>
    </ChildContent>
    <Footer>
        <Btn Text="@L["ui.cancel"]" OnClick="() => _emOpen = false" />
        <Btn Primary="true" Text="@L["profile.sendEmailLink"]" Busy="_emBusy" Disabled="@(string.IsNullOrWhiteSpace(_em.NewEmail) || string.IsNullOrEmpty(_em.CurrentPassword))" OnClick="SaveEmail" />
    </Footer>
</Modal>

<Modal @bind-Open="_tfaOpen" Title="@L["acct.setupTitle"]" Busy="_tfaBusy" Icon="shield">
    <ChildContent>
        @if (_codes is not null)
        {
            <Banner Tone="Tone.Ok" Text="@L["profile.enable2faDone"]" />
            <p>@L["acct.codesLead"]</p>
            <ul class="num" dir="ltr" aria-label="@L["acct.codesTitle"]"
                style="list-style:none;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;background:var(--page);border:1px solid var(--border);border-radius:var(--r);padding:12px 16px;font-size:15px;letter-spacing:.04em">
                @foreach (var c in _codes) {<li>@c</li>}
            </ul>
        }
        else if (_setup is not null)
        {
            <div class="tfa-setup">
                <p>@L["acct.setupStep1"]</p>
                <p>@L["acct.setupStep2"]</p>
                @if (_setup.QrSvg is { } svg) {<div class="tfa-qr" role="img" aria-label="@L["acct.setupQr"]">@((MarkupString)svg)</div>}
                <div class="tfa-key num" dir="ltr">@_setup.SharedKey</div>
                <p>@L["acct.setupStep3"]</p>
            </div>
            <div class="field">
                <label for="tfa-code">@L["acct.codeField"] <span class="req" aria-hidden="true">*</span></label>
                <input id="tfa-code" class="input num" dir="ltr" inputmode="numeric" maxlength="7" autocomplete="one-time-code" @bind="_tfaCode" @bind:event="oninput" />
            </div>
        }
        @if (_tfaError is not null) {<Banner Tone="Tone.Err" Text="@_tfaError" />}
    </ChildContent>
    <Footer>
        @if (_codes is not null) {<Btn Primary="true" Text="@L["ui.close"]" OnClick="() => _tfaOpen = false" />}
        else
        {
            <Btn Text="@L["ui.cancel"]" OnClick="() => _tfaOpen = false" />
            <Btn Primary="true" Text="@L["acct.setupSubmit"]" Busy="_tfaBusy" Disabled="@string.IsNullOrWhiteSpace(_tfaCode)" OnClick="CompleteTwoFactor" />
        }
    </Footer>
</Modal>

<Modal @bind-Open="_stepOpen" Title="@StepTitle" Busy="_stepBusy" Icon="shield">
    <ChildContent>
        @* DT-210: password + current code (or a recovery code), then — for "Change authenticator app" — the new app's QR code and code. *@
        @if (_newCodes is not null)
        {
            <Banner Tone="Tone.Ok" Text="@L["profile.tfaCodesDone"]" />
            <p>@L["acct.codesLead"]</p>
            <ul class="num tfa-codes" dir="ltr" aria-label="@L["acct.codesTitle"]">
                @foreach (var c in _newCodes) {<li>@c</li>}
            </ul>
        }
        else if (_changeSetup is not null)
        {
            <EditForm EditContext="_confirmCtx" OnSubmit="ConfirmChange" class="stack" novalidate>
                <ProblemValidator @ref="_confirmProblems" />
                <ErrorSummary Extra="_stepExtra" />
                <p>@L["profile.tfaChangeLead"]</p>
                @if (_changeSetup.QrSvg is { } svg) {<div class="tfa-qr" role="img" aria-label="@L["acct.setupQr"]">@((MarkupString)svg)</div>}
                <div class="tfa-key num" dir="ltr">@_changeSetup.SharedKey</div>
                <TextField Id="tfa-new-code" @bind-Value="_confirm.Code" Label="@L["acct.codeField"]" Required="true" Ltr="true" MaxLength="7" Autocomplete="one-time-code" />
            </EditForm>
        }
        else
        {
            <EditForm EditContext="_stepCtx" OnSubmit="SubmitStep" class="stack" novalidate>
                <ProblemValidator @ref="_stepProblems" />
                <ErrorSummary Extra="_stepExtra" />
                <p>@L["profile.tfaStepLead"]</p>
                @if (_stepAction == StepAction.Off) {<Banner Tone="Tone.Warn" Icon="alert" Text="@L["profile.tfaOffWarn"]" />}
                @if (_stepAction == StepAction.Codes) {<Banner Tone="Tone.Info" Icon="info" Text="@L["profile.tfaCodesWarn"]" />}
                <TextField Id="tfa-password" @bind-Value="_step.CurrentPassword" Label="@L["profile.currentPassword"]" Type="password" Required="true" Ltr="true" MaxLength="128" Autocomplete="current-password" />
                @if (_step.UseRecovery)
                {
                    <TextField Id="tfa-recovery" @bind-Value="_step.RecoveryCode" Label="@L["acct.recoveryTitle"]" Required="true" Ltr="true" MaxLength="20" Autocomplete="off" />
                }
                else
                {
                    <TextField Id="tfa-code" @bind-Value="_step.Code" Label="@L["acct.codeField"]" Required="true" Ltr="true" MaxLength="7" Autocomplete="one-time-code" />
                }
                <button type="button" class="linkbtn" @onclick="ToggleRecovery">@L[_step.UseRecovery ? "profile.tfaUseCode" : "acct.useRecovery"]</button>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        @if (_newCodes is not null) {<Btn Primary="true" Text="@L["ui.close"]" OnClick="() => _stepOpen = false" />}
        else if (_changeSetup is not null)
        {
            <Btn Text="@L["ui.cancel"]" OnClick="() => _stepOpen = false" />
            <Btn Primary="true" Text="@L["profile.tfaConfirmApp"]" Busy="_stepBusy" OnClick="ConfirmChange" />
        }
        else
        {
            <Btn Text="@L["ui.cancel"]" OnClick="() => _stepOpen = false" />
            <Btn Primary="@(_stepAction != StepAction.Off)" DangerPrimary="@(_stepAction == StepAction.Off)" Text="@StepSubmit" Busy="_stepBusy" OnClick="SubmitStep" />
        }
    </Footer>
</Modal>

@code {
    // ------------------------------------------------------------ two-step verification management (DT-210)

    private enum StepAction { Off, Change, Codes }

    private TwoFactorStatusResponse? _tfa;
    private bool _stepOpen, _stepBusy;
    private StepAction _stepAction;
    private StepModel _step = new();
    private ConfirmModel _confirm = new();
    private EditContext _stepCtx = new(new StepModel()), _confirmCtx = new(new ConfirmModel());
    private ProblemValidator? _stepProblems, _confirmProblems;
    private IReadOnlyList<string>? _stepExtra, _newCodes;
    private TwoFactorSetupResponse? _changeSetup;

    private string StepTitle => _stepAction switch
    {
        StepAction.Off => L["profile.tfaTurnOffTitle"],
        StepAction.Change => L["profile.tfaChangeApp"],
        _ => L["profile.tfaNewCodes"],
    };

    private string StepSubmit => _stepAction switch
    {
        StepAction.Off => L["profile.tfaTurnOff"],
        StepAction.Change => L["profile.tfaContinue"],
        _ => L["profile.tfaNewCodes"],
    };

    private IReadOnlyList<KeyValue> TfaFacts(bool on)
    {
        var facts = new List<KeyValue> { new(L["usr.2fa"], L[on ? "ui.on" : "ui.off"]) };
        if (on && _tfa?.EnabledAt is { } since) facts.Add(new KeyValue(L["profile.tfaSince"], Fmt.DateTime(since.ToLocalTime(), Shell.DateFormat)));
        if (on && _tfa is not null) facts.Add(new KeyValue(L["profile.tfaCodesLeft"], _tfa.RecoveryCodesLeft.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        return facts;
    }

    private async Task LoadTwoFactor()
    {
        try { _tfa = await Api.GetAsync<TwoFactorStatusResponse>("api/v1/me/2fa"); } catch (ApiException) { }
    }

    private void OpenStep(StepAction action)
    {
        _stepAction = action;
        _step = new StepModel();
        _stepCtx = new EditContext(_step);
        _confirm = new ConfirmModel();
        _confirmCtx = new EditContext(_confirm);
        _stepExtra = _newCodes = null;
        _changeSetup = null;
        _stepOpen = true;
    }

    private void ToggleRecovery()
    {
        _step.UseRecovery = !_step.UseRecovery;
        _step.Code = _step.RecoveryCode = null;
        _stepProblems?.Clear();
    }

    private async Task<bool> ShowStepProblem(ApiProblem p, ProblemValidator? problems)
    {
        var other = problems?.Show(p);
        _stepExtra = other is null ? null : [other];
        await Task.CompletedTask;
        return false;
    }

    private async Task SubmitStep()
    {
        if (_stepBusy) return;
        var missing = new List<ApiFieldError>();
        if (string.IsNullOrEmpty(_step.CurrentPassword)) missing.Add(new("currentPassword", "validation.required", L.F("ui.requiredField", L["profile.currentPassword"])));
        if (_step.UseRecovery && string.IsNullOrWhiteSpace(_step.RecoveryCode)) missing.Add(new("recoveryCode", "validation.required", L.F("ui.requiredField", L["acct.recoveryTitle"])));
        if (!_step.UseRecovery && string.IsNullOrWhiteSpace(_step.Code)) missing.Add(new("code", "validation.required", L.F("ui.requiredField", L["acct.codeField"])));
        if (missing.Count > 0) { await ShowStepProblem(new ApiProblem { Status = 400, Errors = missing }, _stepProblems); return; }
        _stepBusy = true;
        _stepExtra = null;
        var request = new TwoFactorStepUpRequest(_step.CurrentPassword, _step.UseRecovery ? null : _step.Code?.Replace(" ", "", StringComparison.Ordinal),
            _step.UseRecovery ? _step.RecoveryCode?.Trim() : null);
        try
        {
            switch (_stepAction)
            {
                case StepAction.Off:
                    Shell.SetMe(await Api.PostAsync<MeResponse>("api/v1/me/2fa/disable", request));
                    _stepOpen = false;
                    Toasts.Success(L["profile.tfaOffDone"]);
                    await LoadSessions();
                    break;
                case StepAction.Change:
                    _changeSetup = await Api.PostAsync<TwoFactorSetupResponse>("api/v1/me/2fa/change", request);
                    break;
                default:
                    var result = await Api.PostAsync<RecoveryCodesResponse>("api/v1/me/2fa/recovery-codes", request);
                    _newCodes = result.RecoveryCodes;
                    break;
            }
            await LoadTwoFactor();
        }
        catch (ApiException e) { await ShowStepProblem(e.Problem, _stepProblems); }
        finally { _stepBusy = false; }
    }

    private async Task ConfirmChange()
    {
        if (_stepBusy) return;
        if (string.IsNullOrWhiteSpace(_confirm.Code))
        {
            await ShowStepProblem(new ApiProblem { Status = 400, Errors = [new("code", "validation.required", L.F("ui.requiredField", L["acct.codeField"]))] }, _confirmProblems);
            return;
        }
        _stepBusy = true;
        _stepExtra = null;
        try
        {
            Shell.SetMe(await Api.PostAsync<MeResponse>("api/v1/me/2fa/change/confirm", new TwoFactorCodeRequest(_confirm.Code.Replace(" ", "", StringComparison.Ordinal), null)));
            _stepOpen = false;
            Toasts.Success(L["profile.tfaChangedDone"]);
            await LoadTwoFactor();
            await LoadSessions();
        }
        catch (ApiException e) { await ShowStepProblem(e.Problem, _confirmProblems); }
        finally { _stepBusy = false; }
    }

    /// <summary>"This computer (local)" for the loopback address (the app running on this PC), otherwise the address (DT-211).</summary>
    private string? Address(SessionResponse s) =>
        s.IpAddress is "::1" or "127.0.0.1" or "::ffff:127.0.0.1" ? L["profile.localComputer"] : s.IpAddress;

    // ------------------------------------------------------------ DT-229: email change

    private EmailModel _em = new();
    private EditContext _emCtx = new(new EmailModel());
    private bool _emOpen, _emBusy;
    private ProblemValidator? _emProblems;
    private IReadOnlyList<string>? _emExtra;

    /// <summary>Owner or Administrator of this company: may edit names and usernames in Users &amp; roles (their own too).</summary>
    private bool CanEditUsers => Shell.Company is { IsPresetRole: true, Role: PresetRoles.Owner or PresetRoles.Administrator };

    private void OpenEmail()
    {
        _em = new EmailModel();
        _emCtx = new EditContext(_em);
        _emExtra = null;
        _emOpen = true;
    }

    private async Task SaveEmail()
    {
        if (string.IsNullOrWhiteSpace(_em.NewEmail) || string.IsNullOrEmpty(_em.CurrentPassword)) return;
        _emBusy = true;
        _emExtra = null;
        try
        {
            var twoFactor = Shell.Me?.TwoFactorEnabled == true;
            var r = await Api.PostAsync<EmailChangeResponse>("api/v1/me/email", new ChangeEmailRequest(_em.NewEmail.Trim(), _em.CurrentPassword,
                twoFactor && !_em.UseRecovery ? _em.Code?.Replace(" ", "", StringComparison.Ordinal) : null, twoFactor && _em.UseRecovery ? _em.RecoveryCode : null));
            if (Shell.Me is { } me) Shell.SetMe(me with { PendingEmail = r.PendingEmail });
            _emOpen = false;
            Toasts.Success(L.F("profile.emailLinkSent", r.PendingEmail ?? ""));
        }
        catch (ApiException e) { if (_emProblems?.Show(e.Problem) is { } other) _emExtra = [other]; }
        finally { _emBusy = false; }
    }

    private async Task CancelEmail()
    {
        _emBusy = true;
        try
        {
            await Api.DeleteAsync("api/v1/me/email");
            if (Shell.Me is { } me) Shell.SetMe(me with { PendingEmail = null });
            Toasts.Success(L["profile.emailCancelled"]);
        }
        catch (ApiException e) { Toasts.Error(e.Problem.Detail ?? L["ui.serverErrorText"]); }
        finally { _emBusy = false; }
    }

    private sealed class EmailModel
    {
        public string? NewEmail { get; set; }
        public string? CurrentPassword { get; set; }
        public string? Code { get; set; }
        public string? RecoveryCode { get; set; }
        public bool UseRecovery { get; set; }
    }

    private sealed class StepModel
    {
        public string? CurrentPassword { get; set; }
        public string? Code { get; set; }
        public string? RecoveryCode { get; set; }
        public bool UseRecovery { get; set; }
    }

    private sealed class ConfirmModel
    {
        public string? Code { get; set; }
    }

    private bool _pwOpen, _pwBusy, _tfaOpen, _tfaBusy;
    private string? _pwCurrent, _pwNew, _pwConfirm, _pwError, _tfaCode, _tfaError;
    private TwoFactorSetupResponse? _setup;
    private IReadOnlyList<string>? _codes;

    private readonly PreferencesForm _form = new();
    private ProblemValidator? _problems;
    private IReadOnlyList<SessionResponse>? _sessions;
    private LoadState _state = LoadState.Loading;
    private string? _reference;
    private bool _saving;
    private bool _sendingLink;
    private readonly string? _nameShown = null, _emailShown = null, _themeShown = null;

    [Parameter] public string Company { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        var me = Shell.Me!;
        _form.LanguageCode = me.LanguageCode;
        _form.DefaultCompany = me.DefaultCompany;
        _form.DateFormat = Fmt.Safe(me.DateFormat);
        await Task.WhenAll(LoadSessions(), LoadTwoFactor());
    }

    private async Task LoadSessions()
    {
        _state = LoadState.Loading;
        try
        {
            _sessions = await Api.GetAsync<IReadOnlyList<SessionResponse>>("api/v1/me/sessions");
            _state = LoadState.Ready;
        }
        catch (ApiException e)
        {
            _reference = e.Problem.Reference;
            _state = LoadState.Error;
        }
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var languageChanged = _form.LanguageCode != Shell.Me!.LanguageCode;
            await Api.PutAsync("api/v1/me/preferences", new PreferencesRequest(_form.LanguageCode, _form.DefaultCompany, _form.DateFormat));
            if (languageChanged) { Nav.Refresh(forceReload: true); return; }   // the server renders the new language
            Shell.SetMe(Shell.Me with { DefaultCompany = _form.DefaultCompany, DateFormat = _form.DateFormat });
            Toasts.Success(L["profile.saved"]);
        }
        catch (ApiException e)
        {
            if (_problems?.Show(e.Problem) is { } other) Toasts.Error(other);
        }
        finally { _saving = false; }
    }

    /// <summary>Applied at once, without Save (DT-244), like the menu's quick switch.</summary>
    private async Task Theme(string theme)
    {
        Shell.SetTheme(theme);
        await Js.SetPref(Shell.ThemeKey, Shell.Theme);
        await Js.ApplyTheme(Shell.Theme);
    }

    /// <summary>An emailed link for users with an email (DT-143); here with the current password for a user without one (revision 6).</summary>
    private Task ChangePassword()
    {
        if (Shell.Me?.Email is not null) return SendPasswordLink();
        _pwCurrent = _pwNew = _pwConfirm = _pwError = null;
        _pwOpen = true;
        return Task.CompletedTask;
    }

    private async Task SavePassword()
    {
        if (_pwNew != _pwConfirm) { _pwError = L["acct.mismatch"]; return; }
        _pwBusy = true;
        _pwError = null;
        try
        {
            await Api.PostAsync("api/v1/me/password", new ChangePasswordRequest(_pwCurrent!, _pwNew!));
            _pwOpen = false;
            Toasts.Success(L["profile.passwordChanged"]);
            await LoadSessions();
        }
        catch (ApiException e) { _pwError = e.Problem.Detail; }
        finally { _pwBusy = false; }
    }

    private async Task StartTwoFactor()
    {
        _tfaBusy = true;
        _tfaError = null;
        _codes = null;
        _tfaCode = null;
        try
        {
            _setup = await Api.GetAsync<TwoFactorSetupResponse>("api/v1/me/2fa/setup");
            _tfaOpen = true;
        }
        catch (ApiException e) { Toasts.Error(e.Problem.Detail ?? L["ui.loadFailed"]); }
        finally { _tfaBusy = false; }
    }

    private async Task CompleteTwoFactor()
    {
        _tfaBusy = true;
        _tfaError = null;
        try
        {
            var result = await Api.PostAsync<RecoveryCodesResponse>("api/v1/me/2fa/setup", new TwoFactorCodeRequest(_tfaCode!.Replace(" ", "", StringComparison.Ordinal), null));
            _codes = result.RecoveryCodes;
            await LoadTwoFactor();
            Shell.SetMe(result.Me);
            await LoadSessions();
        }
        catch (ApiException e) { _tfaError = e.Problem.Detail; }
        finally { _tfaBusy = false; }
    }

    private async Task SendPasswordLink()
    {
        _sendingLink = true;
        try
        {
            await Api.PostAsync("api/v1/auth/password-reset/request", new EmailRequest(Shell.Me!.Email!));
            Toasts.Success(L["profile.linkSent"]);
        }
        catch (ApiException e) { Toasts.Error(e.Problem.Detail ?? L["ui.loadFailed"]); }
        finally { _sendingLink = false; }
    }

    private async Task Revoke(SessionResponse s)
    {
        try
        {
            await Api.DeleteAsync($"api/v1/me/sessions/{Uri.EscapeDataString(s.Id)}");
            Toasts.Success(L["profile.revoked"]);
            await LoadSessions();
        }
        catch (ApiException e) { Toasts.Error(e.Problem.Detail ?? L["ui.loadFailed"]); }
    }

    private async Task SignOutOthers()
    {
        try
        {
            await Api.PostAsync("api/v1/me/sessions/sign-out-others", null);
            Toasts.Success(L["profile.revokedOthers"]);
            await LoadSessions();
        }
        catch (ApiException e) { Toasts.Error(e.Problem.Detail ?? L["ui.loadFailed"]); }
    }

    private string Device(SessionResponse s) => (string.IsNullOrWhiteSpace(s.UserAgent) ? L["profile.unknownDevice"] : Browser(s.UserAgent)) + (s.IsCurrent ? " · " + L["profile.thisSession"] : "");

    /// <summary>A short device description from the user agent (system · browser).</summary>
    private static string Browser(string ua)
    {
        var os = ua.Contains("Windows", StringComparison.Ordinal) ? "Windows" : ua.Contains("Android", StringComparison.Ordinal) ? "Android"
            : ua.Contains("iPhone", StringComparison.Ordinal) || ua.Contains("iPad", StringComparison.Ordinal) ? "iOS" : ua.Contains("Mac OS", StringComparison.Ordinal) ? "macOS" : ua.Contains("Linux", StringComparison.Ordinal) ? "Linux" : "";
        var br = ua.Contains("Edg/", StringComparison.Ordinal) ? "Edge" : ua.Contains("Firefox/", StringComparison.Ordinal) ? "Firefox" : ua.Contains("Chrome/", StringComparison.Ordinal) ? "Chrome" : ua.Contains("Safari/", StringComparison.Ordinal) ? "Safari" : "";
        return string.Join(" · ", new[] { os, br }.Where(x => x.Length > 0)) is { Length: > 0 } d ? d : ua[..Math.Min(40, ua.Length)];
    }

    private IReadOnlyList<Option<string>> Languages => [new("ar", "العربية"), new("en", "English")];
    private IReadOnlyList<Option<string?>> Companies => (Shell.Me?.Companies ?? []).Select(c => new Option<string?>(c.Id, L.Pick(c.Name, c.NameEn))).ToList();
    private IReadOnlyList<Option<string>> DateFormats => [new("yyyy-MM-dd", "2026-10-31 (YYYY-MM-DD)"), new("dd/MM/yyyy", "31/10/2026 (DD/MM/YYYY)"), new("MM/dd/yyyy", "10/31/2026 (MM/DD/YYYY)")];
    private IReadOnlyList<Option<string>> Themes => TopBar.Themes.Select(t => new Option<string>(t.Value, L[t.Key])).ToList();

    private sealed class PreferencesForm
    {
        public string LanguageCode { get; set; } = "ar";
        public string? DefaultCompany { get; set; }
        public string DateFormat { get; set; } = "yyyy-MM-dd";
    }
