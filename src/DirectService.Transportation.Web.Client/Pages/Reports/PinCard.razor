@* A pinned report as the dashboard shows it (FR-140) — also the preview in the pin dialog (DT-275): report · measure, the value in its kind
   (rows as a count, money, quantity), a bar towards the critical threshold when warning above it, and the state normal / warning / exceeded
   in the chosen direction. *@
@using DirectService.Shared.Contracts
@using DirectService.Transportation.Contracts.Reports
@inject Loc L
<div class="pin-card" style="padding:5px 0;border-bottom:1px solid var(--border)" data-state="@State">
    <div style="display:flex;justify-content:space-between;gap:8px"><span><Tx Value="@Report" /> · <Tx Value="@MeasureLabel" /></span><b class="num">@ValueText</b></div>
    @if (!Below && Critical is decimal crit && crit > 0 && Value is decimal v) {<div style="margin:4px 0"><ProgressBar Value="v" Max="crit" Label="@MeasureLabel" /></div>}
    @if (Problem is not null) {<Badge Tone="Tone.Mute" Icon="info" Text="@Problem" />}
    else {<Badge Tone="StateTone" Icon="@(StateTone == Tone.Ok ? "check" : "alert")" Text="@StateText" />}
</div>

@code {
    [Parameter] public string Report { get; set; } = "";
    [Parameter] public string MeasureLabel { get; set; } = "";
    [Parameter] public decimal? Value { get; set; }
    /// <summary>number (a count), money, quantity.</summary>
    [Parameter] public string Kind { get; set; } = "money";
    [Parameter] public string State { get; set; } = "normal";
    [Parameter] public decimal? Warning { get; set; }
    [Parameter] public decimal? Critical { get; set; }
    [Parameter] public string WarnWhen { get; set; } = PinStates.Above;
    [Parameter] public string? Problem { get; set; }

    private bool Below => WarnWhen == PinStates.Below;

    private Tone StateTone => State switch { "exceeded" => Tone.Err, "warning" => Tone.Warn, _ => Tone.Ok };

    /// <summary>A value in the measure's own kind; a threshold in the same kind.</summary>
    private string Show(decimal? v) => v is null ? "—" : Kind switch
    {
        "money" => Fmt.Money(v),
        "quantity" => Fmt.Qty(v),
        _ => v == decimal.Truncate(v.Value) ? Fmt.Count((long)v.Value) : Fmt.Money(v),
    };

    private string ValueText => Show(Value);

    private string StateText => State switch
    {
        "exceeded" => L.F(Below ? "dash.pinExceededBelow" : "dash.pinExceeded", Show(Critical)),
        "warning" => L.F(Below ? "dash.pinWarningBelow" : "dash.pinWarning", Show(Warning)),
        _ => L["dash.pinNormal"],
    };
}
