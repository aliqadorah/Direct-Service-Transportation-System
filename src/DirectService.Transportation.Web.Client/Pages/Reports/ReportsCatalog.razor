@page "/c/{Company}/reports/operational"
@page "/c/{Company}/reports/financial"
@*
  SCR-50 operational reports (7.7.2, FR-018, FR-024, FR-142, FR-148…151) and SCR-51 financial statements, registers and ageing (7.7.3,
  FR-105, FR-128): the catalog of the group the user may run (DT-117); a report's own filters, the result with totals and drill-down,
  Excel / PDF, or a background export for large results (FR-151). Reports served by their own screen (trips list, statements, ledger,
  ageing, registers, e-invoicing) open that screen; the sub-ledger reconciliation (RPT-23) is shown here.
  DT-248: the open report's code, name and one-line description head the results column; it is marked in the list (aria-current); the
  report and its filters are kept in the address (?report=…&from=…), so refresh, Back / Forward and bookmarks reopen it, and the browser
  tab is named after it. DT-249: every filter box shows the value in use, the report's defaults included.
*@
@implements IDisposable
@inject Api Api
@inject Loc L
@inject ShellState Shell
@inject ToastService Toasts
@inject TripLookups Lookups
@inject AccountingLookups AccLookups
@inject Downloads Files
@inject NavigationManager Nav
@inject UiJs Js

<PageTitle>@TabTitle</PageTitle>
<PageHeader Title="@L[Financial ? "nav.finReports" : "nav.opReports"]" Crumbs="@([new Crumb(L["nav.reports"]), new Crumb(L[Financial ? "nav.finReports" : "nav.opReports"])])" />
<div class="cols fill rp">
    <nav class="box rep-nav" aria-label="@L[Financial ? "nav.finReports" : "nav.opReports"]">
        @if (_catalog is null) {<Skeleton Kind="SkeletonKind.List" />}
        else if (Entries.Count == 0) {<EmptyState Icon="chart" Title="@L["rep.noneAllowed"]" />}
        else
        {
            <ul class="rep-list">
                @foreach (var e in Entries)
                {
                    var entry = e;
                    <li>
                        <button type="button" class="btn ghost" aria-current="@(_selected?.Key == entry.Key ? "page" : null)" @onclick="() => Choose(entry)">
                            <span><bdi class="num rep-code">@entry.Code</bdi> @entry.Title</span>
                        </button>
                    </li>
                }
            </ul>
        }
    </nav>
    <div class="stack rep-main" style="min-width:0;min-height:0">
        @if (_selected is not null)
        {
            <header class="rep-head" id="rep-head">
                <h2><bdi class="num">@_selected.Code</bdi> · @_selected.Title</h2>
                @if (_selected.Description is { Length: > 0 } about) {<p class="muted">@about</p>}
            </header>
        }
        @if (_selected is null)
        {
            <Box Fill="true"><EmptyState Icon="chart" Title="@L["rep.pick"]" Text="@L["rep.pickText"]" /></Box>
        }
        else if (_selected.Path is not null && _selected.Key != "reconciliation")
        {
            <Box Fill="true">
                <EmptyState Icon="file" Title="@_selected.Title" Text="@L["rep.ownScreen"]">
                    <Actions>@foreach (var (label, href) in Screens(_selected)) {<Btn Primary="true" Text="@label" Href="@href" />}</Actions>
                </EmptyState>
            </Box>
        }
        else
        {
            @* The report's filters: required ones are checked before loading, and a refusal of the server marks its field (owner feedback 13 Oct 2026, RPT-12). *@
            <EditForm EditContext="_ctx" OnSubmit="Run" class="row" role="group" aria-label="@L["ui.filter"]" style="flex-wrap:wrap;gap:8px;align-items:flex-end;flex:none">
                <ProblemValidator @ref="_problems" />
                @if (Has("from")) {<DateField @bind-Value="_q.From" Label="@L["trip.from"]" FieldClass="w160" />}
                @if (Has("to")) {<DateField @bind-Value="_q.To" Label="@L["trip.to"]" FieldClass="w160" />}
                @if (Has("asOf")) {<DateField @bind-Value="_q.AsOf" Label="@L["rep.asOf"]" FieldClass="w160" />}
                @if (Has("customer")) {<ComboField TValue="string?" @bind-Value="_q.Customer" Options="Lookups.Customers" Label="@L["trip.customer"]" Required="@Needs("customer")" Placeholder="@(Needs("customer") ? L["ui.choose"] : L["tar.all"])" FieldClass="w220" />}
                @if (Has("supplier")) {<ComboField TValue="string?" @bind-Value="_q.Supplier" Options="_suppliers" Label="@L["rep.supplier"]" Required="@Needs("supplier")" Placeholder="@L["ui.choose"]" FieldClass="w220" />}
                @if (Has("driver")) {<ComboField TValue="string?" @bind-Value="_q.Driver" SearchAsync="Lookups.SearchDriversAsync" Label="@L["trip.driver"]" Placeholder="@L["tar.all"]" FieldClass="w220" />}
                @if (Has("partner")) {<ComboField TValue="string?" @bind-Value="_q.Partner" Options="Lookups.Partners" Label="@L["md.partner"]" Placeholder="@L["tar.all"]" FieldClass="w220" />}
                @if (Has("loadingSite")) {<ComboField TValue="string?" @bind-Value="_q.LoadingSite" Options="Lookups.LoadingSites" Label="@L["trip.loading"]" Placeholder="@L["tar.all"]" FieldClass="w200" />}
                @if (Has("unloadingSite")) {<ComboField TValue="string?" @bind-Value="_q.UnloadingSite" Options="Lookups.UnloadingSites" Label="@L["trip.unloading"]" Placeholder="@L["tar.all"]" FieldClass="w200" />}
                @if (Has("material")) {<ComboField TValue="string?" @bind-Value="_q.Material" Options="Lookups.Materials" Label="@L["trip.material"]" Placeholder="@L["tar.all"]" FieldClass="w200" />}
                @if (Has("groupBy")) {<SelectField TValue="string?" @bind-Value="_q.GroupBy" Options="GroupBys" Label="@L["rep.groupBy"]" FieldClass="w160" />}
                @if (Has("side")) {<SelectField TValue="string?" @bind-Value="_q.Side" Options="Sides" Label="@L["rep.side"]" FieldClass="w160" />}
                <Btn Type="submit" Primary="true" Icon="filter" Text="@L["rep.run"]" />
                <span style="margin-inline-start:auto;display:flex;gap:6px">
                    <Btn Small="true" Icon="export" Text="Excel" OnClick="@(() => Export("xlsx"))" />
                    <Btn Small="true" Icon="print" Text="PDF" OnClick="@(() => Export("pdf"))" />
                    @if (_selected.Path is null) {<Btn Small="true" Icon="clock" Text="@L["rep.background"]" Title="@L["rep.backgroundHelp"]" OnClick="Background" />}
                </span>
            </EditForm>
            <StateView State="_state" Kind="SkeletonKind.Report" ErrorReference="@_reference" OnRetry="Run">
                <Empty>@if (_waiting) {<EmptyState Icon="filter" Title="@L["rep.chooseFilters"]" Text="@L["rep.chooseFiltersText"]" />} else {<EmptyState Icon="chart" Title="@L["rep.noRows"]" Text="@L["rep.noRowsText"]" />}</Empty>
                <ChildContent>
                    @if (_result is not null)
                    {
                        <ListFrame Label="@_result.Title"><ChildContent><ReportGrid Result="_result" /></ChildContent></ListFrame>
                    }
                    else if (_reconciliation is not null)
                    {
                        <Reconciliation Report="_reconciliation" />
                    }
                </ChildContent>
            </StateView>
        }
    </div>
</div>

@code {
    private IReadOnlyList<ReportCatalogEntry>? _catalog;
    private ReportCatalogEntry? _selected;
    private ReportResult? _result;
    private ReconciliationReport? _reconciliation;
    private QueryModel _q = new();
    private IReadOnlyList<Option<string?>> _suppliers = [];
    private EditContext _ctx = new(new QueryModel());
    private ProblemValidator? _problems;
    /// <summary>A required filter is still empty: the report waits for it (nothing was asked of the server).</summary>
    private bool _waiting;
    private LoadState _state = LoadState.Empty;
    private string? _reference;

    [Parameter] public string Company { get; set; } = "";

    private bool Financial => Nav.Uri.Contains("/reports/financial", StringComparison.Ordinal);
    private IReadOnlyList<ReportCatalogEntry> Entries => _catalog?.Where(e => e.Group == (Financial ? "financial" : "operational")).ToList() ?? [];

    private IReadOnlyList<Option<string?>> GroupBys => [new("customer", L["trip.customer"]), new("route", L["drv.route"]), new("driver", L["trip.driver"]), new("month", L["per.month"])];
    private IReadOnlyList<Option<string?>> Sides => [new("customer", L["trip.customer"]), new("partner", L["md.partner"])];

    private bool Has(string parameter) => _selected?.Parameters.Contains(parameter) == true;

    /// <summary>The report cannot run without this filter (catalogue "required", e.g. the customer of a customer statement).</summary>
    private bool Needs(string parameter) => _selected?.Required?.Contains(parameter) == true;

    /// <summary>The browser tab: the open report ("RPT-04 · Tariff breach report"), else the page.</summary>
    private string TabTitle => (_selected is { } s ? $"{s.Code} · {s.Title}" : L[Financial ? "nav.finReports" : "nav.opReports"]) + " · " + L["shell.product"];

    /// <summary>The address this screen last showed or wrote itself (a change to it is not a Back / Forward to follow).</summary>
    private string? _address;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += Navigated;
        try { await Lookups.EnsureAsync(); } catch (ApiException) { }
        try { _catalog = await Api.GetAsync<IReadOnlyList<ReportCatalogEntry>>(Api.C("reports/catalog")); } catch (ApiException) { _catalog = []; }
        if (_catalog.Any(c => c.Parameters.Contains("supplier")))
        {
            try { _suppliers = (await AccLookups.PartiesAsync("Supplier")).Select(p => new Option<string?>(p.Id, p.Name, p.TaxNumber)).ToList(); } catch (ApiException) { }
        }
        await FromAddress();
    }

    public void Dispose() => Nav.LocationChanged -= Navigated;

    /// <summary>Back / Forward, a bookmark or the other report group (operational ↔ financial) in the same screen: show what the address names.</summary>
    private void Navigated(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () => { if (_catalog is not null && !Same(_address, e.Location)) { await FromAddress(); StateHasChanged(); } });

    /// <summary>Opens the report of the address (?report=…) with the filters it carries; the report's defaults fill the others.</summary>
    private async Task FromAddress()
    {
        _address = Nav.Uri;
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        if (query["report"] is { Length: > 0 } key && Entries.FirstOrDefault(e => e.Key == key) is { } e)
        {
            await Select(e, k => query[k]);
        }
        else
        {
            _selected = null;
            _result = null;
            _reconciliation = null;
            _state = LoadState.Empty;
        }
    }

    /// <summary>A report chosen in the list: a new entry in the browser's history (Back returns to the report before).</summary>
    private async Task Choose(ReportCatalogEntry e)
    {
        await Select(e, _ => null);
        await Js.RevealStacked(".rep-main");   // stacked under the list (narrow window): bring the title into view
    }

    private async Task Select(ReportCatalogEntry e, Func<string, string?> given)
    {
        _selected = e;
        _q = new QueryModel();
        Fill(_q, k => given(k) is { Length: > 0 } v ? v : null);
        Fill(_q, k => e.Defaults?.GetValueOrDefault(k));
        _ctx = new EditContext(_q);
        _result = null;
        _reconciliation = null;
        _state = LoadState.Empty;
        _waiting = (e.Required ?? []).Any(p => string.IsNullOrWhiteSpace(Value(p)));
        Remember(push: _address is { } shown && ReportOf(shown) != e.Key);
        // A report that needs a filter (a customer statement needs the customer) waits for it instead of asking the server and failing.
        if ((e.Path is null || e.Key == "reconciliation") && !_waiting)
        {
            StateHasChanged();   // the filters are on screen before the answer, so a refused filter can be marked on its field
            await Run();
        }
    }

    /// <summary>Puts each empty filter of the report to the value <paramref name="value"/> gives (yyyy-MM-dd for dates).</summary>
    private void Fill(QueryModel q, Func<string, string?> value)
    {
        foreach (var p in _selected!.Parameters)
        {
            if (!string.IsNullOrWhiteSpace(Value(p, q)) || value(p) is not { Length: > 0 } v) continue;
            DateOnly? Day() => DateOnly.TryParseExact(v, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d : null;
            switch (p)
            {
                case "from": q.From = Day(); break;
                case "to": q.To = Day(); break;
                case "asOf": q.AsOf = Day(); break;
                case "customer": q.Customer = v; break;
                case "supplier": q.Supplier = v; break;
                case "driver": q.Driver = v; break;
                case "partner": q.Partner = v; break;
                case "loadingSite": q.LoadingSite = v; break;
                case "unloadingSite": q.UnloadingSite = v; break;
                case "material": q.Material = v; break;
                case "groupBy": q.GroupBy = v; break;
                case "side": q.Side = v; break;
            }
        }
    }

    /// <summary>Two addresses of the same page and query (absolute or relative).</summary>
    private bool Same(string? a, string b) => a is not null && Nav.ToAbsoluteUri(a).PathAndQuery == Nav.ToAbsoluteUri(b).PathAndQuery;

    private static string? ReportOf(string uri) => System.Web.HttpUtility.ParseQueryString(new Uri(uri).Query)["report"];

    /// <summary>Writes the open report and its filters into the address: a new history entry when the report changes, else in place.</summary>
    private void Remember(bool push)
    {
        var query = Query();
        var target = NavModel.Href(Company, Financial ? "reports/financial" : "reports/operational") + "?report=" + Uri.EscapeDataString(_selected!.Key)
            + (query.Length > 0 ? "&" + query[1..] : "");
        if (Same(_address, target)) return;
        _address = Nav.ToAbsoluteUri(target).ToString();
        Nav.NavigateTo(target, replace: !push);
    }

    /// <summary>Screens that serve a report listed in the catalog with its own path (7.7.2 / 7.7.3).</summary>
    private IEnumerable<(string Label, string Href)> Screens(ReportCatalogEntry e)
    {
        (string, string) S(string key, string route) => (L[key], NavModel.Href(Company, route));
        return e.Key switch
        {
            "trips" => [S("nav.trips", "trips/list")],
            "driver-statement" => [S("nav.driverAccounts", "driver-accounts")],
            "partner-statement" => [S("nav.partnerAccounts", "partner-accounts")],
            "account-statement" => [S("nav.statement", "accounting/statement")],
            "cash-bank-statement" => [S("nav.cashBanks", "accounting/cash-banks")],
            "receivables-ageing" => [S("nav.receivables", "accounting/receivables?tab=ageing")],
            "payables-ageing" => [S("nav.payables", "accounting/payables?tab=ageing")],
            "registers" => [S("nav.invoices", "invoices"), S("nav.creditNotes", "credit-notes"), S("nav.receipts", "receipts"), S("drv.advancesList", "driver-accounts/advances"),
                            S("drv.settlementsList", "driver-accounts/settlements"), S("prt.paymentsList", "partner-accounts/payments")],
            "e-invoicing" => [S("nav.einvoicing", "e-invoicing")],
            _ => [],
        };
    }

    private string Query()
    {
        var p = new List<string>();
        void Add(string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) p.Add(k + "=" + Uri.EscapeDataString(v)); }
        string? D(DateOnly? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
        Add("from", D(_q.From)); Add("to", D(_q.To)); Add("asOf", D(_q.AsOf));
        Add("customer", _q.Customer); Add("driver", _q.Driver); Add("partner", _q.Partner); Add("supplier", _q.Supplier);
        Add("loadingSite", _q.LoadingSite); Add("unloadingSite", _q.UnloadingSite); Add("material", _q.Material);
        Add("groupBy", _q.GroupBy); Add("side", _q.Side);
        return p.Count == 0 ? "" : "?" + string.Join('&', p);
    }

    private string Path => _selected!.Key == "reconciliation" ? "accounting/reports/reconciliation" : $"reports/standard/{_selected.Key}";

    private async Task Run()
    {
        if (_selected is null) return;
        _problems?.Clear();
        var missing = (_selected.Required ?? []).Where(p => string.IsNullOrWhiteSpace(Value(p)))
            .Select(p => new ApiFieldError(p, "validation.required", L.F("ui.requiredField", L[FilterLabel(p)]))).ToList();
        if (missing.Count > 0)
        {
            // Marked on the field itself, with its own message; one message, nothing asked of the server.
            _problems?.Show(new ApiProblem { Status = 400, Errors = missing });
            _waiting = true;
            _state = LoadState.Empty;
            return;
        }
        _waiting = false;
        Fill(_q, k => _selected.Defaults?.GetValueOrDefault(k));   // a box the user emptied shows the value the report uses again
        Remember(push: false);
        _state = LoadState.Loading;
        try
        {
            if (_selected.Key == "reconciliation")
            {
                _reconciliation = await Api.GetAsync<ReconciliationReport>(Api.C(Path + Query()));
                _state = LoadState.Ready;
            }
            else
            {
                _result = await Api.GetAsync<ReportResult>(Api.C(Path + Query()));
                _state = _result.Rows.Count == 0 ? LoadState.Empty : LoadState.Ready;
            }
        }
        catch (ApiException e) when (e.Problem.Status == 400 && e.Problem.Errors is { Count: > 0 })
        {
            // A filter the server refuses is marked on its field (one toast for anything that belongs to no field), not "could not load".
            if (_problems?.Show(e.Problem) is { } other) Toasts.Error(other);
            _state = LoadState.Empty;
            _waiting = true;
        }
        catch (ApiException e) { _reference = e.Problem.Reference; _state = LoadState.Error; Toasts.Error(e.Problem.Detail ?? L["ui.loadFailed"]); }
    }

    private string? Value(string parameter, QueryModel? model = null)
    {
        var q = model ?? _q;
        return parameter switch
        {
            "customer" => q.Customer, "supplier" => q.Supplier, "driver" => q.Driver, "partner" => q.Partner, "loadingSite" => q.LoadingSite, "unloadingSite" => q.UnloadingSite,
            "material" => q.Material, "groupBy" => q.GroupBy, "side" => q.Side,
            "from" => q.From?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
            "to" => q.To?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
            "asOf" => q.AsOf?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
            _ => null,
        };
    }

    private static string FilterLabel(string parameter) => parameter switch
    {
        "customer" => "trip.customer", "supplier" => "rep.supplier", "driver" => "trip.driver", "partner" => "md.partner", "loadingSite" => "trip.loading", "unloadingSite" => "trip.unloading",
        "material" => "trip.material", "groupBy" => "rep.groupBy", "side" => "rep.side", "from" => "trip.from", "to" => "trip.to", _ => "rep.asOf",
    };

    private Task Export(string format) => Files.SaveAsync(Api.C(Path + "/export" + Query()), format);

    /// <summary>Large exports run in the background; a notification links to the file when it is ready (FR-151, DT-122).</summary>
    private async Task Background()
    {
        try
        {
            var q = new StandardReportQuery(_q.From, _q.To, _q.AsOf, _q.Customer, _q.Driver, _q.Partner, _q.LoadingSite, _q.UnloadingSite, _q.Material, _q.GroupBy, _q.Side, _q.Supplier);
            await Api.PostAsync<ExportJobResponse>(Api.C("exports"), new { Kind = "standard", Key = _selected!.Key, Query = q, From = _q.From, To = _q.To, Format = "xlsx" });
            Toasts.Success(L["rep.backgroundQueued"]);
        }
        catch (ApiException e) { Toasts.Error(e.Problem.Detail ?? L["ui.loadFailed"]); }
    }

    private sealed class QueryModel
    {
        public DateOnly? From { get; set; }
        public DateOnly? To { get; set; }
        public DateOnly? AsOf { get; set; }
        public string? Customer { get; set; }
        public string? Supplier { get; set; }
        public string? Driver { get; set; }
        public string? Partner { get; set; }
        public string? LoadingSite { get; set; }
        public string? UnloadingSite { get; set; }
        public string? Material { get; set; }
        public string? GroupBy { get; set; }
        public string? Side { get; set; }
    }
}
