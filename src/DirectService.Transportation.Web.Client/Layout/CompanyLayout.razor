@*
  Layout of the signed-in application (SCR-00): loads the profile, selects the company of the URL (/c/{company}/…; tenant pages use the
  current or home company), and renders the shell with the page. A company the user cannot open is shown as "not found" (the API also
  answers 404), so its existence is never revealed.
*@
@inherits LayoutComponentBase
@implements IDisposable
@inject AppSession Session
@inject ShellState Shell
@inject NavigationManager Nav
@inject Loc L
@inject LiveUpdates Live
@inject ToastService Toasts

@if (_state == LoadState.Loading)
{
    <div class="empty" style="height:100vh" role="status"><div class="sk" style="width:48px;height:48px;border-radius:50%"></div><span class="muted">@L["ui.loading"]</span></div>
}
else
{
    <AppShell SearchAsync="Session.SearchAsync" OnCompany="SwitchCompany" OnNotifications="() => _notes = true" OnProfile="Profile"
              OnLanguage="Session.SetLanguageAsync" OnSignOut="Session.SignOutAsync">
        <Banners><TenantBanners /></Banners>
        <ChildContent>
            @if (_switching)
            {
                @* Switching company (DT-187): no page is built until the new company is selected, so none asks for the old one's data. *@
                <div class="empty" role="status"><div class="sk" style="width:48px;height:48px;border-radius:50%"></div><span class="muted">@L["ui.loading"]</span></div>
            }
            else if (_state == LoadState.Error)
            {
                <ErrorState Reference="@_reference" OnRetry="Load" />
            }
            else if (_state == LoadState.Empty || !OnUrlCompany)
            {
                <NotFoundView />
            }
            else if (!NavModel.RouteAllowed(Shell.Permissions, Nav.ToBaseRelativePath(Nav.Uri)))
            {
                <NoAccessView />
            }
            else
            {
                @* A new page instance per path: routes that share a component (new / edit, payables / receivables) never carry state over. *@
                <div @key="PageKey" style="display:contents">@Body</div>
            }
            <NotificationsPanel @bind-Open="_notes" />
        </ChildContent>
    </AppShell>
}

@code {
    private LoadState _state = LoadState.Loading;
    private string? _reference;
    private bool _notes;
    private string? _company;
    private bool _started;
    private bool _switching;

    protected override async Task OnInitializedAsync()
    {
        _lastUri = Nav.Uri;
        Nav.LocationChanged += Moved;
        Live.Notification += Notified;
        _company = CompanyOfUrl() ?? Shell.Company?.Id;
        _started = true;
        await Load();
    }

    /// <summary>
    /// A new address (the router passes a new body before <see cref="Moved"/> runs): when it names another company, the switch starts here,
    /// before the new page could be built against the old company (DT-187).
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_started && CompanyOfUrl() is { } company && company != _company) StartSwitch(company);
    }

    /// <summary>
    /// Leaves the current company at once: its reads in flight are cancelled (their answers are dropped by <see cref="Api"/>), the
    /// notifications panel closes, and the page area waits until the new company is selected; then every page is built afresh for it.
    /// </summary>
    private void StartSwitch(string company)
    {
        _company = company;
        _switching = true;
        _notes = false;
        Shell.LeaveCompany();
        _ = InvokeAsync(async () => { await Load(); StateHasChanged(); });
    }

    private async Task Load()
    {
        var target = _company;
        try
        {
            await Session.EnsureLoadedAsync();
            if (target is null) _company = target = Shell.Company?.Id ?? Session.HomeCompany;
            if (target != _company) return;   // a newer switch is under way: it loads its company
            var ok = target is not null && await Session.EnterCompanyAsync(target);
            if (target != _company) return;
            _state = ok ? LoadState.Ready : LoadState.Empty;
            _switching = false;
            if (_state == LoadState.Ready) _ = Live.EnterCompanyAsync(target!);   // live updates of this company (FR-185)
        }
        catch (OperationCanceledException)
        {
            // Left for another company while loading: that switch loads it.
        }
        catch (ApiException e)
        {
            if (target != _company) return;
            _reference = e.Problem.Reference;
            _state = LoadState.Error;
            _switching = false;
        }
    }

    /// <summary>The shell's company is the company of the address (tenant pages have none and use the current one).</summary>
    private bool OnUrlCompany => (CompanyOfUrl() ?? _company) == Shell.Company?.Id;

    private int _visit;
    private string? _lastUri;

    /// <summary>Pages are kept across query changes they make themselves (list filters, UX-12) and recreated for any other move.</summary>
    private string PageKey => Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath + "#" + _visit;

    private void Moved(object? sender, LocationChangedEventArgs e)
    {
        var before = _lastUri;
        _lastUri = e.Location;
        if (before is not null && e.Location != ListUrl.LastWritten && e.Location != before
            && Nav.ToAbsoluteUri(before).AbsolutePath == Nav.ToAbsoluteUri(e.Location).AbsolutePath)
        {
            _visit++;   // same list, new filters from a link: start the page again
            _ = InvokeAsync(StateHasChanged);
        }
        var company = CompanyOfUrl();
        if (company is null) return;
        _ = InvokeAsync(() =>
        {
            if (company == CompanyOfUrl() && company != _company) { StartSwitch(company); StateHasChanged(); }
        });
    }

    /// <summary>The company token of /c/{company}/… addresses.</summary>
    private string? CompanyOfUrl()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Split('/', StringSplitOptions.RemoveEmptyEntries);
        return path.Length >= 2 && path[0] == "c" ? Uri.UnescapeDataString(path[1]) : null;
    }

    private void SwitchCompany(string company) => Nav.NavigateTo(NavModel.Href(company, ""));

    private void Profile() => Nav.NavigateTo(NavModel.Href(Shell.Company?.Id ?? "", "profile"));

    /// <summary>A notification for this user arrived (FR-190): the bell counts it at once and a toast says so.</summary>
    private void Notified(System.Text.Json.JsonElement n) => _ = InvokeAsync(() =>
    {
        Shell.SetNotifications(Shell.UnreadNotifications + 1);
        Toasts.Success(L["notif.arrived"]);
        StateHasChanged();
    });

    public void Dispose()
    {
        Nav.LocationChanged -= Moved;
        Live.Notification -= Notified;
    }
}
