@* Page-wide banners of the shell (UX-19): service announcements (P-14, hideable for the session), support session (staff, read-only, BR-014),
   subscription past due or suspended (read-only, BR-012/D-12), trial, archived company (read-only). *@
@inject ShellState Shell
@inject AppSession Session
@inject Loc L
@implements IDisposable
@{
    var tenant = Shell.Me?.TenantStatus;
    var canManage = Shell.Can(PermissionKeys.TenantManage);
}
@foreach (var a in _announcements.Where(a => !Session.HiddenAnnouncements.Contains(a.Id) && a.StartsAt <= DateTime.UtcNow && a.EndsAt > DateTime.UtcNow))
{
    var item = a;
    <Banner Tone="Tone.Info" Icon="megaphone" Text="@($"{item.Title}: {item.Message}")">
        <Actions><Btn Small="true" Ghost="true" Text="@L["banner.hide"]" OnClick="() => Session.HiddenAnnouncements.Add(item.Id)" /></Actions>
    </Banner>
}
@if (Shell.Me?.IsPlatformStaff == true && Shell.SupportEnded is null)
{
    <Banner Tone="Tone.Lock" Icon="shield" Text="@L["banner.support"]">
        <Actions><a href="/console/support-access">@L["shell.console"]</a></Actions>
    </Banner>
}
@if (Shell.Company?.Status == "Archived")
{
    <Banner Tone="Tone.Lock" Icon="archive" Text="@L["banner.archived"]" />
}
@if (tenant == "Suspended")
{
    <Banner Tone="Tone.Err" Icon="lock" Text="@L["banner.suspended"]">
        <Actions>@if (canManage) {<a href="/tenant/subscription">@L["banner.renew"]</a>}</Actions>
    </Banner>
}
else if (tenant == "PastDue")
{
    <Banner Tone="Tone.Warn" Text="@L["banner.pastDue"]">
        <Actions>@if (canManage) {<a href="/tenant/subscription">@L["banner.updatePayment"]</a>}</Actions>
    </Banner>
}
else if (tenant == "Trial" && canManage)
{
    <Banner Tone="Tone.Info" Icon="clock" Text="@L["banner.trial"]">
        <Actions><a href="/tenant/subscription">@L["banner.choosePlan"]</a></Actions>
    </Banner>
}

@code {
    private IReadOnlyList<DirectService.Platform.Contracts.Tenants.AnnouncementResponse> _announcements = [];

    protected override async Task OnInitializedAsync()
    {
        Shell.Changed += ShellChanged;   // e.g. a support window that closed removes the support banner at once (DT-220)
        _announcements = await Session.AnnouncementsAsync();
    }

    private void ShellChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Shell.Changed -= ShellChanged;
}
