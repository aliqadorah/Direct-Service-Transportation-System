@*
  Top bar: company switcher, Ctrl+K command bar trigger, notifications bell with unread count, user menu (profile, density with
  "saved on this device", language, sign out). Provider console variant shows the environment and tenant search.
*@
@inject Loc L
<header class="top">
    <button type="button" class="btn ghost menu-toggle" aria-label="@L["shell.menu"]" aria-expanded="@(MenuOpen ? "true" : "false")" @onclick="OnMenu"><Icon Name="grid" /></button>
    @if (Provider)
    {
        <Badge Tone="Tone.Mute" Icon="shield" Text="@L["shell.production"]" />
    }
    else if (Companies.Count > 0)
    {
        <MenuButton Icon="building" Ghost="false" AriaLabel="@L["shell.switchCompany"]" Text="@CurrentCompanyName">
            <div class="mh">@L["shell.switchCompany"]</div>
            @foreach (var c in Companies)
            {
                var company = c;
                <button type="button" role="menuitemradio" aria-checked="@(company.Id == CurrentCompany ? "true" : "false")" @onclick="() => OnCompany.InvokeAsync(company.Id)"><Tx Value="@L.Pick(company.Name, company.NameEn)" /></button>
            }
        </MenuButton>
    }
    <button type="button" class="cmdk" aria-label="@L["shell.commandBar"]" aria-keyshortcuts="Control+K" @onclick="OnCommandBar">
        <Icon Name="search" /><span>@L[Provider ? "shell.searchTenant" : "shell.search"]</span><Kbd Keys="Ctrl K" />
    </button>
    @if (!Provider)
    {
        <Btn Ghost="true" Class="bell" Icon="bell" AriaLabel="@L.F("shell.notifications", Unread)" OnClick="OnNotifications">@if (Unread > 0) {<span class="dot" aria-hidden="true">@(Unread > 99 ? "99+" : Unread.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>}</Btn>
    }
    <MenuButton Icon="user" Text="@UserName" AriaLabel="@L["shell.userMenu"]">
        @if (!Provider) {<button type="button" role="menuitem" @onclick="OnProfile"><Icon Name="user" />@L["shell.profile"]</button>}
        <hr />
        <div class="mh">@L["shell.density"] · @L["shell.densityNote"]</div>
        <button type="button" role="menuitemradio" aria-checked="@(Density == "compact" ? "true" : "false")" @onclick="@(() => OnDensity.InvokeAsync("compact"))"><Icon Name="density" />@L["shell.compact"]</button>
        <button type="button" role="menuitemradio" aria-checked="@(Density == "comfortable" ? "true" : "false")" @onclick="@(() => OnDensity.InvokeAsync("comfortable"))"><Icon Name="density" />@L["shell.comfortable"]</button>
        <hr />
        <div class="mh">@L["shell.language"]</div>
        <button type="button" role="menuitemradio" lang="ar" aria-checked="@(!L.En ? "true" : "false")" @onclick="@(() => OnLanguage.InvokeAsync("ar"))"><Icon Name="globe" />العربية</button>
        <button type="button" role="menuitemradio" lang="en" aria-checked="@(L.En ? "true" : "false")" @onclick="@(() => OnLanguage.InvokeAsync("en"))"><Icon Name="globe" />English</button>
        <hr />
        <button type="button" role="menuitem" @onclick="OnSignOut"><Icon Name="logout" Flip="true" />@L["shell.signOut"]</button>
    </MenuButton>
</header>

@code {
    [Parameter] public bool Provider { get; set; }
    [Parameter] public IReadOnlyList<DirectService.Transportation.Contracts.Identity.CompanyAccess> Companies { get; set; } = [];
    [Parameter] public string? CurrentCompany { get; set; }
    [Parameter] public string? UserName { get; set; }
    [Parameter] public int Unread { get; set; }
    [Parameter] public string Density { get; set; } = "compact";
    [Parameter] public EventCallback<string> OnCompany { get; set; }
    [Parameter] public EventCallback OnCommandBar { get; set; }
    /// <summary>Phones (UX-14): the menu button opens the side menu as a drawer.</summary>
    [Parameter] public EventCallback OnMenu { get; set; }
    [Parameter] public bool MenuOpen { get; set; }
    [Parameter] public EventCallback OnNotifications { get; set; }
    [Parameter] public EventCallback OnProfile { get; set; }
    [Parameter] public EventCallback<string> OnDensity { get; set; }
    [Parameter] public EventCallback<string> OnLanguage { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }

    private string? CurrentCompanyName => Companies.FirstOrDefault(c => c.Id == CurrentCompany) is { } c ? L.Pick(c.Name, c.NameEn) : null;
}
