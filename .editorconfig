root = true

[*.cs]
# Entity names follow the approved database design (core.Permissions, core.RolePermissions).
dotnet_diagnostic.CA1711.severity = none
# The solution is C# only; Visual Basic keyword conflicts (Set, Date) do not apply.
dotnet_diagnostic.CA1716.severity = none
# Entity and DTO collections are settable for EF Core materialisation.
dotnet_diagnostic.CA2227.severity = none
# Entities intentionally use mutable collections and arrays (RowVersion, binary columns) mapped by EF Core.
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1002.severity = none
# EF Core migrations are tool-generated.
[**/Migrations/*.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none

# Model configuration runs once at start-up; constant index-column arrays are fine there.
[{src/DirectService.Transportation.Infrastructure/Persistence/Configurations/**.cs,src/Shared/DirectService.Shared.Infrastructure/Persistence/Configurations/**.cs,src/Platform/DirectService.Platform.Infrastructure/Persistence/Configurations/**.cs}]
dotnet_diagnostic.CA1861.severity = none

# Test method names use underscores for readability (Given_When_Then style).
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none

# API tests (and the posting snapshot of Accounting.Tests, which drives the same host): in-memory TestServer calls complete immediately;
# per-call cancellation tokens add noise.
[{tests/DirectService.Transportation.Api.Tests/**.cs,tests/DirectService.Accounting.Tests/**.cs}]
dotnet_diagnostic.xUnit1051.severity = none
